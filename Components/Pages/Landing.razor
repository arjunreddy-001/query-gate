            <div class="lifecycle-card @(activeStep == 2 ? "active" : "")" role="tab" tabindex="0" @onclick="() => SetStep(2)">
                <span class="step-num">STEP 02</span>
                <h3>Grant access</h3>
                <p>Assign granular role permissions, schema whitelists, and temporary time-window countdowns.</p>
            </div>
            <div class="lifecycle-card @(activeStep == 3 ? "active" : "")" role="tab" tabindex="0" @onclick="() => SetStep(3)">
                <span class="step-num">STEP 03</span>
