@code {
    private bool hasUsers = true;

    // --- Hero Simulator State ---
    private string heroEngine = "postgres";
    private string heroScenario = "select";
    private bool heroRunning = false;
    private bool heroUnmask = false;
    private int heroElapsedMs = 24;

    // --- Workspace Sandbox State ---
    private string wsActiveTab = "orders";
    private string wsResultsTab = "data";
    private bool wsRunning = false;
    private int wsElapsedMs = 38;
    private bool exportedNotice = false;

    // --- 4-Step Lifecycle State ---
    private int activeStep = 1;

    // --- Masking Lab State ---
    private string maskPreset = "pci";
    private bool maskUnmaskActive = false;

    // --- Persona Showcase State ---
    private string activePersona = "developers";

    protected override async Task OnInitializedAsync()
    {
        hasUsers = await UserManager.Users.AnyAsync();
    }

    // Hero Simulator Methods
    private void SetHeroEngine(string engine)
    {
        heroEngine = engine;
    }

    private void SelectHeroScenario(string scenario)
    {
        heroScenario = scenario;
        heroUnmask = false;
        heroElapsedMs = scenario == "blocked" ? 2 : 24;
    }

    private async Task RunHeroSimulation()
    {
        heroRunning = true;
        await Task.Delay(180);
        heroRunning = false;
        heroElapsedMs = heroScenario == "blocked" ? 2 : (heroScenario == "masking" ? 31 : 24);
    }

    private void ToggleHeroUnmask()
    {
        heroUnmask = !heroUnmask;
    }

    private string GetHeroEngineDisplayName() => heroEngine switch
    {
        "sqlserver" => "SQL Server 2022",
        "mysql" => "MySQL 8.0",
        "mariadb" => "MariaDB 11.2",
        _ => "PostgreSQL 16"
    };

    private string GetFormattedHeroQuery() => heroScenario switch
    {
        "blocked" => "<span class='sql-kw'>DROP TABLE</span> public.orders;",
        "masking" => "<span class='sql-kw'>SELECT</span> customer_id, full_name, email, card_number <span class='sql-kw'>FROM</span> public.customers;",
        _ => "<span class='sql-kw'>SELECT</span> order_id, customer_name, total_usd <span class='sql-kw'>FROM</span> public.orders <span class='sql-kw'>WHERE</span> status = <span class='sql-str'>'shipped'</span>;"
    };

    // Workspace Sandbox Methods
    private void SwitchWsTab(string tab)
    {
        wsActiveTab = tab;
        if (tab == "explain")
        {
            wsResultsTab = "explain";
        }
        else
        {
            wsResultsTab = "data";
        }
    }

    private void SelectWsTable(string table)
    {
        SwitchWsTab(table);
    }

    private void SetWsResultsTab(string tab)
    {
        wsResultsTab = tab;
    }

    private async Task ExecuteWorkspaceQuery()
    {
        wsRunning = true;
        await Task.Delay(150);
        wsRunning = false;
        wsElapsedMs = wsActiveTab == "explain" ? 54 : 38;
    }

    private async Task TriggerMockExport()
    {
        exportedNotice = true;
        await Task.Delay(2000);
        exportedNotice = false;
    }

    private int GetResultRowCount() => wsActiveTab switch
    {
        "customers" => 4,
        "orders" => 4,
        _ => 1
    };

    // Lifecycle Methods
    private void SetStep(int step)
    {
        activeStep = step;
    }

    private void PrevStep()
    {
        if (activeStep > 1) activeStep--;
    }

    private void NextStep()
    {
        if (activeStep < 4) activeStep++;
    }

    // Masking Lab Methods
    private void SetMaskPreset(string preset)
    {
        maskPreset = preset;
    }

    private void ToggleMaskPlaygroundUnmask()
    {
        maskUnmaskActive = !maskUnmaskActive;
    }

    // Persona Methods
    private readonly string[] personaList = ["developers", "qa", "admins", "auditors"];

    private void SetPersona(string persona)
    {
        activePersona = persona;
    }

    private void PrevPersona()
    {
        int idx = Array.IndexOf(personaList, activePersona);
        if (idx > 0) activePersona = personaList[idx - 1];
    }

    private void NextPersona()
    {
        int idx = Array.IndexOf(personaList, activePersona);
        if (idx >= 0 && idx < personaList.Length - 1) activePersona = personaList[idx + 1];
    }
}