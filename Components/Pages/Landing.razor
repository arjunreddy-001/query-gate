@page "/"
@layout PublicLayout
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Query Gate · Governed SQL access</PageTitle>

<div class="landing-wrap">
    <!-- Hero Section with Interactive Gate Simulator -->
    <section class="landing-hero" aria-labelledby="hero-title">
        <div class="landing-copy">
            <span class="landing-eyebrow">
                <Icon Name="shield" /> Enterprise SQL governance for PostgreSQL, SQL Server, MySQL &amp; MariaDB
            </span>
            <h1 id="hero-title">Give your team access.<br /><span>Keep the guardrails.</span></h1>
            <p>Centralise database access, enforce strict AST query gates, mask sensitive PII on the fly, and guarantee a tamper-evident audit trail without sharing raw database credentials.</p>
            <div class="landing-actions">
                <div class="landing-actions-primary">
                    <AuthorizeView>
                        <Authorized><a class="btn btn-primary landing-button" href="/query">Open query workspace <Icon Name="chevron" /></a></Authorized>
                        <NotAuthorized>
                            @if (!hasUsers)
                            {
                                <a class="btn btn-primary landing-button" href="/Account/Setup">Set up Query Gate <Icon Name="chevron" /></a>
                            }
                            else
                            {
                                <a class="btn btn-primary landing-button" href="/Account/Login">Sign in to Query Gate <Icon Name="chevron" /></a>
                            }
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
                <div class="landing-actions-secondary">
                    <a class="btn landing-button" href="#interactive-workspace"><Icon Name="terminal" /> Try live workspace</a>
                    <a class="btn landing-button" href="/documentation"><Icon Name="list" /> Documentation</a>
                </div>
            </div>
            <div class="landing-badges">
                <span class="badge-chip"><Icon Name="github" /> Open source</span>
                <span class="badge-chip"><Icon Name="terminal" /> .NET 10 &amp; PostgreSQL</span>
                <span class="badge-chip"><Icon Name="db" /> SQL Server</span>
                <span class="badge-chip"><Icon Name="db" /> PostgreSQL</span>
                <span class="badge-chip"><Icon Name="db" /> MySQL</span>
                <span class="badge-chip"><Icon Name="db" /> MariaDB</span>
                <span class="badge-chip"><Icon Name="lock" /> Passkeys &amp; MFA</span>
            </div>
        </div>

        <!-- Interactive Gate Simulator Card -->
        <div class="sim-window" aria-label="Interactive Query Gate Simulator">
            <div class="sim-header">
                <div class="sim-dots">
                    <span class="sim-dot"></span>
                    <span class="sim-dot"></span>
                    <span class="sim-dot"></span>
                </div>
                <span class="sim-header-title">LIVE QUERY GATE SIMULATOR</span>
                <div class="sim-engine-badges">
                    <button type="button" class="sim-engine-btn @(heroEngine == "postgres" ? "active" : "")" @onclick='() => SetHeroEngine("postgres")'>PostgreSQL</button>
                    <button type="button" class="sim-engine-btn @(heroEngine == "sqlserver" ? "active" : "")" @onclick='() => SetHeroEngine("sqlserver")'>SQL Server</button>
                    <button type="button" class="sim-engine-btn @(heroEngine == "mysql" ? "active" : "")" @onclick='() => SetHeroEngine("mysql")'>MySQL</button>
                </div>
            </div>

            <!-- Scenario Selection Pills -->
            <div class="sim-scenarios">
                <button type="button" class="sim-scenario-btn @(heroScenario == "select" ? "active" : "")" @onclick='() => SelectHeroScenario("select")'>
                    <Icon Name="check" /> Permitted SELECT
                </button>
                <button type="button" class="sim-scenario-btn @(heroScenario == "masking" ? "active" : "")" @onclick='() => SelectHeroScenario("masking")'>
                    <Icon Name="lock" /> Dynamic Masking
                </button>
                <button type="button" class="sim-scenario-btn @(heroScenario == "blocked" ? "active" : "")" @onclick='() => SelectHeroScenario("blocked")'>
                    <Icon Name="alert" /> Blocked Dangerous DDL
                </button>
            </div>

            <!-- Code Editor Preview -->
            <div class="sim-code-area">
                <div class="sim-code-line">
                    <span class="sim-line-num">01</span>
                    <span>@((MarkupString)GetFormattedHeroQuery())</span>
                </div>
            </div>

            <!-- Simulator Toolbar -->
            <div class="sim-toolbar">
                <div class="sim-toolbar-left">
                    <button type="button" class="sim-run-btn" @onclick="RunHeroSimulation" disabled="@heroRunning">
                        <Icon Name="play" /> @(heroRunning ? "Evaluating gate..." : "Run through gate")
                    </button>
                    @if (heroScenario == "masking")
                    {
                        <button type="button" class="sim-unmask-toggle @(heroUnmask ? "active" : "")" @onclick="ToggleHeroUnmask" title="Simulates UNMASK privilege">
                            <Icon Name="@(heroUnmask ? "eye" : "eye-off")" />
                            @(heroUnmask ? "UNMASK permission active" : "Masked view (default)")
                        </button>
                    }
                </div>
                <div style="color: var(--text-dim); font-size: 0.74rem;">
                    Target: <strong>@GetHeroEngineDisplayName()</strong>
                </div>
            </div>

            <!-- Live Gate Status Bar -->
            <div class="sim-status-bar">
                <div class="sim-badge-row">
                    @if (heroScenario == "blocked")
                    {
                        <span class="sim-status-badge sim-badge-block"><Icon Name="alert" /> GATE REJECTED</span>
                        <span class="sim-status-badge sim-badge-audit"><Icon Name="shield" /> Fail-closed</span>
                    }
                    else
                    {
                        <span class="sim-status-badge sim-badge-pass"><Icon Name="check" /> GATE PASSED</span>
                        @if (heroScenario == "masking" && !heroUnmask)
                        {
                            <span class="sim-status-badge sim-badge-mask"><Icon Name="lock" /> Masked in-flight</span>
                        }
                        <span class="sim-status-badge sim-badge-audit"><Icon Name="shield" /> Audit logged</span>
                    }
                </div>
                <span style="color: var(--text-faint); font-family: var(--mono); font-size: 0.72rem;">@heroElapsedMs ms</span>
            </div>

            <!-- Output Inspection -->
            <div class="sim-output">
                @if (heroScenario == "blocked")
                {
                    <div class="sim-alert-block">
                        <Icon Name="alert" />
                        <div>
                            <strong>Execution blocked by AST security gate:</strong>
                            <span>Statement type DROP TABLE is prohibited for role 'Developer'. The query was intercepted and rejected before touching the database.</span>
                        </div>
                    </div>
                }
                else if (heroScenario == "masking")
                {
                    <table class="sim-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Customer Name</th>
                                <th>Email</th>
                                <th>Credit Card</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!heroUnmask)
                            {
                                <tr>
                                    <td>401</td>
                                    <td>Jane Doe</td>
                                    <td><span class="mask-tag">j***@@acme.com</span></td>
                                    <td><span class="mask-tag">•••• •••• •••• 4242</span></td>
                                </tr>
                                <tr>
                                    <td>402</td>
                                    <td>Alex Rivera</td>
                                    <td><span class="mask-tag">a***@@global.org</span></td>
                                    <td><span class="mask-tag">•••• •••• •••• 8812</span></td>
                                </tr>
                                <tr>
                                    <td>403</td>
                                    <td>Carlos Vance</td>
                                    <td><span class="mask-tag">c***@@summit.io</span></td>
                                    <td><span class="mask-tag">•••• •••• •••• 1904</span></td>
                                </tr>
                            }
                            else
                            {
                                <tr>
                                    <td>401</td>
                                    <td>Jane Doe</td>
                                    <td>jane.doe@@acme.com</td>
                                    <td>4532 8901 2341 4242</td>
                                </tr>
                                <tr>
                                    <td>402</td>
                                    <td>Alex Rivera</td>
                                    <td>alex.rivera@@global.org</td>
                                    <td>5412 7500 3981 8812</td>
                                </tr>
                                <tr>
                                    <td>403</td>
                                    <td>Carlos Vance</td>
                                    <td>carlos.vance@@summit.io</td>
                                    <td>3782 8224 6310 1904</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <table class="sim-table">
                        <thead>
                            <tr>
                                <th>Order ID</th>
                                <th>Customer</th>
                                <th>Total</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>101</td>
                                <td>Acme Logistics</td>
                                <td>$1,420.00</td>
                                <td><span style="color: var(--ok); font-weight: 700;">Shipped</span></td>
                            </tr>
                            <tr>
                                <td>102</td>
                                <td>Global Tech Corp</td>
                                <td>$850.50</td>
                                <td><span style="color: var(--ok); font-weight: 700;">Shipped</span></td>
                            </tr>
                            <tr>
                                <td>103</td>
                                <td>Summit Retail</td>
                                <td>$3,110.00</td>
                                <td><span style="color: var(--ok); font-weight: 700;">Shipped</span></td>
                            </tr>
                        </tbody>
                    </table>
                }
            </div>
            <div style="padding: 6px 14px 10px; font-size: 0.72rem; color: var(--text-faint); display: flex; align-items: center; gap: 6px; border-top: 1px solid var(--line); background: var(--bg-sunken);">
                <Icon Name="shield" />
                <span>Simulated demonstration. Actual application interface and rule enforcement may differ based on tenant database configuration.</span>
            </div>
        </div>
    </section>

    <!-- Interactive Workspace Sandbox (Authentic Post-Login Experience) -->
    <section class="landing-section" id="interactive-workspace" aria-labelledby="workspace-title">
        <div class="landing-section-head">
            <span class="landing-kicker">AUTHENTIC POST-LOGIN EXPERIENCE</span>
            <h2 id="workspace-title">The governed query workspace, in action.</h2>
            <p>See what users experience after logging in: compact navigation, schema object exploration, ScriptDom AST gate checks, in-flight masking, and visual explain plans.</p>
        </div>

        <div class="preview-window" aria-label="Authentic Query Gate Post-Login Workspace Preview">
            <!-- Window Top Chrome -->
            <div class="preview-window-top">
                <div class="sim-dots">
                    <span class="sim-dot"></span>
                    <span class="sim-dot"></span>
                    <span class="sim-dot"></span>
                </div>
                <div class="preview-window-title">
                    <Icon Name="terminal" /> Query Gate · Governed SQL Workspace (Post-Login View)
                </div>
                <div class="preview-disclaimer-pill">
                    <Icon Name="shield" />
                    <span>Representational Preview</span>
                    <span class="preview-disclaimer-extra"> · Actual UI May Differ</span>
                </div>
            </div>

            <!-- The Full App Shell Simulation -->
            <div class="preview-shell">
                <!-- Authentic Left Sidebar -->
                <aside class="preview-sidebar" aria-label="Simulated Application Sidebar">
                    <div class="preview-sidebar-brand">
                        <span class="brand-mark"><Icon Name="db" /></span>
                        <span>Query Gate</span>
                    </div>

                    <div class="preview-nav-section">Workspace</div>
                    <div class="preview-nav-item"><Icon Name="home" /> <span>Dashboard</span></div>
                    <div class="preview-nav-item active"><Icon Name="terminal" /> <span>Query workspace</span></div>
                    <div class="preview-nav-item"><Icon Name="key" /> <span>My access</span></div>
                    <div class="preview-nav-item"><Icon Name="file" /> <span>Script requests</span></div>
                    <div class="preview-nav-item">
                        <Icon Name="bell" />
                        <span>Notifications</span>
                        <span class="preview-nav-badge">2</span>
                    </div>

                    <div class="preview-nav-section">Governance</div>
                    <div class="preview-nav-item"><Icon Name="check" /> <span>Approvals</span></div>
                    <div class="preview-nav-item"><Icon Name="db" /> <span>Databases</span></div>
                    <div class="preview-nav-item"><Icon Name="grid" /> <span>Access matrix</span></div>
                    <div class="preview-nav-item"><Icon Name="list" /> <span>Audit logs</span></div>
                    <div class="preview-nav-item"><Icon Name="cog" /> <span>Settings</span></div>

                    <button class="preview-pin-btn" type="button" title="Pin sidebar"><Icon Name="panel" /> <span>Pin sidebar</span></button>
                </aside>

                <!-- Authentic Main Content Area -->
                <div class="preview-main-content">
                    <!-- Authentic Topbar -->
                    <header class="preview-topbar">
                        <div class="preview-topbar-left">
                            <span class="preview-topbar-title">Query workspace</span>
                            <span class="badge ok" style="font-size: 0.68rem; padding: 2px 7px;"><Icon Name="check" /> Connected</span>
                        </div>
                        <div class="preview-topbar-right">
                            <span class="theme-sun" style="font-size: 0.85rem; color: var(--text-dim); display: flex;"><Icon Name="sun" /></span>
                            <span style="position: relative; display: inline-flex; color: var(--text-dim); font-size: 0.85rem;">
                                <Icon Name="bell" />
                                <span class="preview-nav-badge" style="position: absolute; top: -5px; right: -5px; font-size: 8px; padding: 1px 4px;">2</span>
                            </span>
                            <div class="preview-user-chip">
                                <span class="preview-avatar">AR</span>
                                <div>
                                    <strong style="display: block; font-size: 0.72rem;">Arjun Reddy</strong>
                                    <span style="font-size: 0.64rem; color: var(--text-dim);">Developer (Least-Privilege)</span>
                                </div>
                            </div>
                        </div>
                    </header>

                    <!-- The Query Workspace Inside the App Frame -->
                    <div class="preview-ws">
                        <!-- Left Panel: Objects, Saved, History -->
                        <aside class="preview-ws-side" aria-label="Object Explorer">
                            <div class="preview-ws-side-tabs">
                                <button type="button" class="preview-ws-side-tab active">Objects</button>
                                <button type="button" class="preview-ws-side-tab">Saved</button>
                                <button type="button" class="preview-ws-side-tab">History</button>
                            </div>
                            <div class="preview-filter-row">
                                <input type="search" class="preview-filter-input" placeholder="Filter objects..." value="" readonly />
                                <span style="font-size: 0.68rem; color: var(--text-faint);"><Icon Name="refresh" /></span>
                            </div>
                            <div class="preview-obj-icons">
                                <span class="preview-obj-btn active"><Icon Name="list" /> All</span>
                                <span class="preview-obj-btn"><Icon Name="table" /> Tables</span>
                                <span class="preview-obj-btn"><Icon Name="eye" /> Views</span>
                            </div>

                            <!-- Real Object Explorer Tree Items -->
                            <div style="display: flex; flex-direction: column; gap: 3px; margin-top: 4px;">
                                <!-- Table: orders -->
                                <div class="tree-item @(wsActiveTab == "orders" ? "active" : "")" style="padding: 4px 6px; font-size: 0.76rem;" @onclick='() => SelectWsTable("orders")'>
                                    <span style="color: var(--text-faint); font-size: 10px;">▾</span>
                                    <Icon Name="table" />
                                    <span style="font-weight: 600;">public.orders</span>
                                    <span class="faint small" style="margin-left: auto; font-size: 10px;">Table</span>
                                </div>
                                <div style="display: flex; flex-direction: column; gap: 2px;">
                                    <div class="tree-col" style="font-size: 0.7rem; padding-left: 24px;"><span style="opacity:0.6;font-size:9px">●</span> id (int8)</div>
                                    <div class="tree-col" style="font-size: 0.7rem; padding-left: 24px;"><span style="opacity:0.6;font-size:9px">●</span> customer_name (text)</div>
                                    <div class="tree-col" style="font-size: 0.7rem; padding-left: 24px;"><span style="opacity:0.6;font-size:9px">●</span> order_date (date)</div>
                                    <div class="tree-col" style="font-size: 0.7rem; padding-left: 24px;"><span style="opacity:0.6;font-size:9px">●</span> status (text)</div>
                                    <div class="tree-col" style="font-size: 0.7rem; padding-left: 24px;"><span style="opacity:0.6;font-size:9px">●</span> total (numeric)</div>
                                </div>

                                <!-- Table: customers -->
                                <div class="tree-item @(wsActiveTab == "customers" ? "active" : "")" style="padding: 4px 6px; font-size: 0.76rem; margin-top: 4px;" @onclick='() => SelectWsTable("customers")'>
                                    <span style="color: var(--text-faint); font-size: 10px;">▾</span>
                                    <Icon Name="table" />
                                    <span style="font-weight: 600;">public.customers</span>
                                    <span class="faint small" style="margin-left: auto; font-size: 10px;">Table</span>
                                </div>
                                <div style="display: flex; flex-direction: column; gap: 2px;">
                                    <div class="tree-col" style="font-size: 0.7rem; padding-left: 24px;"><span style="opacity:0.6;font-size:9px">●</span> id (int8)</div>
                                    <div class="tree-col" style="font-size: 0.7rem; padding-left: 24px;"><span style="opacity:0.6;font-size:9px">●</span> full_name (text)</div>
                                    <div class="tree-col" style="font-size: 0.7rem; padding-left: 24px; color: var(--warn);"><span style="opacity:0.6;font-size:9px">●</span> email (MASKED)</div>
                                    <div class="tree-col" style="font-size: 0.7rem; padding-left: 24px; color: var(--warn);"><span style="opacity:0.6;font-size:9px">●</span> card_number (MASKED)</div>
                                </div>

                                <!-- View: order_analytics -->
                                <div class="tree-item @(wsActiveTab == "explain" ? "active" : "")" style="padding: 4px 6px; font-size: 0.76rem; margin-top: 4px;" @onclick='() => SelectWsTable("explain")'>
                                    <span style="color: var(--text-faint); font-size: 10px;">▸</span>
                                    <Icon Name="eye" />
                                    <span style="font-weight: 600;">public.order_analytics</span>
                                    <span class="faint small" style="margin-left: auto; font-size: 10px;">View</span>
                                </div>
                            </div>
                        </aside>

                        <!-- Right Area: Tab Bar, Toolbar, Code Editor, Results Card -->
                        <div class="preview-ws-main">
                            <!-- Tab Bar -->
                            <div class="preview-ws-tabs">
                                <button type="button" class="icon-btn sm" style="padding: 2px 5px; margin-bottom: 2px;" title="Toggle panel"><Icon Name="list" /></button>
                                <div class="preview-ws-tab @(wsActiveTab == "orders" ? "active" : "")" @onclick='() => SwitchWsTab("orders")'>
                                    <Icon Name="code" />
                                    <span>orders_report.sql</span>
                                    <span class="preview-ws-tab-close">×</span>
                                </div>
                                <div class="preview-ws-tab @(wsActiveTab == "customers" ? "active" : "")" @onclick='() => SwitchWsTab("customers")'>
                                    <Icon Name="code" />
                                    <span>customer_masking.sql</span>
                                    <span class="preview-ws-tab-close">×</span>
                                </div>
                                <div class="preview-ws-tab @(wsActiveTab == "explain" ? "active" : "")" @onclick='() => SwitchWsTab("explain")'>
                                    <Icon Name="code" />
                                    <span>explain_joins.sql</span>
                                    <span class="preview-ws-tab-close">×</span>
                                </div>
                                <span style="font-size: 0.75rem; color: var(--text-faint); padding: 0 6px; cursor: pointer;">+ New</span>
                            </div>

                            <!-- Action Toolbar -->
                            <div class="preview-ws-bar">
                                <div class="preview-ws-bar-left">
                                    <button type="button" class="preview-db-btn" title="Current Database">
                                        <Icon Name="db" />
                                        <span>prod-postgres</span>
                                        <span class="badge env-prod" style="font-size: 0.65rem; padding: 1px 5px;">Production</span>
                                        <span class="badge engine-postgres" style="font-size: 0.65rem; padding: 1px 5px;">PostgreSQL</span>
                                        <span style="font-size: 10px; opacity: 0.7;">▾</span>
                                    </button>

                                    <button type="button" class="btn btn-primary" title="Run (F5 or Ctrl+Enter)" @onclick="ExecuteWorkspaceQuery" disabled="@wsRunning">
                                        <Icon Name="play" /> @(wsRunning ? "Executing..." : "Run (F5)")
                                    </button>
                                    <button type="button" class="btn btn-hover-expand" title="Explain query plan" @onclick='() => SetWsResultsTab("explain")'>
                                        <Icon Name="activity" /><span class="btn-lbl">Explain</span>
                                    </button>
                                    <button type="button" class="btn btn-hover-expand" title="Format (Shift+Alt+F)">
                                        <Icon Name="format" /><span class="btn-lbl">Format</span>
                                    </button>
                                    <button type="button" class="btn btn-hover-expand" title="Save (Ctrl+S)">
                                        <Icon Name="save" /><span class="btn-lbl">Save</span>
                                    </button>

                                    <label class="chip-toggle chip-warn" style="font-size: 0.72rem; padding: 3px 8px; cursor: pointer;">
                                        <span>Dry run</span>
                                    </label>
                                    <div class="chip-input" style="font-size: 0.72rem; padding: 2px 6px;">
                                        <Icon Name="clock" />
                                        <span>30s</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Editor Area -->
                            <div class="preview-code-editor">
                                @if (wsActiveTab == "orders")
                                {
                                    <div class="preview-code-row"><span class="preview-code-num">1</span><span class="sql-comment">-- Role: Developer (Whitelisted: SELECT on public.orders)</span></div>
                                    <div class="preview-code-row"><span class="preview-code-num">2</span><span><span class="sql-kw">SELECT</span> id, customer_name, order_date, status, total</span></div>
                                    <div class="preview-code-row"><span class="preview-code-num">3</span><span><span class="sql-kw">FROM</span> public.orders</span></div>
                                    <div class="preview-code-row"><span class="preview-code-num">4</span><span><span class="sql-kw">WHERE</span> status <span class="sql-kw">IN</span> (<span class="sql-str">'Delivered'</span>, <span class="sql-str">'Processing'</span>)</span></div>
                                    <div class="preview-code-row"><span class="preview-code-num">5</span><span><span class="sql-kw">ORDER BY</span> id <span class="sql-kw">DESC LIMIT</span> 4;</span></div>
                                }
                                else if (wsActiveTab == "customers")
                                {
                                    <div class="preview-code-row"><span class="preview-code-num">1</span><span class="sql-comment">-- In-flight Dynamic Data Masking enabled for PCI-DSS &amp; GDPR</span></div>
                                    <div class="preview-code-row"><span class="preview-code-num">2</span><span><span class="sql-kw">SELECT</span> id, full_name, email, card_number, country</span></div>
                                    <div class="preview-code-row"><span class="preview-code-num">3</span><span><span class="sql-kw">FROM</span> public.customers</span></div>
                                    <div class="preview-code-row"><span class="preview-code-num">4</span><span><span class="sql-kw">ORDER BY</span> id <span class="sql-kw">ASC LIMIT</span> 4;</span></div>
                                }
                                else
                                {
                                    <div class="preview-code-row"><span class="preview-code-num">1</span><span class="sql-comment">-- Estimated visual explain execution plan with cost bounds</span></div>
                                    <div class="preview-code-row"><span class="preview-code-num">2</span><span><span class="sql-kw">EXPLAIN ANALYZE SELECT</span> o.id, c.full_name, o.total</span></div>
                                    <div class="preview-code-row"><span class="preview-code-num">3</span><span><span class="sql-kw">FROM</span> public.orders o</span></div>
                                    <div class="preview-code-row"><span class="preview-code-num">4</span><span><span class="sql-kw">JOIN</span> public.customers c <span class="sql-kw">ON</span> o.customer_id = c.id;</span></div>
                                }
                            </div>

                            <div class="ws-split" title="Resize splitter"></div>

                            <!-- Results Card -->
                            <div class="preview-results-card">
                                <div class="preview-results-header card-head" style="padding: 5px 12px;">
                                    <span class="badge ok">Success</span>
                                    @if (wsActiveTab == "customers")
                                    {
                                        <span class="badge warn" title="Sensitive PII columns redacted (no UNMASK permission)"><Icon Name="lock" /> Masked (2 PII redacted)</span>
                                    }
                                    <span class="muted small">@wsElapsedMs ms · @GetResultRowCount() row(s) returned</span>
                                    <div class="actions">
