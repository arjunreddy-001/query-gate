    private async Task<string?> TryReadEditorSqlAsync()
    {
        try
        {
            await SyncCurrent();
            var selection = await JS.InvokeAsync<string>("dbam.editorSelection", "main");
            return string.IsNullOrWhiteSpace(selection) ? Current!.Sql : selection;
