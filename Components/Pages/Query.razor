    private async Task ForceCloseTab(string id)
    {
        try { await JS.InvokeVoidAsync("dbam.releaseTabFileHandle", id); } catch { }
        if (tabs.Count == 1)
        {
            Current!.Sql = "";
            Current.LinkedFileName = null;
            Current.HasFileHandle = false;
            Current.LastSavedSql = null;
            await JS.InvokeVoidAsync("dbam.editorSet", "main", "");
            await PersistAsync();
            return;
        }
        var wasActive = id == activeId;
        tabs.RemoveAll(t => t.Id == id);
        if (wasActive)
        {
            activeId = tabs[^1].Id;
            LoadTabResultState(Current);
            await JS.InvokeVoidAsync("dbam.editorSet", "main", Current!.Sql);
            await OnDbChanged();
        }
        else await PersistAsync();
    }

