    private async Task FixErrorWithAi()
    {
        if (last is null || string.IsNullOrWhiteSpace(last.Error) || Current is null) return;
        var currentDb = databases.FirstOrDefault(d => d.Id == Current.DatabaseId);
        var engine = currentDb?.Engine ?? DatabaseEngine.SqlServer;
        var sqlToDiagnose = lastRunSql ?? Current.Sql;

        Flash = "Diagnosing error with AI...";
        StateHasChanged();

        var res = await AiAssistant.ExplainOrFixAsync(Current.DatabaseId, engine, sqlToDiagnose, last.Error);
        Flash = null;
        if (res.Success)
        {
            aiFixResult = res;
        }
        else
        {
            Say(res.ErrorMessage ?? "Failed to diagnose error with AI.", true);
        }
        StateHasChanged();
    }

    private async Task ApplyFixedSqlToEditor()
    {
        if (aiFixResult?.FixedSql is null) return;
        await LoadSql(aiFixResult.FixedSql, null);
        aiFixResult = null;
        Say("Fixed query applied to editor.");
    }

    private async Task ExplainPlanWithAi()
    {
        if (last?.ExecutionPlan is null || Current is null) return;
        var currentDb = databases.FirstOrDefault(d => d.Id == Current.DatabaseId);
        var engine = currentDb?.Engine ?? DatabaseEngine.SqlServer;

        aiExplainingPlan = true;
        StateHasChanged();

        try
        {
            aiPlanExplanation = await AiAssistant.ExplainPlanAsync(last.ExecutionPlan, engine);
        }
        finally
        {
            aiExplainingPlan = false;
            StateHasChanged();
        }
    }

