    private HashSet<string> includedInsertCols = new(StringComparer.OrdinalIgnoreCase);

    private DbObjectInfo? MatchedTable => FindMatchingTable(sqlInsertTableName);

    private DbObjectInfo? FindMatchingTable(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return null;
        var clean = name.Trim().Trim('[', ']');
        if (clean.Contains('.'))
        {
            var parts = clean.Split('.', 2);
            var s = parts[0].Trim('[', ']');
            var t = parts[1].Trim('[', ']');
            return objects.FirstOrDefault(o =>
                o.Schema.Equals(s, StringComparison.OrdinalIgnoreCase) &&
                o.Name.Equals(t, StringComparison.OrdinalIgnoreCase));
        }
        return objects.FirstOrDefault(o => o.Name.Equals(clean, StringComparison.OrdinalIgnoreCase));
    }

    private bool IsIdentityColumn(string colName)
    {
        var table = MatchedTable;
        if (table != null)
        {
            var c = table.ColumnDetails.FirstOrDefault(cd => cd.Name.Equals(colName, StringComparison.OrdinalIgnoreCase));
            if (c != null) return c.IsIdentity;
        }
        return colName.Equals("Id", StringComparison.OrdinalIgnoreCase) ||
               (colName.EndsWith("_id", StringComparison.OrdinalIgnoreCase) && colName.Length <= 8);
    }

    private bool IsAutoInsertColumn(string colName)
    {
        var table = MatchedTable;
        if (table != null)
        {
            var c = table.ColumnDetails.FirstOrDefault(cd => cd.Name.Equals(colName, StringComparison.OrdinalIgnoreCase));
            if (c != null && (c.HasDefault || c.IsComputed || c.DataType is "timestamp" or "rowversion"))
                return true;
        }

        var clean = colName.Replace("_", "").ToLowerInvariant();
        return clean is "createdat" or "updatedat" or "createdon" or "updatedon"
            or "createddate" or "updateddate" or "modifiedat" or "modifiedon"
            or "modifieddate" or "rowversion" or "timestamp";
    }

