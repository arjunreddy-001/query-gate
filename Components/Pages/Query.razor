    private static string BuildSafeSqlFileName(string? baseName)
    {
        if (string.IsNullOrWhiteSpace(baseName) || baseName.StartsWith("Query "))
        {
            baseName = "query-" + DateTime.Now.ToString("yyyyMMdd-HHmmss");
        }
        var safeName = string.Join("_", baseName.Split(System.IO.Path.GetInvalidFileNameChars())).Trim();
        if (!safeName.EndsWith(".sql", StringComparison.OrdinalIgnoreCase)) safeName += ".sql";
        return safeName;
    }

    private async Task SaveSqlFile()
    {
        if (Current is null) return;
        if (!Current.HasFileHandle)
        {
            await DownloadSqlFile();
            return;
        }
        var sql = await GetCurrentEditorSqlAsync() ?? "";
        var res = await JS.InvokeAsync<SaveSqlFileResult>("dbam.saveSqlFile", Current.Id, sql);
        if (res.Ok)
        {
            Current.Sql = sql;
            Current.LastSavedSql = sql;
            if (!string.IsNullOrWhiteSpace(res.FileName)) Current.LinkedFileName = res.FileName;
            await PersistAsync();
            Say($"Saved {Current.LinkedFileName}");
            StateHasChanged();
            return;
        }
        if (res.Reason == "permission-denied")
        {
            Say("Write permission denied for the linked file.");
            return;
        }
        if (res.Reason == "no-handle")
        {
            Current.HasFileHandle = false;
            await DownloadSqlFile();
            return;
        }
        Say($"Failed to save file: {res.Error}");
    }

    private async Task DownloadSqlFile()
    {
        var sql = await GetCurrentEditorSqlAsync();
        if (string.IsNullOrWhiteSpace(sql))
        {
            Say("Editor is empty.");
            return;
        }
        var safeName = BuildSafeSqlFileName(Current?.LinkedFileName ?? Current?.Name);
        var res = await JS.InvokeAsync<SaveSqlFileAsResult>("dbam.saveSqlFileAs", Current?.Id ?? "", sql, safeName);
        if (res.Cancelled) return;
        if (res.Ok && res.Mode == "picker" && Current is not null && !string.IsNullOrWhiteSpace(res.FileName))
        {
            Current.Sql = sql;
            Current.LinkedFileName = res.FileName;
            Current.HasFileHandle = true;
            Current.LastSavedSql = sql;
            if (Current.Name.StartsWith("Query ") || Current.Name == "New tab")
            {
                var baseName = System.IO.Path.GetFileNameWithoutExtension(res.FileName);
                if (!string.IsNullOrWhiteSpace(baseName)) Current.Name = baseName;
            }
            await PersistAsync();
            Say($"Saved {res.FileName}");
            StateHasChanged();
            return;
        }
        Say($"Saved query to {safeName}");
    }

    private async Task CopyActiveResultText()
    {
        if (last is null || activeResult < 0 || activeResult >= last.ResultSets.Count) return;
        var rs = last.ResultSets[activeResult];
        string text;
        if (rs.Columns.Count == 1)
        {
            var sb = new System.Text.StringBuilder();
            foreach (var row in rs.Rows)
            {
                var val = row.Length > 0 ? Convert.ToString(row[0], System.Globalization.CultureInfo.InvariantCulture) ?? "" : "";
                sb.Append(val);
                if (!val.EndsWith("\n") && !val.EndsWith("\r"))
                    sb.AppendLine();
            }
            text = sb.ToString();
        }
        else
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine(string.Join("\t", rs.Columns));
            foreach (var row in rs.Rows)
            {
                sb.AppendLine(string.Join("\t", row.Select(c => c is null ? "NULL" : Convert.ToString(c, System.Globalization.CultureInfo.InvariantCulture))));
            }
            text = sb.ToString();
        }
        await JS.InvokeVoidAsync("dbam.copy", text);
        Say(rs.Columns.Count == 1 ? "Script copied to clipboard." : "Result copied to clipboard.");
    }

    private async Task CopyMessages()
    {
        if (last is null || last.Messages.Count == 0) return;
        var text = string.Join(Environment.NewLine, last.Messages);
        await JS.InvokeVoidAsync("dbam.copy", text);
        Say("Messages copied to clipboard.");
    }
