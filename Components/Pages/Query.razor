@if (showSqlInsertModal && last is not null && activeResult >= 0 && activeResult < last.ResultSets.Count)
{
    var rs = last.ResultSets[activeResult];
    <div class="modal-back">
        <div class="modal" style="max-width:920px;width:95vw;max-height:90vh;display:flex;flex-direction:column">
            <div class="modal-head">
                <h2>SQL INSERT Export</h2>
                <span class="badge" style="font-size:11px">@rs.Rows.Count @(rs.Rows.Count == 1 ? "row" : "rows")</span>
            </div>
            <div class="modal-body stack" style="gap:16px;overflow-y:auto;flex:1">
                <div class="field">
                    <label>Target Table Name</label>
                    <input type="text" placeholder="e.g. Products or dbo.Products" @bind="sqlInsertTableName" />
                    <span class="faint small">Statements will insert into this table. Schema is checked to detect identities and auto-insert defaults.</span>
                </div>

                <div class="field">
                    <div class="row-inline" style="justify-content:space-between;margin-bottom:6px;flex-wrap:wrap;gap:8px">
                        <label style="margin:0;font-weight:600">
                            Columns in INSERT Statement (@includedInsertCols.Count of @rs.Columns.Count included)
                        </label>
                        <div class="row-inline" style="gap:6px">
                            <button class="btn btn-sm" type="button" @onclick="() => SelectAllIncludedCols(rs.Columns)">Select all</button>
                            <button class="btn btn-sm" type="button" @onclick="() => ExcludeIdentityCols(rs.Columns)">Exclude Identity</button>
                            <button class="btn btn-sm" type="button" @onclick="() => ExcludeAutoCols(rs.Columns)">Exclude Auto-insert</button>
                            <button class="btn btn-sm" type="button" @onclick="() => ResetIncludedColsDefaults(rs.Columns)">Reset defaults</button>
                        </div>
                    </div>
                    <p class="muted small" style="margin-bottom:8px">
                        Select which columns to include in the generated <code>INSERT INTO [Table] (...)</code> statement. Identity and auto-insert columns are excluded by default, but you can check any column below to include it:
                    </p>
                    <div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(210px, 1fr));gap:6px;max-height:200px;overflow-y:auto;padding:8px 10px;border:1px solid var(--line);border-radius:var(--radius);background:var(--bg-sunken)">
                        @foreach (var col in rs.Columns)
                        {
                            var isId = IsIdentityColumn(col);
                            var isAuto = IsAutoInsertColumn(col);
                            var isIncluded = includedInsertCols.Contains(col);
                            <label class="check small" style="margin:0;display:flex;align-items:center;gap:6px;padding:4px 6px;border-radius:var(--radius-sm);background:@(isIncluded ? "var(--bg-elev)" : "transparent")">
                                <input type="checkbox" checked="@isIncluded" @onchange="e => ToggleIncludedCol(col, (bool)(e.Value ?? false))" />
