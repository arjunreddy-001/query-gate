                                @if (isId)
                                {
                                    <span class="badge warn" style="font-size:9px;padding:1px 5px;margin-left:auto" title="Identity column detected from table schema">Identity</span>
                                }
                                else if (isAuto)
                                {
                                    <span class="badge" style="font-size:9px;padding:1px 5px;margin-left:auto" title="Auto-generated / default column detected from table schema">Auto</span>
                                }
                            </label>
                        }
                    </div>
                    @if (includedInsertCols.Count == 0)
                    {
                        <div class="alert bad small" style="margin-top:6px">Please select at least one column to include in the INSERT statement.</div>
                    }
                </div>

                <div class="field">
                    <div class="row-inline" style="justify-content:space-between;margin-bottom:6px;flex-wrap:wrap;gap:8px">
                        <label style="margin:0;font-weight:600">Duplicate Check Columns (Optional - @selectedInsertCols.Count selected)</label>
                        <div class="row-inline" style="gap:6px">
                            <button class="btn btn-sm" type="button" @onclick="() => selectedInsertCols = new HashSet<string>(rs.Columns, StringComparer.OrdinalIgnoreCase)">Select all</button>
                            <button class="btn btn-sm" type="button" @onclick="() => selectedInsertCols.Clear()">Clear</button>
                        </div>
                    </div>
                    <p class="muted small" style="margin-bottom:8px">
                        Select columns to check before inserting. If selected, wraps statements in:
                        <code>IF NOT EXISTS (SELECT 1 FROM [Table] WHERE col = 'val') BEGIN INSERT ... END</code>
                    </p>
                    <div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(210px, 1fr));gap:6px;max-height:160px;overflow-y:auto;padding:8px 10px;border:1px solid var(--line);border-radius:var(--radius);background:var(--bg-sunken)">
                        @foreach (var col in rs.Columns)
                        {
                            <label class="check small" style="margin:0;display:flex;align-items:center;gap:6px;padding:4px 6px;border-radius:var(--radius-sm)">
                                <input type="checkbox" checked="@selectedInsertCols.Contains(col)" @onchange="e => ToggleInsertCol(col, (bool)(e.Value ?? false))" />
                                <span style="word-break:break-all">@col</span>
                            </label>
                        }
                    </div>
                </div>
            </div>
            <div class="modal-foot">
                <button class="btn" type="button" @onclick="() => showSqlInsertModal = false">Cancel</button>
                <button class="btn" type="button" disabled="@(includedInsertCols.Count == 0)" @onclick="CopySqlInsert">
                    <Icon Name="copy" />Copy SQL
                </button>
                <button class="btn btn-primary" type="button" disabled="@(includedInsertCols.Count == 0)" @onclick="DownloadSqlInsert">
                    <Icon Name="download" />Download .sql
                </button>
            </div>
        </div>
    </div>
}

