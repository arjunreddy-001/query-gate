    // Visual Charting
    private async Task InitChart()
    {
        if (last is null || last.ResultSets.Count == 0) return;
        var rs = last.ResultSets[Math.Max(0, lastActiveResultIndex)];
        if (chartValCol >= rs.Columns.Count) chartValCol = Math.Min(1, rs.Columns.Count - 1);
        await Task.Delay(50);
        await RenderChartAsync();
    }

    private async Task RenderChartAsync()
    {
        if (last is null || activeResult != -3 || last.ResultSets.Count == 0) return;
        var rs = last.ResultSets[Math.Max(0, lastActiveResultIndex)];
        var rows = GetProcessedRows(rs);
        var labels = rows.Select(r => chartCatCol < r.Values.Length ? Convert.ToString(r.Values[chartCatCol], System.Globalization.CultureInfo.InvariantCulture) ?? "" : "").Take(50).ToArray();
        var values = rows.Select(r => {
            if (chartValCol < r.Values.Length && decimal.TryParse(Convert.ToString(r.Values[chartValCol], System.Globalization.CultureInfo.InvariantCulture), out var d)) return (double)d;
            return 0.0;
        }).Take(50).ToArray();

        await JS.InvokeVoidAsync("renderQueryChart", "query-result-chart", new {
            chartType,
            labels,
            values
        });
    }

