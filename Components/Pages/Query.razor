    private async Task InsertTemplateUpdate(DbObjectInfo o)
    {
        var currentDb = databases.FirstOrDefault(d => d.Id == Current?.DatabaseId);
        var engine = currentDb?.Engine ?? DatabaseEngine.SqlServer;
        var cols = o.Columns.Count > 0 ? o.Columns : new List<string> { "Col1", "Col2" };
        var idCol = cols.FirstOrDefault() ?? "Id";
        var updateCols = cols.Count > 1 ? cols.Skip(1).Take(4) : cols.Take(1);
        string sql = engine switch
        {
            DatabaseEngine.PostgreSql => $"UPDATE \"{o.Schema}\".\"{o.Name}\"\nSET {string.Join(",\n    ", updateCols.Select(c => $"\"{c}\" = ?"))}\nWHERE \"{idCol}\" = ?;",
            DatabaseEngine.MySql or DatabaseEngine.MariaDb => $"UPDATE `{o.Schema}`.`{o.Name}`\nSET {string.Join(",\n    ", updateCols.Select(c => $"`{c}` = ?"))}\nWHERE `{idCol}` = ?;",
            _ => $"UPDATE [{o.Schema}].[{o.Name}]\nSET {string.Join(",\n    ", updateCols.Select(c => $"[{c}] = ?"))}\nWHERE [{idCol}] = ?;"
        };
        await LoadSql(sql, null);
    }

