    private async Task GenerateAiSql()
    {
        if (string.IsNullOrWhiteSpace(aiUserPrompt) || Current is null) return;
        aiGenerating = true;
        aiError = null;
        aiGeneratedSql = null;
        aiSafetyWarnings.Clear();
        StateHasChanged();

        try
        {
            var currentDb = databases.FirstOrDefault(d => d.Id == Current.DatabaseId);
            var engine = currentDb?.Engine ?? DatabaseEngine.SqlServer;
            var res = await AiAssistant.GenerateSqlAsync(Current.DatabaseId, engine, aiUserPrompt);
            if (res.Success)
            {
                aiGeneratedSql = res.Sql;
                aiSafetyWarnings = res.SafetyWarnings;
            }
            else
            {
                aiError = res.ErrorMessage;
            }
        }
        catch (Exception ex)
        {
            aiError = ex.Message;
        }
        finally
        {
            aiGenerating = false;
            StateHasChanged();
        }
    }

