            await InvokeAsync(StateHasChanged);
            return null;
        }
    }

    private async Task RunCore(bool confirmed)
    {
        ValidateTimeout();
        if (running || Current is null) return;

        var sql = await TryReadEditorSqlAsync();
        if (sql is null) return;

        if (string.IsNullOrWhiteSpace(sql)) { Say("Nothing to run.", true); return; }

        if (!confirmed && impactCheck && !dryRun)
        {
            bool hasMutating = false;
            try
            {
                var dbObj = databases.FirstOrDefault(d => d.Id == Current.DatabaseId);
                var eng = dbObj?.Engine ?? DatabaseEngine.SqlServer;
                hasMutating = Gate.Analyze(sql, eng).HasMutatingStatements;
            }
            catch (Exception ex)
            {
                Say($"Impact check analysis error: {ex.Message}", true);
            }

            if (hasMutating)
            {
                running = true;
                StateHasChanged();
                try
                {
                    var impact = await Execution.AssessImpactAsync(Me, new ExecutionOptions
                    {
                        SqlText = sql,
                        DatabaseId = Current.DatabaseId,
                        TimeoutSeconds = timeout,
                        Parameters = formMode ? formParamValues.ToDictionary(k => k.Key, k => (object?)k.Value, StringComparer.OrdinalIgnoreCase) : []
                    });
                    if (impact.HasImpact)
                    {
                        impactAssessment = impact;
                        pendingImpactSql = sql;
                        safetyConfirmInput = "";
                        showImpactModal = true;
                        return;
                    }
                }
                catch (Exception ex)
                {
                    Say($"Impact check error: {ex.Message}", true);
                }
                finally
                {
                    running = false;
                    StateHasChanged();
                }
            }
        }

        if (!confirmed && IsCurrentProd && !dryRun)
        {
            var upper = sql.ToUpperInvariant();
            if (upper.Contains("UPDATE ") || upper.Contains("DELETE ") || upper.Contains("DROP ") || upper.Contains("TRUNCATE ") || upper.Contains("ALTER "))
            {
                showSafetyConfirmModal = true;
                safetyConfirmInput = "";
                targetSafetySql = sql;
                StateHasChanged();
                return;
            }
        }

        running = true; Flash = null; runId = Guid.NewGuid(); lastRunSql = sql;
        sortCol = null; sortAsc = true;
        var wasResultsHidden = !resultsVisible;
        try { await JS.InvokeVoidAsync("dbam.editorMarker", "main", 0, ""); } catch { }
        StateHasChanged();
        try
        {
            last = await Execution.ExecuteAsync(Me, new ExecutionOptions
            {
                SqlText = sql, DatabaseId = Current.DatabaseId, DryRun = dryRun, TimeoutSeconds = timeout,
                ConfirmUnfilteredWrites = confirmed, RunId = runId,
                Parameters = formMode ? formParamValues.ToDictionary(k => k.Key, k => (object?)k.Value, StringComparer.OrdinalIgnoreCase) : []
            });
            activeResult = last.ResultSets.Count > 0 ? 0 : -1;
            lastActiveResultIndex = activeResult >= 0 ? activeResult : 0;
            if (last.Outcome == "NeedsConfirmation") { confirm = last.UnfilteredWrites; last = null; }
            else
            {
                await EnsureResultsVisibleAsync();
                if (last.ErrorLine is { } line)
                {
                    try { await JS.InvokeVoidAsync("dbam.editorMarker", "main", line, last.Error); } catch { }
                }
            }
        }
        catch (Exception ex)
        {
            SetRunError("Execution failed", ex);
            try { await Storage.SetAsync("query_results_visible", true); } catch { }
        }
        finally
        {
            running = false;
            SaveTabResultState(Current);
        }
        try { await LoadSidePanels(); } catch (Exception ex) { Logger.LogWarning(ex, "Could not refresh side panels after query execution"); }
        _ = JS.InvokeVoidAsync("initTableColumnResizing", "query-results-table");
        await InvokeAsync(StateHasChanged);
        if (wasResultsHidden && resultsVisible)
        {
            await Task.Yield();
            try { await JS.InvokeVoidAsync("dbam.syncSplitLayout", layoutSplitHorizontal); } catch { }
            await JS.InvokeVoidAsync("dbam.editorLayout", "main");
        }
    }

