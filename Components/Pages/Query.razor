    // Form Mode & Parameterized Execution
    private static readonly System.Text.RegularExpressions.Regex ParamTokenRegex = new(
        @"(@[a-zA-Z0-9_]+|(?<!:):[a-zA-Z0-9_]+|\{\{\s*([a-zA-Z0-9_]+)\s*\}\})",
        System.Text.RegularExpressions.RegexOptions.Compiled);
    private string? _cachedParamsSql;
    private List<string> _cachedParams = [];

    private List<string> DetectedParameters
    {
        get
        {
            var sql = Current?.Sql ?? "";
            if (string.Equals(_cachedParamsSql, sql, StringComparison.Ordinal))
            {
                return _cachedParams;
            }
            if (string.IsNullOrWhiteSpace(sql))
            {
                _cachedParamsSql = sql;
                _cachedParams = [];
                return _cachedParams;
            }
            var matches = ParamTokenRegex.Matches(sql);
            _cachedParams = matches
                .Select(m => m.Groups[2].Success ? m.Groups[2].Value : m.Value.TrimStart('@', ':'))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
            _cachedParamsSql = sql;
            return _cachedParams;
        }
    }

