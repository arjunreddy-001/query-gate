@page "/query"
@attribute [Authorize]
@implements IAsyncDisposable
@inherits PageBase
@inject PermissionService Permissions
@inject ExecutionService Execution
@inject MetadataService Metadata
@inject WorkspaceService Workspace
@inject SqlGate Gate
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuditService AuditSvc
@inject ILogger<Query> Logger
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedLocalStorage Storage
@inject SettingsService SettingsSvc
@inject DbAccessManager.Services.Ai.AiAssistantService AiAssistant
@using System.Text
@using System.Text.Json
@using DbAccessManager.Components.Pages.QueryWorkspace
@using Microsoft.SqlServer.TransactSql.ScriptDom

<PageTitle>Query workspace · Query Gate</PageTitle>

@if (databases.Count == 0 && loaded)
{
    <div class="card empty"><Icon Name="lock" /><h3>No databases available</h3><p>You haven't been granted access to any database yet.</p><a class="btn btn-primary" href="access">Request access</a></div>
}
else
{
<div id="query-ws" class="ws @(sideOpen is null ? "side-auto" : sideOpen.Value ? "side-open" : "side-hidden")">
    @if (sideOpen == true)
    {
        <button type="button" class="ws-side-backdrop" aria-label="Close workspace panel" @onclick="ToggleSide"></button>
    }
    <ObjectExplorerPanel Side="@side"
                         OnSwitchSide="SwitchSide"
                         OnToggleSide="ToggleSide"
                         Objects="objects"
                         MetaLoading="metaLoading"
                         MetaError="@metaError"
                         Expanded="expanded"
                         ExpandVersion="expandVersion"
                         OnToggleExpand="Toggle"
                         Saved="saved"
                         TeamSaved="teamSaved"
                         History="history"
                         IsAdmin="IsAdmin"
                         UserId="@UserId"
                         OnRefreshMetadata="() => LoadMetadata(true)"
                         OnOpenErDiagram="OpenErDiagram"
                         OnInsertSelect="InsertSelect"
                         OnOpenObjectContextMenu="args => OpenObjectContextMenu(args.Args, args.Obj)"
                         OnCopyColumn="CopyColumn"
                         OnLoadSql="args => LoadSql(args.Sql, args.Name)"
                         OnPromptDeleteSaved="PromptDeleteSaved"
                         OutcomeClass="OutcomeClass"
                         Ago="Ago" />
    <div class="ws-side-split" title="Drag to resize object panel"></div>

    <section class="ws-main">
        @if (IsCurrentProd)
        {
            <div class="prod-safeguard-banner">
                <div class="row-inline" style="gap:8px">
                    <Icon Name="alert" />
                    <span><b>PRODUCTION ENVIRONMENT:</b> Executing against <u>@(databases.FirstOrDefault(d => d.Id == Current?.DatabaseId)?.Name ?? "Production")</u>. Destructive write operations require safety confirmation.</span>
                </div>
                <span class="badge" style="background:rgba(255,255,255,0.25);color:#fff">RESTRICTED TARGET</span>
            </div>
        }
        <div class="ws-tabs">
            <button class="icon-btn sm" type="button" title="@(sideOpen == true ? "Hide panel" : "Show panel")" aria-label="@(sideOpen == true ? "Hide objects, saved queries and history" : "Show objects, saved queries and history")" aria-controls="workspace-panel" aria-expanded="@(sideOpen == true ? "true" : "false")" @onclick="ToggleSide"><Icon Name="list" /></button>
            @foreach (var t in tabs)
            {
                var isEditing = editingTabId == t.Id;
                <div class="ws-tab @(t.Id == activeId ? "active" : "")"
                     @onclick="() => Activate(t.Id)"
                     @ondblclick="() => StartRenameTab(t)"
                     title="@(t.LinkedFileName is not null ? $"File: {t.LinkedFileName} · Click to switch · Double-click to rename" : "Click to switch · Double-click to rename")">
                    @if (isEditing)
                    {
                        <input class="tab-rename-input"
                               @bind="editingTabName"
                               @bind:event="oninput"
                               @onclick:stopPropagation
                               @ondblclick:stopPropagation
                               @onkeydown="HandleTabRenameKey"
                               @onblur="CommitTabRename"
                               autofocus />
                    }
                    else
                    {
                        @if (t.LinkedFileName is not null)
                        {
                            <Icon Name="file" Class="ws-tab-file" />
                        }
                        <span>@t.Name</span>
                        @if (t.IsDirty)
                        {
                            <span class="ws-tab-dirty" title="Unsaved file changes"></span>
                        }
                    }
                    <button type="button" title="Close" @onclick:stopPropagation @onclick="() => CloseTab(t.Id)">×</button>
                </div>
            }
            <button class="btn btn-sm btn-ghost" @onclick="NewTab"><Icon Name="plus" />New</button>
            <InputFile id="sql-file-input" OnChange="OnSqlFileSelected" accept=".sql" style="display:none" />
        </div>

        <div class="row-inline ws-bar">
            @if (Current is not null && databases.FirstOrDefault(d => d.Id == Current.DatabaseId) is { } cd)
            {
                <div class="db-selector-wrap">
                    <button type="button" class="db-selector-btn" @onclick="ToggleDbDropdown" title="Switch database (@cd.Name)">
                        <Icon Name="db" />
                        <span class="db-name" title="@cd.Name">@cd.Name</span>
                        <span class="badge @EnvClass(cd.Environment)">@cd.Environment</span>
                        <span class="badge @DatabaseEngineInfo.GetBadgeClass(cd.Engine)">@DatabaseEngineInfo.GetDisplayName(cd.Engine)</span>
                        @if (!cd.IsActive) { <span class="badge bad">Disabled</span> }
                        <span style="font-size:10px;margin-left:2px;opacity:0.7">▾</span>
                    </button>
                    @if (dbDropdownOpen)
                    {
                        <div class="db-selector-backdrop" @onclick="() => dbDropdownOpen = false"></div>
                        <div class="db-selector-menu">
                            <input type="search"
                                   class="db-selector-search"
                                   placeholder="Search databases by name, environment, engine…"
                                   @bind="dbSearchText"
                                   @bind:event="oninput"
                                   @onclick:stopPropagation
                                   autofocus />
                            <div class="db-selector-list">
                                @{
                                    var filteredDbs = databases.Where(d => string.IsNullOrWhiteSpace(dbSearchText) ||
                                        d.Name.Contains(dbSearchText, StringComparison.OrdinalIgnoreCase) ||
                                        d.Environment.Contains(dbSearchText, StringComparison.OrdinalIgnoreCase) ||
                                        DatabaseEngineInfo.GetDisplayName(d.Engine).Contains(dbSearchText, StringComparison.OrdinalIgnoreCase)).ToList();
                                }
                                @foreach (var d in filteredDbs)
                                {
                                    var isSelected = d.Id == Current.DatabaseId;
                                    <button type="button" class="db-selector-item @(isSelected ? "selected" : "")" @onclick="() => SelectDatabase(d.Id)">
                                        <div class="db-info">
                                            <div class="db-title">
                                                @if (isSelected) { <span style="color:var(--brand);margin-right:4px">✓</span> }
                                                @d.Name
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(d.Description))
                                            {
                                                <div class="db-desc">@d.Description</div>
                                            }
                                        </div>
                                        <div class="db-tags">
                                            <span class="badge @EnvClass(d.Environment)">@d.Environment</span>
                                            <span class="badge @DatabaseEngineInfo.GetBadgeClass(d.Engine)">@DatabaseEngineInfo.GetDisplayName(d.Engine)</span>
                                            @if (!d.IsActive) { <span class="badge bad">Disabled</span> }
                                        </div>
                                    </button>
                                }
                                @if (filteredDbs.Count == 0)
                                {
                                    <div class="muted small" style="padding:12px;text-align:center">No databases match "@dbSearchText".</div>
                                }
                            </div>
                            <div class="db-selector-footer">
                                <label class="check small">
                                    <input type="checkbox" @bind="showDisabledDatabases" @bind:after="ReloadDatabases" /> Show disabled databases
                                </label>
                                <span class="faint small">@databases.Count available</span>
                            </div>
                        </div>
                    }
                </div>
            }
            @if (running) { <button class="btn btn-danger" @onclick="CancelRun"><Icon Name="stop" />Cancel</button> }
            else
            {
                <button class="btn btn-primary" title="Run (F5 or Ctrl+Enter). Runs the selection if any." @onclick="Run"><Icon Name="play" />Run</button>
                <button class="btn btn-hover-expand" title="Explain query plan" @onclick="ExplainPlan" disabled="@(Current is null)"><Icon Name="activity" /><span class="btn-lbl">Explain</span></button>
            }
            <div class="ws-bar-group collapsible">
                <button class="btn btn-hover-expand" title="Format (Shift+Alt+F)" @onclick="FormatSql"><Icon Name="format" /><span class="btn-lbl">Format</span></button>
                <button class="btn btn-hover-expand" title="Save to query library" @onclick="OpenSave"><Icon Name="save" /><span class="btn-lbl">Save</span></button>
                @if (Current?.HasFileHandle == true)
                {
                    <button class="btn btn-sm @(Current.IsDirty ? "btn-primary" : "")" title="Save changes to @Current.LinkedFileName (Ctrl+S)" @onclick="SaveSqlFile">
                        <Icon Name="save" />Save file
                    </button>
                }
                <button class="btn btn-hover-expand" title="Save query to local .sql file" @onclick="DownloadSqlFile"><Icon Name="download" /><span class="btn-lbl">Save as .sql</span></button>
                <button class="btn btn-hover-expand" title="Open .sql script file" @onclick="TriggerOpenFile"><Icon Name="file" /><span class="btn-lbl">Open .sql</span></button>
                <button class="btn btn-hover-expand" title="Editor preferences" @onclick="() => editingPreferences = true"><Icon Name="cog" /><span class="btn-lbl">Editor settings</span></button>
                <button class="btn btn-hover-expand @(showAiPrompt ? "btn-primary" : "")" title="AI Assistant (Ctrl+I)" @onclick="ToggleAiPrompt"><Icon Name="sparkles" /><span class="btn-lbl">AI Assistant</span></button>
                <button class="btn btn-hover-expand" title="Entity-Relationship (ER) Diagram" @onclick="() => OpenErDiagram(null)" disabled="@(Current is null)"><Icon Name="grid" /><span class="btn-lbl">ER Diagram</span></button>
                <button class="btn btn-hover-expand @(formMode ? "btn-primary" : "")" title="Form Mode: auto-generate form for parameterized queries" @onclick="ToggleFormMode"><Icon Name="edit" /><span class="btn-lbl">Form Mode@(DetectedParameters.Count > 0 ? $" ({DetectedParameters.Count})" : "")</span></button>
            </div>
            <button class="icon-btn sm ws-split-toggle" title="@(layoutSplitHorizontal ? "Switch to stacked vertical layout" : "Switch to side-by-side horizontal layout")" @onclick="ToggleLayoutSplit"><Icon Name="@(layoutSplitHorizontal ? "rows" : "columns")" /></button>
            <button class="icon-btn sm ws-results-toggle @(resultsVisible ? "active" : "")"
                    type="button"
                    title="@(resultsVisible ? "Hide result viewer (Ctrl+`)" : "Show result viewer (Ctrl+`)")"
                    aria-label="@(resultsVisible ? "Hide result viewer" : "Show result viewer")"
                    aria-pressed="@(resultsVisible ? "true" : "false")"
                    @onclick="ToggleResults">
                <Icon Name="@(layoutSplitHorizontal ? "panel-right" : "panel-bottom")" />
            </button>
            <button class="icon-btn sm ws-focus-toggle @(IsFocusMode ? "active" : "")"
                    type="button"
                    title="@(IsFocusMode ? "Exit editor focus mode (Ctrl+Shift+E)" : "Editor focus mode: hide side panel and results (Ctrl+Shift+E)")"
                    aria-label="@(IsFocusMode ? "Exit editor focus mode" : "Enter editor focus mode")"
                    aria-pressed="@(IsFocusMode ? "true" : "false")"
                    @onclick="ToggleFocusMode">
                <Icon Name="@(IsFocusMode ? "minimize" : "maximize")" />
            </button>
            <button class="icon-btn sm ws-bar-desktop-only" title="Keyboard Shortcuts (?)" @onclick="() => showShortcutsModal = true"><Icon Name="key" /></button>
            <div class="ws-bar-overflow">
                <button class="icon-btn sm @(toolbarOverflow ? "active" : "")" type="button" title="More actions" aria-label="More actions" aria-expanded="@(toolbarOverflow ? "true" : "false")" @onclick="() => toolbarOverflow = !toolbarOverflow">
                    <Icon Name="more-horizontal" />
                </button>
                @if (toolbarOverflow)
                {
                    <div class="ws-bar-overflow-backdrop" @onclick="() => toolbarOverflow = false"></div>
                    <div class="ws-bar-overflow-menu">
                        <button type="button" class="ws-overflow-item" @onclick="async () => { toolbarOverflow = false; await FormatSql(); }"><Icon Name="format" /><span>Format SQL</span></button>
                        <button type="button" class="ws-overflow-item" @onclick="() => { toolbarOverflow = false; OpenSave(); }"><Icon Name="save" /><span>Save Query</span></button>
                        @if (Current?.HasFileHandle == true)
                        {
                            <button type="button" class="ws-overflow-item" @onclick="async () => { toolbarOverflow = false; await SaveSqlFile(); }"><Icon Name="save" /><span>Save file (@Current.LinkedFileName)</span></button>
                        }
                        <button type="button" class="ws-overflow-item" @onclick="async () => { toolbarOverflow = false; await DownloadSqlFile(); }"><Icon Name="download" /><span>Save as .sql</span></button>
                        <button type="button" class="ws-overflow-item" @onclick="async () => { toolbarOverflow = false; await TriggerOpenFile(); }"><Icon Name="file" /><span>Open .sql</span></button>
                        <div class="ws-overflow-divider"></div>
                        <button type="button" class="ws-overflow-item @(showAiPrompt ? "active" : "")" @onclick="() => { toolbarOverflow = false; ToggleAiPrompt(); }"><Icon Name="sparkles" /><span>AI Assistant</span></button>
                        <button type="button" class="ws-overflow-item" disabled="@(Current is null)" @onclick="() => { toolbarOverflow = false; OpenErDiagram(null); }"><Icon Name="grid" /><span>ER Diagram</span></button>
                        <button type="button" class="ws-overflow-item @(formMode ? "active" : "")" @onclick="async () => { toolbarOverflow = false; await ToggleFormMode(); }"><Icon Name="edit" /><span>Form Mode@(DetectedParameters.Count > 0 ? $" ({DetectedParameters.Count})" : "")</span></button>
                        <div class="ws-overflow-divider"></div>
                        <button type="button" class="ws-overflow-item" @onclick="() => { toolbarOverflow = false; editingPreferences = true; }"><Icon Name="cog" /><span>Editor settings</span></button>
                        <button type="button" class="ws-overflow-item" @onclick="() => { toolbarOverflow = false; showShortcutsModal = true; }"><Icon Name="key" /><span>Keyboard Shortcuts</span></button>
                    </div>
                }
            </div>
            <button type="button"
                    class="icon-btn sm ws-impact-toggle @(impactCheck ? "active" : "")"
                    title="@(impactCheck ? "Impact check enabled: analyze affected records and confirm before executing INSERT, UPDATE, DELETE, or DROP commands (click to disable)" : "Impact check disabled: click to enable pre-execution impact analysis")"
                    aria-label="@(impactCheck ? "Disable impact check" : "Enable impact check")"
                    aria-pressed="@(impactCheck ? "true" : "false")"
                    @onclick="() => impactCheck = !impactCheck">
                <Icon Name="shield" />
            </button>
            <label class="chip-toggle chip-warn @(dryRun ? "active" : "")" title="Dry run: execute in transaction and roll back">
                <input type="checkbox" class="visually-hidden" @bind="dryRun" />
                <span>Dry run</span>
            </label>
            <div class="chip-input" title="@TimeoutTooltip">
                <Icon Name="clock" />
                <input type="number" min="1" max="@maxTimeout" @bind="timeout" @bind:after="ValidateTimeout" placeholder="@defaultTimeout" />
                <span class="unit">s</span>
            </div>
        </div>

        @if (showAiPrompt)
        {
            <div class="ai-sheet-backdrop" @onclick="() => showAiPrompt = false"></div>
            <div class="ai-prompt-bar" style="padding:10px 14px;background:var(--bg-elev);border-bottom:1px solid var(--line);box-shadow:0 2px 8px rgba(0,0,0,0.04)">
                @if (!aiConfigured)
                {
                    <div class="row-inline" style="justify-content:space-between;color:var(--text-dim);font-size:12px">
                        <div class="row-inline" style="gap:8px">
                            <Icon Name="lock" />
                            <span><b>AI Assistant is not configured.</b> Bring your own AI (OpenAI, Gemini, Claude, or local Ollama) by configuring Settings.</span>
                        </div>
                        <a href="admin/settings" class="btn btn-sm btn-primary" style="text-decoration:none">Configure AI in Settings</a>
                    </div>
                }
                else
                {
                    <div class="stack" style="gap:8px">
                        <div class="row-inline" style="gap:8px">
                            <div style="flex:1;position:relative">
                                <input type="text"
                                       class="form-control"
                                       placeholder="Ask AI to write a query (e.g. 'Show top 10 customers by total spend with order counts')…"
                                       @bind="aiUserPrompt"
                                       @onkeydown='async e => { if (e.Key == "Enter" && !aiGenerating) await GenerateAiSql(); }'
                                       style="width:100%;height:32px;padding:4px 10px;font-size:13px" />
                            </div>
                            <button class="btn btn-primary btn-sm" type="button" disabled="@(aiGenerating || string.IsNullOrWhiteSpace(aiUserPrompt))" @onclick="GenerateAiSql">
                                @if (aiGenerating)
                                {
                                    <span class="spinner" style="width:12px;height:12px"></span> <span>Generating…</span>
                                }
                                else
                                {
                                    <Icon Name="sparkles" /> <span>Generate SQL</span>
                                }
                            </button>
                            <button class="icon-btn sm" title="Close AI Bar" type="button" @onclick="() => showAiPrompt = false"><Icon Name="x" /></button>
                        </div>

                        @if (!string.IsNullOrEmpty(aiGeneratedSql))
                        {
                            <div style="background:var(--bg-sunken);border:1px solid var(--line);border-radius:var(--radius-sm);padding:8px 12px">
                                <div class="row-inline" style="justify-content:space-between;margin-bottom:6px">
                                    <div class="row-inline" style="gap:6px">
                                        <b>Proposed SQL:</b>
                                        @if (aiSafetyWarnings.Count == 0)
                                        {
                                            <span class="badge ok" style="font-size:10px">✓ Compliant with Gate</span>
                                        }
                                        else
                                        {
                                            @foreach (var w in aiSafetyWarnings)
                                            {
                                                <span class="badge warn" style="font-size:10px">⚠ @w</span>
                                            }
                                        }
                                    </div>
                                    <div class="row-inline" style="gap:6px">
                                        <button class="btn btn-sm btn-primary" type="button" @onclick="InsertAiSqlToEditor">
                                            <Icon Name="code" /> Insert to Editor
                                        </button>
                                        <button class="btn btn-sm" type="button" @onclick="ReplaceAiSqlInEditor">
                                            Replace Tab
                                        </button>
                                        <button class="btn btn-sm" type="button" @onclick="CopyAiSql">
                                            <Icon Name="copy" /> Copy
                                        </button>
                                    </div>
                                </div>
                                <pre class="mono small" style="margin:0;padding:6px 8px;background:var(--bg-elev);border-radius:4px;overflow-x:auto;max-height:140px"><code>@aiGeneratedSql</code></pre>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(aiError))
                        {
                            <div class="alert bad small" style="margin:0">@aiError</div>
                        }
                    </div>
                }
            </div>
        }

        <div class="ws-body @(layoutSplitHorizontal ? "ws-body-horizontal" : "") @(resultsVisible ? "" : "results-hidden")">
            <div class="ws-editor-pane">
                @if (formMode)
                {
                    <div class="form-mode-view">
                        <div class="form-mode-head">
                            <div class="row-inline" style="gap:8px">
                                <Icon Name="edit" />
                                <b>Form Mode: Parameterized Data Runner</b>
                                <span class="badge ok">@DetectedParameters.Count parameter(s) detected</span>
                            </div>
                            <div class="row-inline" style="gap:8px">
                                <button class="btn btn-primary btn-sm" @onclick="RunForm" disabled="@running">
                                    <Icon Name="play" /> Run Form
                                </button>
                                <button class="btn btn-sm" @onclick="ToggleFormMode" title="Return to SQL editor">
                                    <Icon Name="code" /> Edit SQL
                                </button>
                            </div>
                        </div>

                        <div class="form-mode-body">
                            @if (DetectedParameters.Count == 0)
                            {
                                <div class="alert info small" style="margin:0">
                                    No parameters detected in this query. Add parameters like <code>:status</code>, <code>@@startDate</code>, or <code>&#123;&#123;id&#125;&#125;</code> in your SQL query to generate form inputs here.
                                    <div style="margin-top:10px">
                                        <button class="btn btn-sm" @onclick="ToggleFormMode"><Icon Name="code" /> Return to SQL Editor</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="form-mode-grid">
                                    @foreach (var param in DetectedParameters)
                                    {
                                        var pName = param;
                                        var val = formParamValues.GetValueOrDefault(pName, "");
                                        var isDate = pName.Contains("date", StringComparison.OrdinalIgnoreCase) || pName.Contains("time", StringComparison.OrdinalIgnoreCase);
                                        var isNum = pName.EndsWith("id", StringComparison.OrdinalIgnoreCase) || pName.Contains("count", StringComparison.OrdinalIgnoreCase) || pName.Contains("amount", StringComparison.OrdinalIgnoreCase) || pName.Contains("limit", StringComparison.OrdinalIgnoreCase);

                                        <div class="form-mode-field">
                                            <label>@pName</label>
                                            @if (isDate)
                                            {
                                                <input type="datetime-local" class="form-control" value="@val" @onchange="e => UpdateFormParam(pName, e.Value?.ToString())" />
                                            }
                                            else if (isNum)
                                            {
                                                <input type="number" class="form-control" value="@val" @onchange="e => UpdateFormParam(pName, e.Value?.ToString())" placeholder="Numeric value for @pName" />
                                            }
                                            else
                                            {
                                                <input type="text" class="form-control" value="@val" @onchange="e => UpdateFormParam(pName, e.Value?.ToString())" placeholder="Value for @pName" />
                                            }
                                        </div>
                                    }
                                </div>

                                <details class="form-mode-preview-box">
                                    <summary>Preview Parameterized SQL Query</summary>
                                    <pre class="mono small"><code>@Current?.Sql</code></pre>
                                </details>
                            }
                        </div>
                    </div>
                }

                <div id="sql-editor" class="editor-box" style="position:relative; @(formMode ? "display:none;" : "")">
                    @if (IsCurrentProd)
                    {
                        <div class="prod-watermark-overlay">PRODUCTION</div>
                    }
                </div>
            </div>

            <div class="ws-split" title="Drag to resize · Double-click to hide result viewer"></div>

            <ResultsGridPanel Last="last"
                              ActiveResult="activeResult"
                              OnSelectResult="SelectResultsView"
                              SortCol="sortCol"
                              SortAsc="sortAsc"
                              OnToggleSort="ToggleSort"
                              GridFilter="@gridFilter"
                              OnGridFilterChanged="OnGridFilterChanged"
                              Maximized="maximized"
                              OnSetMaximized="v => maximized = v"
                              LayoutSplitHorizontal="layoutSplitHorizontal"
                              OnToggleResults="ToggleResults"
                              CanExport="canExport"
                              AiConfigured="aiConfigured"
                              AiFixResult="aiFixResult"
                              AiExplainingPlan="aiExplainingPlan"
                              AiPlanExplanation="@aiPlanExplanation"
                              ChartType="@chartType"
                              OnChartTypeChanged="OnChartTypeChanged"
                              ChartCatCol="chartCatCol"
                              OnChartCatColChanged="OnChartCatColChanged"
                              ChartValCol="chartValCol"
                              OnChartValColChanged="OnChartValColChanged"
                              LastActiveResultIndex="lastActiveResultIndex"
                              OnCopyMessages="CopyMessages"
                              OnCopyActiveResultText="CopyActiveResultText"
                              OnExportCsv="ExportCsv"
                              OnExportXlsx="ExportXlsx"
                              OnExportXlsb="ExportXlsb"
                              OnExportJson="ExportJson"
                              OnCopyMarkdown="CopyMarkdown"
                              OnOpenSqlInsertDialog="OpenSqlInsertDialog"
                              OnFixErrorWithAi="FixErrorWithAi"
                              OnApplyFixedSqlToEditor="ApplyFixedSqlToEditor"
                              OnDismissAiFix="() => aiFixResult = null"
                              OnExplainPlanWithAi="ExplainPlanWithAi"
                              OnDismissAiPlan="() => aiPlanExplanation = null"
                              OnCopyPlanXml="CopyPlanXml"
                              OnCopyMissingIndex="CopyMissingIndex"
                              OnInsertMissingIndexToEditor="InsertMissingIndexToEditor"
                              OnOpenCellInspector="OpenCellInspector"
                              OnRefreshChart="RenderChartAsync"
                              OutcomeClass="OutcomeClass" />
    </div>
    @{
        var statusDb = Current is not null ? databases.FirstOrDefault(d => d.Id == Current.DatabaseId) : null;
    }
    <div class="ws-status">
        @if (statusDb is not null)
        {
            <span class="ws-status-item"><Icon Name="db" /><b>@statusDb.Name</b> <span class="badge @EnvClass(statusDb.Environment)">@statusDb.Environment</span></span>
        }
        @if (Current?.LinkedFileName is not null)
        {
            <span class="ws-status-item" title="Linked SQL file"><Icon Name="file" />@Current.LinkedFileName @(Current.IsDirty ? "(Modified)" : "(Saved)")</span>
        }
        @if (last is not null)
        {
            <span class="ws-status-item"><Icon Name="clock" />@last.DurationMs ms</span>
            @if (activeResult >= 0 && activeResult < last.ResultSets.Count)
            {
                <span class="ws-status-item">@last.RowsReturned row(s) @last.ResultSets[activeResult].Columns.Count col(s)</span>
            }
            else
            {
                <span class="ws-status-item">@last.RowsReturned row(s)</span>
            }
            @if (last.RowsAffected > 0)
            {
                <span class="ws-status-item">@last.RowsAffected affected</span>
            }
            @if (last.IsMasked)
            {
                <span class="badge warn" title="Sensitive PII columns redacted (no UNMASK permission)"><Icon Name="lock" />Masked (@last.MaskedColumns.Count PII redacted)</span>
            }
        }
        @if (!resultsVisible)
        {
            <button type="button" class="ws-status-toggle" @onclick="ToggleResults" title="Show result viewer (Ctrl+`)">
                <Icon Name="@(layoutSplitHorizontal ? "panel-right" : "panel-bottom")" />
                @if (last is not null)
                {
                    <span class="ws-status-dot @(last.Error is not null ? "bad" : "")"></span>
                }
                <span>Results hidden · Show</span>
            </button>
        }
        <span id="ws-status-cursor" class="ws-status-item ws-status-cursor">Ln @cursorLine, Col @cursorCol</span>
    </div>
    </section>
</div>
}

