    // SQL File Drag & Drop, Browse, Save & Single-Click Copy
    private async Task TriggerOpenFile()
    {
        if (Current is null) return;
        var res = await JS.InvokeAsync<OpenSqlFileResult>("dbam.openSqlFile", Current.Id);
        if (!res.Supported)
        {
            await JS.InvokeVoidAsync("dbam.triggerFileInput", "sql-file-input");
            return;
        }
        if (res.Cancelled) return;
        if (!string.IsNullOrWhiteSpace(res.Error))
        {
            Say($"Failed to open SQL file: {res.Error}");
            return;
        }
        if (res.FileName is null || res.Content is null) return;
        if (!res.FileName.EndsWith(".sql", StringComparison.OrdinalIgnoreCase))
        {
            await JS.InvokeVoidAsync("dbam.releaseTabFileHandle", Current.Id);
            Say($"Only .sql files are allowed. '{res.FileName}' was rejected.");
            return;
        }
        await LoadOpenedFileIntoCurrentTab(res.FileName, res.Content, hasHandle: true);
    }

    private async Task OnSqlFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        if (!file.Name.EndsWith(".sql", StringComparison.OrdinalIgnoreCase))
        {
            Say($"Only .sql files are allowed. '{file.Name}' was rejected.");
            return;
        }
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var reader = new StreamReader(stream, System.Text.Encoding.UTF8);
            var content = await reader.ReadToEndAsync();
            await LoadOpenedFileIntoCurrentTab(file.Name, content, hasHandle: false);
        }
        catch (Exception ex)
        {
            Say($"Failed to open SQL file: {ex.Message}");
        }
    }

    [JSInvokable]
    public async Task OnSqlFileDropped(string fileName, string content, bool hasHandle = false)
    {
        if (Current is null) return;
        if (hasHandle)
        {
            hasHandle = await JS.InvokeAsync<bool>("dbam.bindPendingDropHandle", Current.Id);
        }
        await LoadOpenedFileIntoCurrentTab(fileName, content, hasHandle);
    }

    private async Task LoadOpenedFileIntoCurrentTab(string fileName, string content, bool hasHandle)
    {
        if (Current is null) return;
        if (!hasHandle)
        {
            await JS.InvokeVoidAsync("dbam.releaseTabFileHandle", Current.Id);
        }
        Current.Sql = content;
        Current.LinkedFileName = fileName;
        Current.HasFileHandle = hasHandle;
        Current.LastSavedSql = content;
        await JS.InvokeVoidAsync("dbam.editorSet", "main", content);
        if (Current.Name.StartsWith("Query ") || Current.Name == "New tab")
        {
            var baseName = System.IO.Path.GetFileNameWithoutExtension(fileName);
            if (!string.IsNullOrWhiteSpace(baseName)) Current.Name = baseName;
        }
        await PersistAsync();
        Say($"Opened {fileName}");
        StateHasChanged();
    }

