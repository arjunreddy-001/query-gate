@code {
    private sealed class QueryTab
    {
        public string Id { get; set; } = Guid.NewGuid().ToString("N");
        public string Name { get; set; } = "Query 1";
        public Guid DatabaseId { get; set; }
        public string Sql { get; set; } = "";

        [System.Text.Json.Serialization.JsonIgnore]
        public ExecutionResult? LastResult { get; set; }

        [System.Text.Json.Serialization.JsonIgnore]
        public int ActiveResult { get; set; } = -1;

        [System.Text.Json.Serialization.JsonIgnore]
        public string? LastRunSql { get; set; }

        [System.Text.Json.Serialization.JsonIgnore]
        public List<string>? Confirm { get; set; }

        [System.Text.Json.Serialization.JsonIgnore]
        public string? GridFilter { get; set; }

        [System.Text.Json.Serialization.JsonIgnore]
        public int? SortCol { get; set; }

        [System.Text.Json.Serialization.JsonIgnore]
        public bool SortAsc { get; set; } = true;

        [System.Text.Json.Serialization.JsonIgnore]
        public bool ShowRawPlanXml { get; set; }
    }

    [SupplyParameterFromQuery(Name = "db")] public Guid? DbParam { get; set; }

    private List<ManagedDatabase> databases = [];
    private List<QueryTab> tabs = [];
    private string activeId = "";
    private QueryTab? Current => tabs.FirstOrDefault(t => t.Id == activeId);
    private bool loaded, running, dryRun, saving, initialized, maximized;
    private bool? sideOpen;
    private int? timeout;
    private int defaultTimeout = 30;
    private int maxTimeout = 300;
    private bool canExport;
    private string TimeoutTooltip => $"Query timeout in seconds (Default: {defaultTimeout}s, Max allowed: {maxTimeout}s)";
    private ExecutionResult? last;
    private int activeResult;
    private Guid runId;
    private List<string>? confirm;
    private string side = "explorer", filter = "", objectTypeFilter = "All";
    private bool fuzzySearch = true;
    private bool showDisabledDatabases;
    private List<DbObjectInfo> objects = [];
    private HashSet<string> expanded = [];
    private bool metaLoading;
    private string? metaError;
    private long metadataRequest;
    private List<SavedQuery> saved = [];
    private List<QueryHistory> history = [];
    private string saveName = "", saveTags = "", saveDesc = "";
    private DotNetObjectReference<Query>? self;
    private string? lastRunSql;
    private bool editingPreferences, automaticSuggestions = true, liveDiagnostics;
    private string? preferencesError;
    private int fontSize = 14;
    private EditorPreferences savedPreferences = new(true, false, 14);
    private sealed record EditorPreferences(bool AutomaticSuggestions, bool LiveDiagnostics, int FontSize);
    public sealed record SyntaxDiagnostic(int Line, int Column, string Message);

    private IEnumerable<DbObjectInfo> FilteredObjects => BuildFilteredObjects();

    private Guid CurrentDbId
    {
        get => Current?.DatabaseId ?? Guid.Empty;
        set
        {
            if (Current is not null && Current.DatabaseId != value)
            {
                Current.DatabaseId = value;
                ResetResults();
                SaveTabResultState(Current);
                _ = OnDbChanged();
            }
        }
    }

    private void ResetResults()
    {
        last = null;
        activeResult = -1;
        confirm = null;
        gridFilter = "";
        sortCol = null;
        sortAsc = true;
        showRawPlanXml = false;
        lastRunSql = null;
    }

    private void SaveTabResultState(QueryTab? tab)
    {
        if (tab is null) return;
        tab.LastResult = last;
        tab.ActiveResult = activeResult;
        tab.LastRunSql = lastRunSql;
        tab.Confirm = confirm;
        tab.GridFilter = gridFilter;
        tab.SortCol = sortCol;
        tab.SortAsc = sortAsc;
        tab.ShowRawPlanXml = showRawPlanXml;
    }

    private void LoadTabResultState(QueryTab? tab)
    {
        if (tab is null)
        {
            ResetResults();
            return;
        }
        last = tab.LastResult;
        activeResult = tab.ActiveResult;
        lastRunSql = tab.LastRunSql;
        confirm = tab.Confirm;
        gridFilter = tab.GridFilter ?? "";
        sortCol = tab.SortCol;
        sortAsc = tab.SortAsc;
        showRawPlanXml = tab.ShowRawPlanXml;
    }

    protected override async Task OnLoadAsync()
    {
        await ReloadDatabases();
        defaultTimeout = await SettingsSvc.GetIntAsync("DefaultTimeoutSeconds");
        maxTimeout = await SettingsSvc.GetIntAsync("MaxTimeoutSeconds");
        if (!timeout.HasValue) timeout = defaultTimeout;
        await using var db = await DbFactory.CreateDbContextAsync();
        var user = await db.Users.AsNoTracking().SingleAsync(u => u.Id == UserId);
        savedPreferences = new(user.EditorAutomaticSuggestions, user.EditorLiveDiagnostics, user.EditorFontSize);
        CancelPreferences();
        loaded = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            sideOpen = !await JS.InvokeAsync<bool>("dbam.isNarrowViewport");
            StateHasChanged();
        }
        // Blazor renders (and fires firstRender) before the async load finishes, so initialise once data is available.
        if (initialized || !loaded || databases.Count == 0) return;
        initialized = true;
        try
        {
            var stored = await Storage.GetAsync<string>("dbam-tabs-" + UserId);
            if (stored.Success && stored.Value is not null)
                tabs = JsonSerializer.Deserialize<List<QueryTab>>(stored.Value)?.Where(t => databases.Any(d => d.Id == t.DatabaseId)).ToList() ?? [];
        }

        catch { tabs = []; }

        if (tabs.Count == 0) tabs.Add(new QueryTab { DatabaseId = DbParam ?? databases[0].Id, Sql = "SELECT TOP 10 * FROM sys.objects;" });
        else if (DbParam is { } p && databases.Any(d => d.Id == p)) tabs.Add(new QueryTab { Name = "Query " + (tabs.Count + 1), DatabaseId = p });
        activeId = tabs[^1].Id;
        LoadTabResultState(Current);

        self = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("dbam.workspaceInit", "query-ws");
        await JS.InvokeAsync<bool>("dbam.editorInit", "main", "sql-editor", self, Current!.Sql, savedPreferences);
        await OnDbChanged();
        StateHasChanged();
    }

    private void ToggleSide() => sideOpen = sideOpen != true;

    private void CancelPreferences()
    {
        automaticSuggestions = savedPreferences.AutomaticSuggestions;
        liveDiagnostics = savedPreferences.LiveDiagnostics;
        fontSize = savedPreferences.FontSize;
        preferencesError = null;
        editingPreferences = false;
    }

    private async Task SavePreferences()
    {
        if (fontSize is < 10 or > 24) { preferencesError = "Editor font size must be between 10 and 24."; return; }
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var user = await db.Users.SingleAsync(u => u.Id == UserId);
            user.EditorAutomaticSuggestions = automaticSuggestions;
            user.EditorLiveDiagnostics = liveDiagnostics;
            user.EditorFontSize = fontSize;
            await db.SaveChangesAsync();
            savedPreferences = new(automaticSuggestions, liveDiagnostics, fontSize);
            await AuditSvc.TryWriteAsync(Me, "Settings", "EditorPreferencesUpdated", "Success");
            await JS.InvokeVoidAsync("dbam.editorPreferences", "main", savedPreferences);
            editingPreferences = false;
            preferencesError = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not save editor preferences for user {UserId}", UserId);
            preferencesError = "Could not save or apply editor settings. Try again.";
        }
    }

    [JSInvokable]
    public List<SyntaxDiagnostic> GetSyntaxDiagnostics(string sql)
    {
        if (!savedPreferences.LiveDiagnostics) return [];
        if (sql.Length > 4000) return [new SyntaxDiagnostic(1, 1, "Live diagnostics are unavailable for SQL over 4,000 characters.")];
        var diagnostics = new List<SyntaxDiagnostic>();
        var currentDb = databases.FirstOrDefault(d => d.Id == Current?.DatabaseId);
        var engine = currentDb?.Engine ?? DatabaseEngine.SqlServer;

        if (engine == DatabaseEngine.SqlServer)
        {
            foreach (var batch in SqlGate.SplitBatches(sql, engine))
            {
                var parser = new TSql160Parser(initialQuotedIdentifiers: true);
                using var reader = new StringReader(batch.Text);
                parser.Parse(reader, out var errors);
                diagnostics.AddRange(errors.Take(20 - diagnostics.Count)
                    .Select(e => new SyntaxDiagnostic(e.Line + batch.LineOffset, e.Column, e.Message)));
                if (diagnostics.Count >= 20) break;
            }
        }
        else
        {
            var analysis = Gate.Analyze(sql, engine);
            if (analysis.ParseErrors.Count > 0)
            {
                diagnostics.AddRange(analysis.ParseErrors.Take(20).Select(err => new SyntaxDiagnostic(1, 1, err)));
            }
        }
        return diagnostics;
    }

    [JSInvokable]
    public Task OnDiagnosticsError() => InvokeAsync(() => { Say("Could not check SQL syntax.", true); StateHasChanged(); });

    private async Task OnDbChanged()
    {
        await CheckExportPermissionAsync();
        await LoadMetadata(false);
        await LoadSidePanels();
        await PersistAsync();
        StateHasChanged();
    }

    private async Task CheckExportPermissionAsync()
    {
        if (Current is not null && Current.DatabaseId != Guid.Empty)
        {
            canExport = await Permissions.HasAsync(UserId, Current.DatabaseId, Perm.Export);
        }
        else
        {
            canExport = false;
        }
    }

    private void ValidateTimeout()
    {
        if (!timeout.HasValue)
        {
            timeout = defaultTimeout;
            return;
        }

        if (timeout.Value < 1)
        {
            timeout = 1;
            Say("Minimum query timeout is 1 second.", true);
        }
        else if (timeout.Value > maxTimeout)
        {
            timeout = maxTimeout;
            Say($"Maximum allowed query timeout is {maxTimeout} seconds.", true);
        }
    }

    private async Task ReloadDatabases()
    {
        databases = await Permissions.GetAccessibleDatabasesAsync(UserId, showDisabledDatabases);
        if (Current is not null && databases.All(d => d.Id != Current.DatabaseId) && databases.Count > 0)
            Current.DatabaseId = databases[0].Id;
    }

    private async Task LoadMetadata(bool refresh)
    {
        if (Current is null) return;
        var databaseId = Current.DatabaseId;
        var request = ++metadataRequest;
        objects = [];
        await JS.InvokeVoidAsync("dbam.setMetadata", Array.Empty<DbObjectInfo>());
        metaLoading = true; metaError = null; StateHasChanged();
        try
        {
            var loadedObjects = await Metadata.GetAsync(databaseId, refresh);
            if (request != metadataRequest || Current?.DatabaseId != databaseId) return;
            objects = loadedObjects;
            await JS.InvokeVoidAsync("dbam.setMetadata", objects);
        }
        catch (Exception ex)
        {
            if (request != metadataRequest || Current?.DatabaseId != databaseId) return;
            objects = []; metaError = "Could not load objects: " + ex.Message;
        }
        metaLoading = false;
    }

    private async Task LoadSidePanels()
    {
        if (Current is null) return;
        saved = await Workspace.SavedAsync(UserId, Current.DatabaseId);
        history = await Workspace.HistoryAsync(UserId, Current.DatabaseId);
    }

    private async Task SwitchSide(string tab) { side = tab; await LoadSidePanels(); }

    [JSInvokable] public Task OnChanged(string value) { if (Current is not null) Current.Sql = value; return Task.CompletedTask; }
    [JSInvokable] public Task OnRun() => InvokeAsync(Run);
    [JSInvokable] public Task OnFormat() => InvokeAsync(FormatSql);
    [JSInvokable] public Task OnSave() => InvokeAsync(() => { OpenSave(); StateHasChanged(); });

    private async Task PersistAsync()
    {
        try { await Storage.SetAsync("dbam-tabs-" + UserId, JsonSerializer.Serialize(tabs)); } catch { }
    }

    private async Task Activate(string id)
    {
        if (id == activeId) return;
        await SyncCurrent();
        SaveTabResultState(Current);
        activeId = id;
        LoadTabResultState(Current);
        await JS.InvokeVoidAsync("dbam.editorSet", "main", Current!.Sql);
        await OnDbChanged();
    }

    private async Task SyncCurrent()
    {
        if (Current is not null) Current.Sql = await JS.InvokeAsync<string>("dbam.editorGet", "main");
    }

    private async Task NewTab()
    {
        await SyncCurrent();
        SaveTabResultState(Current);
        tabs.Add(new QueryTab { Name = "Query " + (tabs.Count + 1), DatabaseId = Current?.DatabaseId ?? databases[0].Id });
        activeId = tabs[^1].Id;
        LoadTabResultState(Current);
        await JS.InvokeVoidAsync("dbam.editorSet", "main", "");
        await PersistAsync();
    }

    private async Task CloseTab(string id)
    {
        if (tabs.Count == 1) { Current!.Sql = ""; await JS.InvokeVoidAsync("dbam.editorSet", "main", ""); return; }
        var wasActive = id == activeId;
        tabs.RemoveAll(t => t.Id == id);
        if (wasActive)
        {
            activeId = tabs[^1].Id;
            LoadTabResultState(Current);
            await JS.InvokeVoidAsync("dbam.editorSet", "main", Current!.Sql);
            await OnDbChanged();
        }
        else await PersistAsync();
    }

    private async Task LoadSql(string sql, string? name)
    {
        await JS.InvokeVoidAsync("dbam.editorSet", "main", sql);
        if (Current is not null) { Current.Sql = sql; if (name is not null) Current.Name = name; }
        await PersistAsync();
    }

    private async Task InsertSelect(DbObjectInfo o)
    {
        var currentDb = databases.FirstOrDefault(d => d.Id == Current?.DatabaseId);
        var engine = currentDb?.Engine ?? DatabaseEngine.SqlServer;
        string sql;
        if (o.Type is "Table" or "View")
        {
            sql = engine switch
            {
                DatabaseEngine.PostgreSql => $"SELECT * FROM \"{o.Schema}\".\"{o.Name}\" LIMIT 100;",
                DatabaseEngine.MySql or DatabaseEngine.MariaDb => $"SELECT * FROM `{o.Schema}`.`{o.Name}` LIMIT 100;",
                _ => $"SELECT TOP 100 * FROM [{o.Schema}].[{o.Name}];"
