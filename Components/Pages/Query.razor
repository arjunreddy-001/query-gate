    private async Task FormatSql()
    {
        await SyncCurrent();
        if (Current is null || string.IsNullOrWhiteSpace(Current.Sql)) return;
        var currentDb = databases.FirstOrDefault(d => d.Id == Current.DatabaseId);
        var engine = currentDb?.Engine ?? DatabaseEngine.SqlServer;
        try
        {
            if (engine == DatabaseEngine.SqlServer)
            {
                var parts = SqlGate.SplitBatches(Current.Sql, engine).Select(b => Gate.Format(b.Text, engine, true, 4).Trim());
                var formatted = string.Join("\nGO\n\n", parts);
                await LoadSql(formatted, null);
            }
            else
            {
                var parts = SqlGate.SplitBatches(Current.Sql, engine).Select(b => Gate.Format(b.Text, engine, true, 4).Trim());
                var formatted = string.Join(";\n\n", parts);
                if (!formatted.EndsWith(';')) formatted += ";";
                await LoadSql(formatted, null);
            }
        }
        catch (Exception ex) { Say(ex.Message, true); }
    }

