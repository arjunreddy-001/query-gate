        formMode = !formMode;
        if (formMode)
        {
            foreach (var p in DetectedParameters)
            {
                if (!formParamValues.ContainsKey(p)) formParamValues[p] = "";
            }
        }
        else
        {
            await Task.Yield();
            await JS.InvokeVoidAsync("dbam.editorLayout", "main");
        }
    }

