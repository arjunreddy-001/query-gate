    private async Task LoadMetadata(bool refresh)
    {
        if (Current is null) return;
        var databaseId = Current.DatabaseId;
        var request = ++metadataRequest;
        objects = [];
        expanded.Clear();
        expandVersion++;
        await JS.InvokeVoidAsync("dbam.setMetadata", Array.Empty<AutocompleteObjectDto>());
        metaLoading = true; metaError = null; StateHasChanged();
        try
        {
            var loadedObjects = await Metadata.GetAsync(databaseId, refresh);
            if (request != metadataRequest || Current?.DatabaseId != databaseId) return;
            objects = loadedObjects;
            _loadedMetadataDbId = databaseId;
            _hasLoadedMetadataForDb = true;
            await JS.InvokeVoidAsync("dbam.setMetadata", objects.Select(o => new AutocompleteObjectDto(o.Schema, o.Name, o.Type, o.Columns)));
        }
        catch (Exception ex)
        {
            if (request != metadataRequest || Current?.DatabaseId != databaseId) return;
            objects = []; metaError = "Could not load objects: " + ex.Message;
            _loadedMetadataDbId = Guid.Empty;
            _hasLoadedMetadataForDb = false;
        }
        metaLoading = false;
    }

