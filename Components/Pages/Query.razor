@page "/query"
@attribute [Authorize]
@implements IAsyncDisposable
@inherits PageBase
@inject PermissionService Permissions
@inject ExecutionService Execution
@inject MetadataService Metadata
@inject WorkspaceService Workspace
@inject SqlGate Gate
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuditService AuditSvc
@inject ILogger<Query> Logger
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedLocalStorage Storage
@inject SettingsService SettingsSvc
@using System.Text
@using System.Text.Json
@using Microsoft.SqlServer.TransactSql.ScriptDom

<PageTitle>Query workspace · Query Gate</PageTitle>

@if (databases.Count == 0 && loaded)
{
    <div class="card empty"><Icon Name="lock" /><h3>No databases available</h3><p>You haven't been granted access to any database yet.</p><a class="btn btn-primary" href="access">Request access</a></div>
}
else
{
<div id="query-ws" class="ws @(sideOpen is null ? "side-auto" : sideOpen.Value ? "side-open" : "side-hidden")">
    <aside id="workspace-panel" class="card ws-side">
        <div class="tabs" style="margin:0;padding:0 8px">
            <button class="tab @(side == "explorer" ? "active" : "")" @onclick='() => side = "explorer"'>Objects</button>
            <button class="tab @(side == "saved" ? "active" : "")" @onclick='() => SwitchSide("saved")'>Saved</button>
            <button class="tab @(side == "history" ? "active" : "")" @onclick='() => SwitchSide("history")'>History</button>
            <button class="mobile-panel-close icon-btn sm" type="button" aria-label="Close workspace panel" @onclick="ToggleSide"><Icon Name="x" /></button>
        </div>
        <div class="scroll">
            @if (side == "explorer")
            {
                <div class="stack" style="margin-bottom:8px">
                    <div class="row-inline">
                        <input type="search" placeholder="Filter objects…" @bind="filter" @bind:event="oninput" />
                        <label class="check small" title="Use typo-tolerant fuzzy search"><input type="checkbox" @bind="fuzzySearch" />Fuzzy</label>
                        <button class="icon-btn" title="Refresh" @onclick="() => LoadMetadata(true)" style="flex:none"><Icon Name="refresh" /></button>
                    </div>
                    <div class="row-inline obj-filters">
                        <button class="icon-btn sm obj-filter @(objectTypeFilter == "All" ? "active" : "")" title="All" @onclick='() => objectTypeFilter = "All"'><Icon Name="list" /></button>
                        <button class="icon-btn sm obj-filter @(objectTypeFilter == "Table" ? "active" : "")" title="Tables" @onclick='() => objectTypeFilter = "Table"'><Icon Name="table" /></button>
                        <button class="icon-btn sm obj-filter @(objectTypeFilter == "View" ? "active" : "")" title="Views" @onclick='() => objectTypeFilter = "View"'><Icon Name="eye" /></button>
                        <button class="icon-btn sm obj-filter @(objectTypeFilter == "Procedure" ? "active" : "")" title="Procedures" @onclick='() => objectTypeFilter = "Procedure"'><Icon Name="code" /></button>
                        <button class="icon-btn sm obj-filter @(objectTypeFilter == "Function" ? "active" : "")" title="Functions" @onclick='() => objectTypeFilter = "Function"'><Icon Name="code" /></button>
                    </div>
                </div>
                @if (metaLoading) { <div class="stack"><div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div></div> }
                else if (metaError is not null) { <div class="alert bad small">@metaError</div> }
                else
                {
                    @foreach (var o in FilteredObjects)
                    {
                        var key = o.Schema + "." + o.Name;
                        var isExpanded = expanded.Contains(key);
                        <div class="tree-item"
                             @onclick="() => InsertSelect(o)"
                             @ondblclick="() => Toggle(key)"
                             @ondblclick:stopPropagation
                             @oncontextmenu="e => OpenObjectContextMenu(e, o)"
                             @oncontextmenu:preventDefault
                             title="Click: SELECT TOP 100 · Right-click: Menu · Double-click: Columns">
                            <span class="tree-chevron" style="display:inline-block;width:12px;font-size:10px;color:var(--text-faint);cursor:pointer" @onclick:stopPropagation @onclick="() => Toggle(key)" title="Toggle columns">
                                @(isExpanded ? "▾" : "▸")
                            </span>
                            <Icon Name="@(o.Type == "Table" ? "table" : o.Type == "View" ? "eye" : "code")" />
                            <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@key">@key</span>
                            <span class="faint small" style="margin-left:auto;font-size:11px">@o.Type</span>
                        </div>
                        @if (isExpanded)
                        {
                            @foreach (var c in o.Columns)
                            {
                                <div class="tree-col" @onclick="() => CopyColumn(c)" title="Click to copy column name" style="cursor:pointer">
                                    <span style="opacity:0.6;font-size:10px">●</span> @c
                                </div>
                            }
                        }
                    }
                    @if (!FilteredObjects.Any()) { <div class="muted small" style="padding:8px">No objects.</div> }
                }
            }
            else if (side == "saved")
            {
                @foreach (var s in saved)
                {
                    <div class="tree-item" @onclick="() => LoadSql(s.SqlText, s.Name)">
                        <Icon Name="star" /><div style="min-width:0"><div>@s.Name</div>@if (!string.IsNullOrEmpty(s.Tags)) { <div class="faint small">@s.Tags</div> }</div>
                        <button class="btn-ghost btn btn-sm" style="margin-left:auto" @onclick:stopPropagation @onclick="() => PromptDeleteSaved(s)" title="Delete saved query"><Icon Name="x" /></button>
                    </div>
                }
                @if (saved.Count == 0) { <div class="muted small" style="padding:8px">Nothing saved for this database. Use Save (Ctrl+S).</div> }
            }
            else
            {
                @foreach (var h in history)
                {
                    <div class="tree-item" style="flex-direction:column;align-items:stretch" @onclick="() => LoadSql(h.SqlText, null)">
                        <div class="row-inline"><span class="badge @OutcomeClass(h.Outcome)">@h.Outcome</span><span class="faint small">@Ago(h.ExecutedAt) · @h.DurationMs ms</span></div>
                        <div class="cell-sql" style="max-width:100%">@h.SqlText</div>
                    </div>
                }
                @if (history.Count == 0) { <div class="muted small" style="padding:8px">No history yet.</div> }
            }
        </div>
    </aside>
    <div class="ws-side-split" title="Drag to resize object panel"></div>

    <section class="ws-main">
        <div class="ws-tabs">
            <button class="icon-btn sm" type="button" title="@(sideOpen == true ? "Hide panel" : "Show panel")" aria-label="@(sideOpen == true ? "Hide objects, saved queries and history" : "Show objects, saved queries and history")" aria-controls="workspace-panel" aria-expanded="@(sideOpen == true ? "true" : "false")" @onclick="ToggleSide"><Icon Name="list" /></button>
            @foreach (var t in tabs)
            {
                var isEditing = editingTabId == t.Id;
                <div class="ws-tab @(t.Id == activeId ? "active" : "")"
                     @onclick="() => Activate(t.Id)"
                     @ondblclick="() => StartRenameTab(t)"
                     title="Click to switch · Double-click to rename">
                    @if (isEditing)
                    {
                        <input class="tab-rename-input"
                               @bind="editingTabName"
                               @bind:event="oninput"
                               @onclick:stopPropagation
                               @ondblclick:stopPropagation
                               @onkeydown="HandleTabRenameKey"
                               @onblur="CommitTabRename"
                               autofocus />
                    }
                    else
                    {
                        <span>@t.Name</span>
                    }
                    <button type="button" title="Close" @onclick:stopPropagation @onclick="() => CloseTab(t.Id)">×</button>
                </div>
            }
            <button class="btn btn-sm btn-ghost" @onclick="NewTab"><Icon Name="plus" />New</button>
        </div>

        <div class="row-inline ws-bar">
            @if (Current is not null && databases.FirstOrDefault(d => d.Id == Current.DatabaseId) is { } cd)
            {
                <div class="db-selector-wrap">
                    <button type="button" class="db-selector-btn" @onclick="ToggleDbDropdown" title="Switch database (@cd.Name)">
                        <Icon Name="db" />
                        <span class="db-name" title="@cd.Name">@cd.Name</span>
                        <span class="badge @EnvClass(cd.Environment)">@cd.Environment</span>
                        <span class="badge @DatabaseEngineInfo.GetBadgeClass(cd.Engine)">@DatabaseEngineInfo.GetDisplayName(cd.Engine)</span>
                        @if (!cd.IsActive) { <span class="badge bad">Disabled</span> }
                        <span style="font-size:10px;margin-left:2px;opacity:0.7">▾</span>
                    </button>
                    @if (dbDropdownOpen)
                    {
                        <div class="db-selector-backdrop" @onclick="() => dbDropdownOpen = false"></div>
                        <div class="db-selector-menu">
                            <input type="search"
                                   class="db-selector-search"
                                   placeholder="Search databases by name, environment, engine…"
                                   @bind="dbSearchText"
                                   @bind:event="oninput"
                                   @onclick:stopPropagation
                                   autofocus />
                            <div class="db-selector-list">
                                @{
                                    var filteredDbs = databases.Where(d => string.IsNullOrWhiteSpace(dbSearchText) ||
                                        d.Name.Contains(dbSearchText, StringComparison.OrdinalIgnoreCase) ||
                                        d.Environment.Contains(dbSearchText, StringComparison.OrdinalIgnoreCase) ||
                                        DatabaseEngineInfo.GetDisplayName(d.Engine).Contains(dbSearchText, StringComparison.OrdinalIgnoreCase)).ToList();
                                }
                                @foreach (var d in filteredDbs)
                                {
                                    var isSelected = d.Id == Current.DatabaseId;
                                    <button type="button" class="db-selector-item @(isSelected ? "selected" : "")" @onclick="() => SelectDatabase(d.Id)">
                                        <div class="db-info">
                                            <div class="db-title">
                                                @if (isSelected) { <span style="color:var(--brand);margin-right:4px">✓</span> }
                                                @d.Name
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(d.Description))
                                            {
                                                <div class="db-desc">@d.Description</div>
                                            }
                                        </div>
                                        <div class="db-tags">
                                            <span class="badge @EnvClass(d.Environment)">@d.Environment</span>
                                            <span class="badge @DatabaseEngineInfo.GetBadgeClass(d.Engine)">@DatabaseEngineInfo.GetDisplayName(d.Engine)</span>
                                            @if (!d.IsActive) { <span class="badge bad">Disabled</span> }
                                        </div>
                                    </button>
                                }
                                @if (filteredDbs.Count == 0)
                                {
                                    <div class="muted small" style="padding:12px;text-align:center">No databases match "@dbSearchText".</div>
                                }
                            </div>
                            <div class="db-selector-footer">
                                <label class="check small">
                                    <input type="checkbox" @bind="showDisabledDatabases" @bind:after="ReloadDatabases" /> Show disabled databases
                                </label>
                                <span class="faint small">@databases.Count available</span>
                            </div>
                        </div>
                    }
                </div>
            }
            @if (running) { <button class="btn btn-danger" @onclick="CancelRun"><Icon Name="stop" />Cancel</button> }
            else
            {
                <button class="btn btn-primary" title="Run (F5 or Ctrl+Enter). Runs the selection if any." @onclick="Run"><Icon Name="play" />Run</button>
                <button class="btn btn-hover-expand" title="Explain query plan" @onclick="ExplainPlan" disabled="@(Current is null)">
                    <Icon Name="activity" /><span class="btn-lbl">Explain</span>
                </button>
            }
            <button class="btn btn-hover-expand" title="Format (Shift+Alt+F)" @onclick="FormatSql">
                <Icon Name="format" /><span class="btn-lbl">Format</span>
            </button>
            <button class="btn btn-hover-expand" title="Save (Ctrl+S)" @onclick="OpenSave">
                <Icon Name="save" /><span class="btn-lbl">Save</span>
            </button>
            <button class="btn btn-hover-expand" title="Editor preferences" @onclick="() => editingPreferences = true">
                <Icon Name="cog" /><span class="btn-lbl">Editor settings</span>
            </button>
            <label class="chip-toggle chip-warn @(dryRun ? "active" : "")" title="Dry run: execute in transaction and roll back">
                <input type="checkbox" class="visually-hidden" @bind="dryRun" />
                <span>Dry run</span>
            </label>
            <div class="chip-input" title="@TimeoutTooltip">
                <Icon Name="clock" />
                <input type="number" min="1" max="@maxTimeout" @bind="timeout" @bind:after="ValidateTimeout" placeholder="@defaultTimeout" />
                <span class="unit">s</span>
            </div>
        </div>

        <div id="sql-editor" class="editor-box"></div>
        <div class="ws-split" title="Drag to resize"></div>

        <div class="card results @(maximized ? "maximized" : "")" @onkeydown='e => { if (e.Key == "Escape") maximized = false; }' tabindex="-1">
            <div class="card-head" style="padding:5px 10px">
                @if (last is null) { <span class="muted">Results appear here.</span> }
                else
                {
                    <span class="badge @OutcomeClass(last.Outcome)">@last.Outcome</span>
                    @if (last.IsMasked)
                    {
                        <span class="badge warn" title="Sensitive PII columns redacted (no UNMASK permission)"><Icon Name="lock" />Masked (@last.MaskedColumns.Count PII redacted)</span>
                    }
                    <span class="muted small">@last.DurationMs ms · @last.RowsReturned row(s) returned@(last.RowsAffected > 0 ? $" · {last.RowsAffected} affected" : "")</span>
                    <div class="actions">
                        @for (var i = 0; i < last.ResultSets.Count; i++)
                        {
                            var idx = i;
                            <button class="btn btn-sm @(activeResult == idx ? "btn-primary" : "")" @onclick="() => { activeResult = idx; sortCol = null; SaveTabResultState(Current); }">Result @(idx + 1)</button>
                        }
                        <button class="btn btn-sm @(activeResult == -1 ? "btn-primary" : "")" @onclick="() => { activeResult = -1; SaveTabResultState(Current); }">Messages</button>
                        @if (last.ExecutionPlan is not null)
                        {
                            <button class="btn btn-sm @(activeResult == -2 ? "btn-primary" : "")" @onclick="() => { activeResult = -2; SaveTabResultState(Current); }"><Icon Name="activity" />Execution Plan</button>
                        }
                        @if (last.ResultSets.Count > 0 && activeResult >= 0)
                        {
                            <input type="search" placeholder="Filter rows…" @bind="gridFilter" @bind:event="oninput" style="width:130px;height:24px;padding:2px 8px;font-size:12px;margin-right:2px" title="Filter displayed rows" />
                            @if (!string.IsNullOrWhiteSpace(gridFilter))
                            {
                                var matchCount = GetProcessedRows(last.ResultSets[activeResult]).Count;
                                <span class="badge" style="font-size:11px" title="Matching rows">@matchCount/@last.ResultSets[activeResult].Rows.Count</span>
                            }
                            @if (canExport)
                            {
                                <div class="export-dropdown">
                                    <button class="btn btn-sm" type="button" title="Export results">
                                        <Icon Name="download" />Export <span style="font-size:9px;margin-left:2px">▾</span>
                                    </button>
                                    <div class="export-dropdown-menu">
                                        <button class="export-dropdown-item" type="button" @onclick="ExportCsv">
                                            <Icon Name="file" />CSV (.csv)
                                        </button>
                                        <button class="export-dropdown-item" type="button" @onclick="ExportXlsx">
                                            <Icon Name="table" />Excel (.xlsx)
                                        </button>
                                        <button class="export-dropdown-item" type="button" @onclick="ExportXlsb">
                                            <Icon Name="table" />Excel Binary (.xlsb)
                                        </button>
                                        <button class="export-dropdown-item" type="button" @onclick="ExportJson">
                                            <Icon Name="code" />JSON (.json)
                                        </button>
                                        <hr class="export-dropdown-divider" />
                                        <button class="export-dropdown-item" type="button" @onclick="CopyMarkdown">
                                            <Icon Name="copy" />Copy Markdown
                                        </button>
                                        <button class="export-dropdown-item" type="button" @onclick="OpenSqlInsertDialog">
                                            <Icon Name="code" />SQL INSERT…
                                        </button>
                                    </div>
                                </div>
                            }
                        }
                        <button class="btn btn-sm" title="@(maximized ? "Minimize (Esc)" : "Maximize results")" @onclick="() => maximized = !maximized"><Icon Name="@(maximized ? "minimize" : "maximize")" />@(maximized ? "Minimize" : "Maximize")</button>
                    </div>
                }
            </div>
            @if (last is not null)
            {
                @if (last.Error is not null)
                {
                    <div class="alert bad" style="margin:12px"><b>@last.Error</b>@if (last.ErrorLine is not null) { <span> (line @last.ErrorLine)</span> }
                        @foreach (var d in last.Denials.Where(d => d != last.Error)) { <div class="small">@d</div> }</div>
                }
                @if (activeResult >= 0 && activeResult < last.ResultSets.Count)
                {
                    var rs = last.ResultSets[activeResult];
                    var rowsToDisplay = GetProcessedRows(rs);
                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th class="num">#</th>
                                    @for (var cIdx = 0; cIdx < rs.Columns.Count; cIdx++)
                                    {
                                        var col = cIdx;
                                        var colName = rs.Columns[col];
                                        var isColMasked = rs.MaskedColumns.Contains(colName, StringComparer.OrdinalIgnoreCase);
                                        <th class="sortable" @onclick="() => ToggleSort(col)" title="Click to sort" style="cursor:pointer;user-select:none">
                                            <span style="display:inline-flex;align-items:center;gap:4px">
                                                @if (isColMasked)
                                                {
                                                    <span title="Sensitive data masked (no UNMASK permission)"><Icon Name="lock" /></span>
                                                }
                                                <span>@colName</span>
                                            </span>
                                            @if (sortCol == col)
                                            {
                                                <span class="sort-icon" style="margin-left:4px;font-size:10px;color:var(--brand)">@(sortAsc ? "▲" : "▼")</span>
                                            }
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @for (var r = 0; r < rowsToDisplay.Count; r++)
                                {
                                    var row = rowsToDisplay[r];
                                    <tr>
                                        <td class="num faint">@(r + 1)</td>
                                        @foreach (var v in row)
                                        {
                                            <td @ondblclick="() => CopyCell(v)" title="Double-click to copy cell value" style="cursor:pointer">
                                                @if (v is null) { <span class="null">NULL</span> } else { @Convert.ToString(v, System.Globalization.CultureInfo.InvariantCulture) }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (rs.Truncated) { <div class="alert warn" style="margin:10px 14px">Showing the first @rs.Rows.Count rows. The row limit for this database was reached.</div> }
                }
                else if (activeResult == -1)
                {
                    <div class="card-pad mono small">
                        @foreach (var m in last.Messages) { <div>@m</div> }
                        @if (last.Messages.Count == 0) { <span class="muted">No messages.</span> }
                    </div>
                }
                else if (activeResult == -2 && last.ExecutionPlan is not null)
                {
                    var plan = last.ExecutionPlan;
                    <div class="plan-container" style="padding:14px;overflow-y:auto;max-height:100%">
                        <div class="plan-summary-grid">
                            <div class="plan-metric">
                                <span class="plan-metric-label">Estimated Subtree Cost</span>
                                <span class="plan-metric-value">@plan.TotalCost.ToString("F4")</span>
                            </div>
                            <div class="plan-metric">
                                <span class="plan-metric-label">Optimization Level</span>
                                <span class="plan-metric-value">@plan.OptimizationLevel</span>
                            </div>
                            <div class="plan-metric">
                                <span class="plan-metric-label">Estimated Rows</span>
                                <span class="plan-metric-value">@plan.EstimatedRows.ToString("N0")</span>
                            </div>
                            <div class="plan-metric">
                                <span class="plan-metric-label">Operators</span>
                                <span class="plan-metric-value">@plan.Operators.Count</span>
                            </div>
                            @if (plan.CompileTimeMs > 0)
                            {
                                <div class="plan-metric">
                                    <span class="plan-metric-label">Compile Time</span>
                                    <span class="plan-metric-value">@plan.CompileTimeMs ms</span>
                                </div>
                            }
                        </div>

                        @if (plan.MissingIndexes.Count > 0)
                        {
                            <div class="plan-card" style="margin-top:14px">
                                <div class="row-inline" style="justify-content:space-between;margin-bottom:8px">
                                    <div class="row-inline" style="gap:8px">
                                        <span class="badge warn"><Icon Name="alert" />Missing Index Recommendation</span>
                                        <span class="muted small">SQL Server optimizer identified index improvement</span>
                                    </div>
                                </div>
                                @foreach (var mi in plan.MissingIndexes)
                                {
                                    <div style="background:var(--bg-sunken);border:1px solid var(--line);border-radius:var(--radius-sm);padding:10px 14px;margin-bottom:8px">
                                        <div class="row-inline" style="justify-content:space-between;margin-bottom:6px">
                                            <div>
                                                <b>@mi.Table</b>
                                                <span class="badge ok" style="margin-left:6px">+@mi.Impact% cost reduction</span>
                                            </div>
                                            <div class="row-inline" style="gap:6px">
                                                <button class="btn btn-sm" type="button" @onclick="() => CopyMissingIndex(mi.CreateIndexStatement)"><Icon Name="copy" />Copy Index Script</button>
                                                <button class="btn btn-sm btn-primary" type="button" @onclick="() => InsertMissingIndexToEditor(mi.CreateIndexStatement)"><Icon Name="code" />Add to Editor</button>
                                            </div>
                                        </div>
                                        <pre class="mono small" style="margin:0;padding:8px;background:var(--bg-elev);border-radius:4px;overflow-x:auto"><code>@mi.CreateIndexStatement</code></pre>
                                    </div>
                                }
                            </div>
                        }

                        <div class="plan-card" style="margin-top:14px">
                            <div class="row-inline" style="justify-content:space-between;margin-bottom:8px">
                                <h4 style="margin:0;font-size:13px;font-weight:700">Operator Breakdown (by Cost)</h4>
                                <div class="row-inline" style="gap:6px">
                                    <button class="btn btn-sm" type="button" @onclick="CopyPlanXml"><Icon Name="copy" />Copy Plan XML</button>
                                    <button class="btn btn-sm" type="button" @onclick="() => showRawPlanXml = !showRawPlanXml"><Icon Name="code" />@(showRawPlanXml ? "Hide XML" : "View Raw XML")</button>
                                </div>
                            </div>

                            @if (showRawPlanXml)
                            {
                                <pre class="mono small" style="max-height:240px;overflow:auto;padding:10px;background:var(--bg-sunken);border:1px solid var(--line);border-radius:var(--radius-sm);margin-bottom:12px"><code>@plan.RawXml</code></pre>
                            }

                            <div class="table-wrap">
                                <table>
                                    <thead>
                                        <tr>
                                            <th style="width:40px">Node</th>
                                            <th>Operator</th>
                                            <th>Target Object</th>
                                            <th class="num" style="width:90px">Est. Rows</th>
                                            <th class="num" style="width:110px">Cost (% of Total)</th>
                                            <th style="width:160px">% Subtree Cost</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var op in plan.Operators)
                                        {
                                            <tr>
                                                <td class="num faint">@op.NodeId</td>
                                                <td>
                                                    <div class="row-inline" style="gap:6px">
                                                        <b>@op.PhysicalOp</b>
                                                        @if (op.LogicalOp != op.PhysicalOp && !string.IsNullOrEmpty(op.LogicalOp))
                                                        {
                                                            <span class="faint small">(@op.LogicalOp)</span>
                                                        }
                                                        @if (op.IsScan)
                                                        {
                                                            <span class="badge warn" style="font-size:10px;padding:1px 5px" title="Full scan: consider adding index or selective predicate">SCAN</span>
                                                        }
                                                        @if (op.IsWarning && !op.IsScan)
                                                        {
                                                            <span class="badge bad" style="font-size:10px;padding:1px 5px" title="@op.WarningMessage">WARNING</span>
                                                        }
                                                    </div>
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(op.TargetObject))
                                                    {
                                                        <code>@op.TargetObject</code>
                                                    }
                                                    else
                                                    {
                                                        <span class="faint small">-</span>
                                                    }
                                                </td>
                                                <td class="num">@op.EstimatedRows.ToString("N0")</td>
                                                <td class="num">
                                                    <span>@op.OperatorCost.ToString("F4")</span>
                                                    <span class="faint small" style="margin-left:4px">(@op.CostPercentage%)</span>
                                                </td>
                                                <td>
                                                    <div class="plan-cost-bar">
                                                        <div class="plan-cost-fill @(op.CostPercentage >= 50 ? "cost-high" : op.CostPercentage >= 20 ? "cost-med" : "")" style="width:@(Math.Max(3, Math.Min(100, op.CostPercentage)))%"></div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </section>
</div>
}

