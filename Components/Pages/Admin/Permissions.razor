@page "/admin/permissions"
@attribute [Authorize(Roles = Roles.Admin)]
@inherits PageBase
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuditService AuditSvc
@inject IServiceScopeFactory Scopes
@inject AccessConfigurationService AccessConfig

<PageTitle>Permissions · Query Gate</PageTitle>

<div class="page-head"><div><h1>Permissions</h1><p>Role and user grants per database. User rules override role rules; deny wins.</p></div></div>

<div class="card card-pad" style="margin-bottom:16px">
    <div class="row-inline">
        <div class="grow"><h2>Roles</h2><p class="muted">New roles have standard user access and no database grants until you add them.</p></div>
        <button class="btn" @onclick="StartCreateRole"><Icon Name="plus" />Add role</button>
    </div>
    <div class="table-wrap"><table><thead><tr><th>Role</th><th>Audit and access matrix</th><th></th></tr></thead><tbody>
    @foreach (var role in roles)
    {
        <tr><td>@role.Name</td><td>@(IsAdminRole(role) ? "Admin" : auditRoleIds.Contains(role.Id) ? "Allowed" : "Not allowed")</td><td class="right">
            @if (!IsAdminRole(role)) { <button class="btn btn-sm" @onclick="() => EditRole(role)">Edit</button> <button class="btn btn-sm btn-danger" @onclick="() => ConfirmDeleteRole(role)">Delete</button> }
        </td></tr>
    }
    </tbody></table></div>
</div>
<div class="card card-pad" style="margin-bottom:16px">
    <div class="row-inline"><div class="grow"><h2>Environments</h2><p class="muted">Defaults apply only when registering a new database. Existing grants are unchanged.</p></div>
        <button class="btn" @onclick="NewEnvironment"><Icon Name="plus" />Add environment</button></div>
    <div class="table-wrap"><table><thead><tr><th>Environment</th><th></th></tr></thead><tbody>
    @foreach (var env in environments)
    {
        <tr><td>@env.Name</td><td class="right">
            <button class="btn btn-sm" @onclick="() => EditEnvironment(env)">Edit</button>
            <button class="btn btn-sm" @onclick="() => OpenDefaults(env)">Defaults</button>
            <button class="btn btn-sm btn-danger" @onclick="() => ConfirmDeleteEnvironment(env)">Delete</button>
        </td></tr>
    }
    </tbody></table></div>
</div>

<div class="toolbar flex-wrap" style="gap:14px;align-items:flex-end">
    <div class="field" style="margin:0">
        <label class="small muted">Environment</label>
        <select @bind="filterEnv" @bind:after="OnFilterEnvChanged" style="width:280px;min-width:280px">
            <option value="">Select environment…</option>
            @foreach (var env in environments) { <option value="@env.Name">@env.Name</option> }
        </select>
    </div>
    <div class="field field-gated" style="margin:0;cursor:@(!IsEnvSelected ? "pointer" : "default")" @onclick="OnDatabaseFieldClicked">
        <label class="small muted">Database</label>
        <div class="gated-control-wrap @(!IsEnvSelected ? "is-locked" : "")">
            <select @bind="dbId" @bind:after="OnFilterDbChanged" style="width:280px;min-width:280px" disabled="@(!IsEnvSelected)">
                <option value="@Guid.Empty">Select database…</option>
                @foreach (var d in FilteredDatabases) { <option value="@d.Id">@d.Name (@d.Environment)</option> }
            </select>
        </div>
    </div>
    <div class="field field-gated" style="margin:0;position:relative;cursor:@(!IsDbSelected ? "pointer" : "default")" @onclick="OnSubjectFieldClicked">
        <label class="small muted">Role / User</label>
        <div class="gated-control-wrap @(!IsDbSelected ? "is-locked" : "")">
            <div class="combobox-wrapper" style="width:280px;min-width:280px">
                <div class="combobox-input-wrap">
                    <input type="text"
                           class="combobox-input"
                           placeholder="Select or search role/user…"
                           @bind="subjectSearchText"
                           @bind:event="oninput"
                           @onfocus="OnSubjectFocus"
                           disabled="@(!IsDbSelected)"
                           style="padding-right:28px" />
                @if (!string.IsNullOrWhiteSpace(filterSubject))
                {
                    <button type="button" class="combobox-clear" @onclick="ClearSubject" title="Clear selection">×</button>
                }
                else
                {
                    <span class="combobox-caret" @onclick="ToggleSubjectDropdown">▾</span>
                }
            </div>
            @if (subjectDropdownOpen && IsDbSelected)
            {
                <div class="combobox-backdrop" @onclick="() => subjectDropdownOpen = false"></div>
                <div class="combobox-menu">
                    @{
                        var filteredRoles = roles.Where(r => string.IsNullOrWhiteSpace(subjectSearchText) || (r.Name != null && r.Name.Contains(subjectSearchText, StringComparison.OrdinalIgnoreCase))).ToList();
                        var filteredUsers = users.Where(u => string.IsNullOrWhiteSpace(subjectSearchText) || (u.Email != null && u.Email.Contains(subjectSearchText, StringComparison.OrdinalIgnoreCase))).ToList();
                    }
                    @if (filteredRoles.Count > 0)
                    {
                        <div class="combobox-group-title">Roles</div>
                        @foreach (var r in filteredRoles)
                        {
                            <div class="combobox-option @(filterSubject == "role:" + r.Id ? "selected" : "")"
                                 @onclick='() => SelectSubject($"role:{r.Id}", $"Role: {r.Name}")'>
                                <Icon Name="shield" />
                                <span>@r.Name</span>
                            </div>
                        }
                    }
                    @if (filteredUsers.Count > 0)
                    {
                        <div class="combobox-group-title">Users</div>
                        @foreach (var u in filteredUsers)
                        {
                            <div class="combobox-option @(filterSubject == "user:" + u.Id ? "selected" : "")"
                                 @onclick='() => SelectSubject($"user:{u.Id}", $"User: {u.Email}")'>
                                <Icon Name="user" />
                                <span>@u.Email</span>
                            </div>
                        }
                    }
                    @if (filteredRoles.Count == 0 && filteredUsers.Count == 0)
                    {
                        <div class="combobox-empty">No matching roles or users</div>
                    }
                </div>
            }
        </div>
        </div>
    </div>
    <div style="margin:0">
        <button class="btn btn-primary" @onclick="OpenAddGrant"><Icon Name="plus" />Add grant</button>
    </div>
</div>

<div class="card">
    @if (!IsEnvSelected)
    {
        <div class="empty">
            <Icon Name="filter" />
            <div>Select an environment to begin viewing and managing permissions.</div>
            <p class="small muted" style="margin-top:4px">Database and Role/User selections will become available once an environment is selected.</p>
        </div>
    }
    else if (!IsDbSelected)
    {
        <div class="empty">
            <Icon Name="filter" />
            <div>Select a database in <b>@filterEnv</b> to view permissions.</div>
            <p class="small muted" style="margin-top:4px">Database selection enables Role/User filtering and grant management.</p>
        </div>
    }
    else if (grants.Count == 0)
    {
        <div class="empty">
            <Icon Name="shield" />
            <div>No grants configured for <b>@GetDbName(dbId)</b>. Click "Add grant" to assign permissions.</div>
        </div>
    }
    else
    {
        <div class="table-wrap"><table>
            <thead><tr><th>Database</th><th>Subject</th><th>Permission</th><th>Effect</th><th>Window</th><th></th></tr></thead>
            <tbody>
            @foreach (var g in grants)
            {
                var isHigh = Perm.IsHighRisk(g.PermissionCode);
                <tr>
                    <td><b>@GetDbName(g.DatabaseId)</b> <span class="badge @EnvClass(GetDbEnv(g.DatabaseId))">@GetDbEnv(g.DatabaseId)</span></td>
                    <td>@Subject(g)</td>
                    <td>
                        @if (isHigh)
                        {
                            <div class="perm-highrisk-cell">
                                <span class="badge badge-highrisk" title="@Perm.HighRiskReason(g.PermissionCode)">
                                    <span style="margin-right:3px">⚠</span>@Perm.Label(g.PermissionCode)
                                </span>
                                <div class="highrisk-inline-reason">
                                    <Icon Name="alert" />
                                    <span>@Perm.HighRiskReason(g.PermissionCode)</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <span class="badge @(Perm.IsDangerous(g.PermissionCode) ? "warn" : "brand")">@Perm.Label(g.PermissionCode)</span>
                        }
                    </td>
                    <td><span class="badge @(g.Effect == PermissionEffect.Allow ? "ok" : "bad")">@g.Effect</span></td>
                    <td class="small muted">@(g.StartsAt is null && g.EndsAt is null ? "Always" : $"{Local(g.StartsAt)} → {Local(g.EndsAt)}")</td>
                    <td class="right"><button class="btn btn-sm btn-danger" @onclick="() => removingGrant = g">Remove</button></td>
                </tr>
            }
            </tbody>
        </table></div>
    }
</div>

@if (adding)
{
    <div class="modal-back"><div class="modal" style="max-width:680px">
        <div class="modal-head"><h2>Manage database grants</h2></div>
        <div class="modal-body">
            <div class="field"><label>Environment</label>
                <select @bind="modalEnv" @bind:after="OnModalEnvChanged">
                    @foreach (var env in environments) { <option value="@env.Name">@env.Name</option> }
                </select>
            </div>
            <div class="field"><label>Database</label>
                <select @bind="modalDbId" @bind:after="ReloadSelectedPermissions" disabled="@(ModalFilteredDatabases.Count == 0)">
                    @foreach (var d in ModalFilteredDatabases) { <option value="@d.Id">@d.Name</option> }
                </select>
            </div>
            <div class="field"><label>Applies to</label>
                <select @bind="kind" @bind:after="ReloadSelectedPermissions" disabled="@(modalDbId == Guid.Empty)"><option value="role">Role</option><option value="user">User</option></select></div>
            @if (kind == "role")
            {
                <div class="field"><label>Role</label><select @bind="roleId" @bind:after="ReloadSelectedPermissions" disabled="@(modalDbId == Guid.Empty)">@foreach (var r in roles) { <option value="@r.Id">@r.Name</option> }</select></div>
            }
            else
            {
                <div class="field"><label>User</label><select @bind="userId" @bind:after="ReloadSelectedPermissions" disabled="@(modalDbId == Guid.Empty)">@foreach (var u in users) { <option value="@u.Id">@u.Email</option> }</select></div>
            }
            @if (permissionsLoading)
            {
                <div class="alert info small"><span class="spinner"></span> Loading existing permissions…</div>
            }
            <fieldset class="perm-fieldset">
                <legend class="perm-legend">Standard Permissions</legend>
                <div class="check-grid" style="grid-template-columns:1fr 1fr;gap:8px">
                    @foreach (var c in Perm.Catalog.Where(x => !Perm.IsHighRisk(x)))
                    {
                        <label class="check" style="margin:0">
                            <input type="checkbox" checked="@selectedCodes.Contains(c)" @onchange="e => ToggleCode(c, (bool)e.Value!)" />
                            <span>@Perm.Label(c)</span>
                        </label>
                    }
                </div>
            </fieldset>

            <fieldset class="perm-fieldset perm-fieldset-highrisk">
                <legend class="perm-legend perm-legend-highrisk">
                    <span class="highrisk-icon-wrap"><Icon Name="alert" Style="width:14px;height:14px" /></span>
                    <span>High-Risk Permissions (Requires elevated trust)</span>
                </legend>
                <div style="display:flex;flex-direction:column;gap:8px">
                    @foreach (var c in Perm.Catalog.Where(x => Perm.IsHighRisk(x)))
                    {
                        <div class="perm-check-wrapper highrisk-card">
                            <label class="check check-highrisk" style="margin:0">
                                <input type="checkbox" checked="@selectedCodes.Contains(c)" @onchange="e => ToggleCode(c, (bool)e.Value!)" />
                                <span class="highrisk-text">@Perm.Label(c)</span>
                                <span class="badge badge-highrisk" style="margin-left:auto;font-size:10px;padding:1px 5px" title="@Perm.HighRiskReason(c)">High Risk</span>
                            </label>
                            <div class="highrisk-reason">
                                <span class="highrisk-icon-wrap"><Icon Name="alert" Style="width:13px;height:13px" /></span>
                                <span>@Perm.HighRiskReason(c)</span>
                            </div>
                        </div>
                    }
                </div>
            </fieldset>
            <div class="field"><label>Or system procedure (SYSPROC:name)</label><input type="text" @bind="customCode" placeholder="optional" /></div>
            <div class="field"><label>Effect</label>
                <select @bind="effect"><option value="@PermissionEffect.Allow">Allow</option><option value="@PermissionEffect.Deny">Deny</option></select></div>
            <div class="grid-2">
                <div class="field"><label>Starts (optional)</label><input type="datetime-local" @bind="starts" /></div>
                <div class="field"><label>Ends (optional)</label><input type="datetime-local" @bind="ends" /></div>
            </div>
        </div>
        <div class="modal-foot"><button class="btn" @onclick="() => adding = false">Cancel</button><button class="btn btn-primary" @onclick="Add">Save grants</button></div>
    </div></div>
}

@if (creatingRole)
{
    <div class="modal-back"><div class="modal">
        <div class="modal-head"><h2>Add role</h2></div>
        <div class="modal-body">
            <div class="field"><label for="new-role-name">Role name</label><input id="new-role-name" type="text" maxlength="256" @bind="newRoleName" /></div>
            @if (roleError is not null) { <div class="alert bad" role="alert">@roleError</div> }
        </div>
        <div class="modal-foot"><button class="btn" @onclick="CancelRole">Cancel</button><button class="btn btn-primary" @onclick="CreateRole">Create</button></div>
    </div></div>
}

@if (editingRole is not null)
{
    <div class="modal-back"><div class="modal">
        <div class="modal-head"><h2>Edit role</h2></div><div class="modal-body">
            <div class="field"><label for="edit-role-name">Role name</label><input id="edit-role-name" type="text" maxlength="256" @bind="editRoleName" /></div>
            <label class="check"><input type="checkbox" @bind="editRoleAudit" />Allow audit logs and access matrix</label>
            <p class="muted small">Renaming preserves users and database grants. Members may need to sign in again.</p>
            @if (roleError is not null) { <div class="alert bad" role="alert">@roleError</div> }
        </div><div class="modal-foot"><button class="btn" @onclick="() => editingRole = null">Cancel</button><button class="btn btn-primary" @onclick="SaveRole">Save</button></div>
    </div></div>
}
@if (environmentOpen)
{
    <div class="modal-back"><div class="modal">
        <div class="modal-head"><h2>@(editEnvironmentId is null ? "Add environment" : "Edit environment")</h2></div><div class="modal-body">
            <div class="field"><label for="environment-name">Environment name</label><input id="environment-name" type="text" maxlength="32" @bind="environmentName" /></div>
            <p class="muted small">Renaming updates associated databases and preserves their grants.</p>
            @if (environmentError is not null) { <div class="alert bad" role="alert">@environmentError</div> }
        </div><div class="modal-foot"><button class="btn" @onclick="() => environmentOpen = false">Cancel</button><button class="btn btn-primary" @onclick="SaveEnvironment">Save</button></div>
    </div></div>
}
@if (defaultsEnvironment is not null)
{
    <div class="modal-back"><div class="modal">
        <div class="modal-head"><h2>Defaults: @defaultsEnvironment.Name</h2></div><div class="modal-body">
            <p class="muted small">These allow grants apply only to newly registered databases.</p>
            <div class="field"><label for="defaults-role">Role</label><select id="defaults-role" @bind="defaultsRoleId" @bind:after="LoadDefaults">
                @foreach (var role in roles) { <option value="@role.Id">@role.Name</option> }
            </select></div>
            <div class="check-grid">@foreach (var code in Perm.Catalog) { <label class="check"><input type="checkbox" checked="@defaultCodes.Contains(code)" @onchange="e => ToggleDefault(code, (bool)e.Value!)" />@Perm.Label(code)</label> }</div>
            <div class="field"><label for="default-procedure">System procedure (SYSPROC:name)</label>
                <div class="row-inline"><input id="default-procedure" maxlength="128" @bind="defaultProcedure" /><button class="btn" @onclick="AddDefaultProcedure">Add</button></div></div>
            @foreach (var code in defaultCodes.Where(c => c.StartsWith(Perm.SysProcPrefix, StringComparison.OrdinalIgnoreCase)).OrderBy(c => c))
            {
                <div class="row-inline"><span>@(code)</span><button class="btn btn-sm" @onclick="() => defaultCodes.Remove(code)">Remove</button></div>
            }
            @if (defaultsError is not null) { <div class="alert bad" role="alert">@defaultsError</div> }
        </div><div class="modal-foot"><button class="btn" @onclick="() => defaultsEnvironment = null">Cancel</button><button class="btn btn-primary" @onclick="SaveDefaults">Save</button></div>
    </div></div>
}
<ConfirmDialog IsOpen="@(removingGrant is not null)"
               Title="Remove Permission Grant?"
               Message="@($"Are you sure you want to remove the {removingGrant?.Effect} {Perm.Label(removingGrant?.PermissionCode ?? "")} grant from {(removingGrant is null ? "" : Subject(removingGrant))}?")"
               Details="@($"Database: {GetDbName(removingGrant?.DatabaseId ?? Guid.Empty)}. This grant will be revoked immediately and affected users will lose access upon their next query.")"
               ConfirmText="Remove Grant"
               IsDanger="true"
               OnConfirm="ConfirmRemoveGrant"
               OnCancel="() => removingGrant = null" />

<ConfirmDialog IsOpen="@(deleteRole is not null || deleteEnvironment is not null)"
               Title="@(deleteRole is not null ? $"Delete Role '{deleteRole.Name}'?" : $"Delete Environment '{deleteEnvironment?.Name}'?")"
               Message="@(deleteRole is not null ? $"Are you sure you want to delete the role '{deleteRole.Name}'? Deletion will be blocked if users or dependent permissions are assigned." : $"Are you sure you want to delete the environment '{deleteEnvironment?.Name}'? Deletion will be blocked if any database targets belong to this environment.")"
               Details="@deleteError"
               ConfirmText="Delete"
               IsDanger="true"
               OnConfirm="DeleteSelected"
               OnCancel="CancelDelete" />

@code {
    private List<ManagedDatabase> dbs = [];
    private List<PermissionGrant> grants = [];
    private List<Microsoft.AspNetCore.Identity.IdentityRole> roles = [];
    private List<ApplicationUser> users = [];
    private Guid dbId = Guid.Empty;
    private string filterEnv = "";
    private string filterSubject = "";
    private string subjectSearchText = "";
    private bool subjectDropdownOpen;
    private Guid modalDbId = Guid.Empty;
    private string modalEnv = "";
    private bool adding;
    private bool permissionsLoading;
    private string kind = "role", roleId = "", userId = "", customCode = "";
    private HashSet<string> selectedCodes = [Perm.Select];
    private HashSet<string> initialExistingCodes = new(StringComparer.OrdinalIgnoreCase);
    private PermissionEffect effect = PermissionEffect.Allow;
    private DateTime? starts, ends;
    private bool creatingRole;
    private string newRoleName = "";
    private string? roleError;
    private List<DatabaseEnvironment> environments = [];
    private HashSet<string> auditRoleIds = [];
    private Microsoft.AspNetCore.Identity.IdentityRole? editingRole, deleteRole;
    private DatabaseEnvironment? defaultsEnvironment, deleteEnvironment;
    private PermissionGrant? removingGrant;
    private string editRoleName = "", environmentName = "", defaultsRoleId = "", defaultProcedure = "";
    private string? environmentError, defaultsError, deleteError;
    private bool editRoleAudit, environmentOpen;
    private Guid? editEnvironmentId;
    private HashSet<string> defaultCodes = new(StringComparer.OrdinalIgnoreCase);

    private bool IsEnvSelected => !string.IsNullOrWhiteSpace(filterEnv);
    private bool IsDbSelected => dbId != Guid.Empty;

    private IReadOnlyList<ManagedDatabase> FilteredDatabases =>
        string.IsNullOrWhiteSpace(filterEnv)
            ? []
            : dbs.Where(d => d.Environment.Equals(filterEnv, StringComparison.OrdinalIgnoreCase)).ToList();

    private IReadOnlyList<ManagedDatabase> ModalFilteredDatabases =>
        string.IsNullOrWhiteSpace(modalEnv)
            ? []
            : dbs.Where(d => d.Environment.Equals(modalEnv, StringComparison.OrdinalIgnoreCase)).ToList();

    private void OnDatabaseFieldClicked()
    {
        if (!IsEnvSelected)
        {
            Say("Please select an environment first before selecting a database.", true);
        }
    }

    private void OnSubjectFieldClicked()
    {
        if (!IsEnvSelected)
        {
            Say("Please select an environment first before selecting a role or user.", true);
        }
        else if (!IsDbSelected)
        {
            Say("Please select a database first before selecting a role or user.", true);
        }
    }

    private void OnSubjectFocus()
    {
        if (!IsDbSelected)
        {
            subjectDropdownOpen = false;
            if (!IsEnvSelected) Say("Please select an environment first before selecting a role or user.", true);
            else Say("Please select a database first before selecting a role or user.", true);
            return;
        }
        subjectDropdownOpen = true;
    }

    private void ToggleSubjectDropdown()
    {
        if (!IsDbSelected)
        {
            if (!IsEnvSelected) Say("Please select an environment first before selecting a role or user.", true);
            else Say("Please select a database first before selecting a role or user.", true);
            return;
        }
        subjectDropdownOpen = !subjectDropdownOpen;
    }

    private async Task OnFilterEnvChanged()
    {
        dbId = Guid.Empty;
        await ClearSubject();
        await Load();
    }

    private async Task OnFilterDbChanged()
    {
        await ClearSubject();
        await Load();
    }

    private async Task OnModalEnvChanged()
    {
        modalDbId = ModalFilteredDatabases.FirstOrDefault()?.Id ?? Guid.Empty;
        await ReloadSelectedPermissions();
    }

    private async Task SelectSubject(string value, string displayText)
    {
        filterSubject = value;
        subjectSearchText = displayText;
        subjectDropdownOpen = false;
        await Load();
    }

    private async Task ClearSubject()
    {
        filterSubject = "";
        subjectSearchText = "";
        subjectDropdownOpen = false;
        await Load();
    }

    private async Task RefreshConfiguration()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        roles = await db.Roles.AsNoTracking().OrderBy(r => r.Name).ToListAsync();
        environments = await db.DatabaseEnvironments.AsNoTracking().OrderBy(e => e.Name).ToListAsync();
        auditRoleIds = (await db.RoleClaims.Where(c => c.ClaimType == AccessConfigurationService.CapabilityClaim && c.ClaimValue == AccessConfigurationService.AuditCapability).Select(c => c.RoleId).ToListAsync()).ToHashSet();
        dbs = await db.ManagedDatabases.AsNoTracking().OrderBy(d => d.Name).ToListAsync();
        if (!roles.Any(r => r.Id == roleId)) roleId = roles.FirstOrDefault()?.Id ?? "";
    }
    private static bool IsAdminRole(Microsoft.AspNetCore.Identity.IdentityRole role) => string.Equals(role.Name, Roles.Admin, StringComparison.OrdinalIgnoreCase);
    private void EditRole(Microsoft.AspNetCore.Identity.IdentityRole role) { editingRole = role; editRoleName = role.Name ?? ""; editRoleAudit = auditRoleIds.Contains(role.Id); roleError = null; }
    private async Task SaveRole()
    {
        var result = await AccessConfig.SaveRoleAsync(Me, editingRole!.Id, editRoleName, editRoleAudit);
        if (!result.Ok) { roleError = result.Error; return; }
        editingRole = null; await RefreshConfiguration(); Say("Role updated.");
    }
    private void NewEnvironment() { editEnvironmentId = null; environmentName = ""; environmentError = null; environmentOpen = true; }
    private void EditEnvironment(DatabaseEnvironment e) { editEnvironmentId = e.Id; environmentName = e.Name; environmentError = null; environmentOpen = true; }
    private async Task SaveEnvironment()
    {
        var result = await AccessConfig.SaveEnvironmentAsync(Me, editEnvironmentId, environmentName);
        if (!result.Ok) { environmentError = result.Error; return; }
        environmentOpen = false; await RefreshConfiguration(); Say("Environment saved.");
    }
    private async Task OpenDefaults(DatabaseEnvironment e) { defaultsEnvironment = e; defaultsRoleId = roles.FirstOrDefault()?.Id ?? ""; defaultsError = null; defaultProcedure = ""; await LoadDefaults(); }
    private async Task LoadDefaults()
    {
        if (defaultsEnvironment is null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        defaultCodes = (await db.EnvironmentDefaultGrants.Where(g => g.EnvironmentId == defaultsEnvironment.Id && g.RoleId == defaultsRoleId).Select(g => g.PermissionCode).ToListAsync()).ToHashSet(StringComparer.OrdinalIgnoreCase);
    }
    private void ToggleDefault(string code, bool value) { if (value) defaultCodes.Add(code); else defaultCodes.Remove(code); }
    private void AddDefaultProcedure()
    {
        var code = defaultProcedure.Trim().ToUpperInvariant();
        if (!code.StartsWith(Perm.SysProcPrefix, StringComparison.Ordinal) || !Perm.IsValid(code) || code.Length > 128)
        {
            defaultsError = "Enter a valid system procedure permission in the form SYSPROC:name.";
            return;
        }
        defaultCodes.Add(code); defaultProcedure = ""; defaultsError = null;
    }
    private async Task SaveDefaults()
    {
        var result = await AccessConfig.SaveDefaultsAsync(Me, defaultsEnvironment!.Id, defaultsRoleId, defaultCodes);
        if (!result.Ok) { defaultsError = result.Error; return; }
        defaultsEnvironment = null; Say("Defaults saved for future registrations.");
    }
    private void ConfirmDeleteRole(Microsoft.AspNetCore.Identity.IdentityRole r) { deleteRole = r; deleteError = null; }
    private void ConfirmDeleteEnvironment(DatabaseEnvironment e) { deleteEnvironment = e; deleteError = null; }
    private void CancelDelete() { deleteRole = null; deleteEnvironment = null; deleteError = null; }
    private async Task DeleteSelected()
    {
        var result = deleteRole is not null ? await AccessConfig.DeleteRoleAsync(Me, deleteRole.Id) : await AccessConfig.DeleteEnvironmentAsync(Me, deleteEnvironment!.Id);
        if (!result.Ok) { deleteError = result.Error; return; }
        CancelDelete(); await RefreshConfiguration(); Say("Deleted.");
    }

    private void StartCreateRole() { newRoleName = ""; roleError = null; creatingRole = true; }
    private void CancelRole() { creatingRole = false; newRoleName = ""; roleError = null; }

    private async Task CreateRole()
    {
        var name = newRoleName.Trim();
        if (name.Length is 0 or > 256) { roleError = "Enter a role name of up to 256 characters."; return; }
        using var scope = Scopes.CreateScope();
        var manager = scope.ServiceProvider.GetRequiredService<Microsoft.AspNetCore.Identity.RoleManager<Microsoft.AspNetCore.Identity.IdentityRole>>();
        var result = await manager.CreateAsync(new Microsoft.AspNetCore.Identity.IdentityRole(name));
        if (!result.Succeeded) { roleError = string.Join(" ", result.Errors.Select(e => e.Description)); return; }
        await AuditSvc.TryWriteAsync(Me, "Permission", "RoleCreated", "Success", name);
        await RefreshConfiguration();
        CancelRole();
        Say("Role created. Add database grants before assigning access.");
    }

    protected override async Task OnLoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await RefreshConfiguration();
        users = await db.Users.AsNoTracking().OrderBy(u => u.Email).ToListAsync();
        roleId = roles.FirstOrDefault()?.Id ?? "";
        userId = users.FirstOrDefault()?.Id ?? "";
        filterEnv = "";
        dbId = Guid.Empty;
        filterSubject = "";
        subjectSearchText = "";
        grants = [];
    }

    private async Task Load()
    {
        if (string.IsNullOrWhiteSpace(filterEnv) && dbId == Guid.Empty && string.IsNullOrWhiteSpace(filterSubject))
        {
            grants = [];
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var q = db.PermissionGrants.AsNoTracking().AsQueryable();

        if (dbId != Guid.Empty)
        {
            q = q.Where(g => g.DatabaseId == dbId);
        }
        else if (!string.IsNullOrWhiteSpace(filterEnv))
        {
            var envDbIds = dbs.Where(d => d.Environment.Equals(filterEnv, StringComparison.OrdinalIgnoreCase)).Select(d => d.Id).ToList();
            q = q.Where(g => envDbIds.Contains(g.DatabaseId));
        }

        if (!string.IsNullOrWhiteSpace(filterSubject))
        {
            if (filterSubject.StartsWith("role:", StringComparison.OrdinalIgnoreCase))
            {
                var targetRoleId = filterSubject["role:".Length..];
                q = q.Where(g => g.RoleId == targetRoleId);
            }
            else if (filterSubject.StartsWith("user:", StringComparison.OrdinalIgnoreCase))
            {
                var targetUserId = filterSubject["user:".Length..];
                q = q.Where(g => g.UserId == targetUserId);
            }
        }

        grants = await q.OrderBy(g => g.DatabaseId)
                        .ThenBy(g => g.UserId == null ? 0 : 1)
                        .ThenBy(g => g.PermissionCode)
                        .ToListAsync();
    }

    private string Subject(PermissionGrant g) => g.UserId is not null
        ? "User: " + (users.FirstOrDefault(u => u.Id == g.UserId)?.Email ?? "unknown")
        : "Role: " + (roles.FirstOrDefault(r => r.Id == g.RoleId)?.Name ?? "unknown");

    private string GetDbName(Guid id) => dbs.FirstOrDefault(d => d.Id == id)?.Name ?? "Database";
    private string GetDbEnv(Guid id) => dbs.FirstOrDefault(d => d.Id == id)?.Environment ?? "";

    private void ToggleCode(string permission, bool on)
    {
        if (on) selectedCodes.Add(permission);
        else selectedCodes.Remove(permission);
    }

    private async Task OpenAddGrant()
    {
        if (!IsEnvSelected)
        {
            Say("Please select an environment first before adding grants.", true);
            return;
        }
        if (!IsDbSelected)
        {
            Say("Please select a database first before adding grants.", true);
            return;
        }

        modalEnv = filterEnv;
        modalDbId = dbId;

        if (!string.IsNullOrWhiteSpace(filterSubject))
        {
            if (filterSubject.StartsWith("role:", StringComparison.OrdinalIgnoreCase))
            {
                kind = "role";
                roleId = filterSubject["role:".Length..];
            }
            else if (filterSubject.StartsWith("user:", StringComparison.OrdinalIgnoreCase))
            {
                kind = "user";
                userId = filterSubject["user:".Length..];
            }
        }
        else
        {
            if (string.IsNullOrWhiteSpace(roleId)) roleId = roles.FirstOrDefault()?.Id ?? "";
            if (string.IsNullOrWhiteSpace(userId)) userId = users.FirstOrDefault()?.Id ?? "";
        }

        adding = true;
        customCode = "";
        starts = null;
        ends = null;
        await ReloadSelectedPermissions();
    }

    private async Task ReloadSelectedPermissions()
    {
        if (!adding || modalDbId == Guid.Empty) return;

        permissionsLoading = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var q = db.PermissionGrants.AsNoTracking().Where(g => g.DatabaseId == modalDbId);
            if (kind == "role") q = q.Where(g => g.RoleId == roleId);
            else q = q.Where(g => g.UserId == userId);

            var existingGrants = await q.ToListAsync();
            initialExistingCodes = existingGrants.Select(g => g.PermissionCode).ToHashSet(StringComparer.OrdinalIgnoreCase);
            selectedCodes = new HashSet<string>(initialExistingCodes, StringComparer.OrdinalIgnoreCase);

            if (existingGrants.Count > 0)
            {
                effect = existingGrants[0].Effect;
                starts = existingGrants[0].StartsAt?.LocalDateTime;
                ends = existingGrants[0].EndsAt?.LocalDateTime;
            }
            else
            {
                selectedCodes = [Perm.Select];
                effect = PermissionEffect.Allow;
                starts = null;
                ends = null;
            }
        }
        finally { permissionsLoading = false; }
    }

    private async Task Add()
    {
        try
        {
            if (modalDbId == Guid.Empty)
            {
                Say("Please select a database.", true);
                return;
            }

            if (kind == "role")
            {
                if ((string.IsNullOrWhiteSpace(roleId) || !roles.Any(r => r.Id == roleId)) && roles.Count > 0)
                {
                    roleId = roles[0].Id;
                }
                if (string.IsNullOrWhiteSpace(roleId))
                {
                    Say("Please select a role.", true);
                    return;
                }
            }
            else
            {
                if ((string.IsNullOrWhiteSpace(userId) || !users.Any(u => u.Id == userId)) && users.Count > 0)
                {
                    userId = users[0].Id;
                }
                if (string.IsNullOrWhiteSpace(userId))
                {
                    Say("Please select a user.", true);
                    return;
                }
            }

            var finalCodes = selectedCodes.Select(Perm.Normalize).ToList();
            if (!string.IsNullOrWhiteSpace(customCode))
            {
                var trimmed = customCode.Trim();
                var normalized = trimmed.StartsWith(Perm.SysProcPrefix, StringComparison.OrdinalIgnoreCase)
                    ? trimmed.ToUpperInvariant()
                    : Perm.SysProcPrefix + trimmed.ToUpperInvariant();
                finalCodes.Add(normalized);
            }
            finalCodes = finalCodes.Distinct(StringComparer.OrdinalIgnoreCase).ToList();

            if (finalCodes.Count == 0 && initialExistingCodes.Count == 0)
            {
                Say("Please select at least one permission.", true);
                return;
            }

            if (finalCodes.Any(c => !Perm.IsValid(c)))
            {
                Say("Invalid permission code.", true);
                return;
            }

            if (starts is not null && ends is not null && ends <= starts)
            {
                Say("End time must be after start time.", true);
                return;
            }

            var rId = kind == "role" ? roleId : null;
            var uId = kind == "user" ? userId : null;

            var result = await AccessConfig.SaveGrantsAsync(Me, modalDbId, rId, uId, finalCodes, initialExistingCodes, effect, starts, ends);
            if (!result.Ok)
            {
                Say(result.Error ?? "Failed to save grants.", true);
                return;
            }

            var counts = (result.Value ?? "0:0:0").Split(':');
            var added = counts.Length > 0 ? counts[0] : "0";
            var updated = counts.Length > 1 ? counts[1] : "0";
            var removed = counts.Length > 2 ? counts[2] : "0";

            adding = false;
            customCode = "";
            selectedCodes = [Perm.Select];
            initialExistingCodes.Clear();

            // Synchronize the main page filters to the modified database & subject so changes are immediately visible
            var targetDb = dbs.FirstOrDefault(d => d.Id == modalDbId);
            if (targetDb != null)
            {
                filterEnv = targetDb.Environment;
                dbId = modalDbId;
                if (rId != null)
                {
                    filterSubject = "role:" + rId;
                    var rName = roles.FirstOrDefault(r => r.Id == rId)?.Name ?? "Role";
                    subjectSearchText = $"Role: {rName}";
                }
                else if (uId != null)
                {
                    filterSubject = "user:" + uId;
                    var uEmail = users.FirstOrDefault(u => u.Id == uId)?.Email ?? "User";
                    subjectSearchText = $"User: {uEmail}";
                }
            }

            Say($"Saved grants: {added} added, {updated} updated, {removed} removed.");
            await Load();
        }
        catch (Exception ex)
        {
            Say($"Failed to save grants: {ex.Message}", true);
        }
    }

    private async Task ConfirmRemoveGrant()
    {
        if (removingGrant is null) return;
        var g = removingGrant;
        removingGrant = null;
        await Remove(g);
    }

    private async Task Remove(PermissionGrant g)
    {
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            await db.PermissionGrants.Where(x => x.Id == g.Id).ExecuteDeleteAsync();
        }
        await AuditSvc.TryWriteAsync(Me, "Permission", "GrantRemoved", "Success", $"{g.Effect} {g.PermissionCode} from {Subject(g)}", g.DatabaseId, GetDbName(g.DatabaseId));
        Say("Grant removed.");
        await Load();
    }
}
