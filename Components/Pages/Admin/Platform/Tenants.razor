@page "/platform/tenants"
@attribute [Authorize(Roles = Roles.SuperAdmin)]
@inherits PageBase
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject PlatformAdminService PlatformAdmin

<PageTitle>Platform Workspaces · Query Gate</PageTitle>

<div class="admin-page">
    <div class="page-head">
        <div>
            <h1>Platform Workspaces</h1>
            <p>Manage multi-tenant organizations, custom domains, quotas, and workspace administrators.</p>
        </div>
        <div class="actions">
            <a class="btn" href="/platform/operators"><Icon Name="shield" />Operators</a>
            <button class="btn btn-primary" type="button" @onclick="OpenCreateModal">
                <Icon Name="plus" />Create Workspace
            </button>
        </div>
    </div>

    @if (memberTempPassword is not null)
    {
        <div class="alert info">
            <b>Temporary password for @memberTempPasswordFor</b>, shown once. The user must change it at first sign-in.
            <div class="secret" style="margin-top:8px">@memberTempPassword</div>
            <button class="btn btn-sm" style="margin-top:8px" type="button" @onclick="() => memberTempPassword = null">Dismiss</button>
        </div>
    }

    <div class="toolbar" style="gap:10px;flex-wrap:wrap">
        <input type="search" style="flex:1;min-width:220px" placeholder="Search by name, slug, or contact email..." @bind="searchQuery" @bind:event="oninput" />
        <select @bind="statusFilter">
            <option value="All">All statuses</option>
            <option value="Active">Active only</option>
            <option value="Inactive">Inactive only</option>
        </select>
    </div>

    @if (loading)
    {
        <div class="card"><div class="empty"><span class="spinner"></span><div>Loading workspaces...</div></div></div>
    }
    else if (filteredTenants.Count == 0)
    {
        <div class="card">
            <div class="empty">
                <Icon Name="db" />
                <div>No workspaces found</div>
                <div class="small muted">Create a tenant workspace to get started.</div>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Workspace</th>
                            <th>Slug / Path</th>
                            <th>Custom Domains</th>
                            <th>Databases</th>
                            <th>Members</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th class="right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in filteredTenants)
                        {
                            var t = item.Tenant;
                            <tr>
                                <td>
                                    <div style="font-weight:600">@t.Name</div>
                                    @if (!string.IsNullOrEmpty(t.ContactEmail))
                                    {
                                        <div class="small muted">@t.ContactEmail</div>
                                    }
                                    @if (!string.IsNullOrEmpty(t.Plan))
                                    {
                                        <span class="badge" style="font-size:10px;margin-top:3px">@t.Plan</span>
                                    }
                                </td>
                                <td>
                                    <code style="font-size:12px;padding:2px 6px;background:var(--brand-soft);color:var(--brand-ink);border-radius:4px">/t/@t.Slug</code>
                                </td>
                                <td>
                                    @if (item.Domains.Count == 0)
                                    {
                                        <span class="small muted">None</span>
                                    }
                                    else
                                    {
                                        @foreach (var d in item.Domains)
                                        {
                                            <span class="badge" style="display:inline-block;margin:2px 4px 2px 0;font-size:11px">@d.Domain</span>
                                        }
                                    }
                                </td>
                                <td>
                                    @item.DatabaseCount
                                    <span class="small muted">/ @(t.MaxDatabases?.ToString() ?? "∞")</span>
                                </td>
                                <td>
                                    @item.UserCount
                                    <span class="small muted">/ @(t.MaxUsers?.ToString() ?? "∞")</span>
                                </td>
                                <td>
                                    <span class="badge @(t.IsActive ? "ok" : "bad")">@(t.IsActive ? "Active" : "Disabled")</span>
                                </td>
                                <td class="small muted nowrap">@t.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td class="right nowrap">
                                    <div style="display:inline-flex;gap:6px">
                                        <a class="btn btn-sm" href="/t/@t.Slug/dashboard" target="_blank" rel="external" title="Open workspace in new tab">Open</a>
                                        <button class="btn btn-sm" type="button" @onclick="() => OpenMembersModal(t)">Members</button>
                                        <button class="btn btn-sm" type="button" @onclick="() => OpenDomainsModal(t)">Domains</button>
                                        <button class="btn btn-sm" type="button" @onclick="() => OpenEditModal(t)">Edit</button>
                                        <button class="btn btn-sm @(t.IsActive ? "btn-danger" : "btn-primary")" type="button" @onclick="() => ToggleActiveAsync(t)">
                                            @(t.IsActive ? "Disable" : "Enable")
                                        </button>
                                        @if (!t.IsActive && !string.Equals(t.Slug, "default", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <button class="btn btn-sm btn-danger" type="button" @onclick="() => OpenDeleteModal(t)">Delete</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@if (showCreateModal)
{
    <div class="modal-back">
        <div class="modal" style="max-width:540px">
            <div class="modal-head">
                <h2>Create New Workspace</h2>
                <button class="icon-btn" type="button" @onclick="() => showCreateModal = false"><Icon Name="x" /></button>
            </div>
            <div class="modal-body stack" style="gap:12px">
                <div class="field">
                    <label>Workspace Name *</label>
                    <input type="text" @bind="newTenantName" @bind:after="OnNewNameChanged" placeholder="e.g. Acme Corporation" />
                </div>
                <div class="field">
                    <label>Slug (URL path prefix) *</label>
                    <div style="display:flex;align-items:center;gap:6px">
                        <span class="small muted">/t/</span>
                        <input type="text" @bind="newTenantSlug" placeholder="acme" />
                    </div>
                    <span class="small muted">Lowercase letters, numbers, and hyphens only.</span>
                </div>
                <div class="grid g2" style="gap:10px">
                    <div class="field">
                        <label>Contact Email</label>
                        <input type="email" @bind="newTenantEmail" placeholder="admin@acme.com" />
                    </div>
                    <div class="field">
                        <label>Plan</label>
                        <input type="text" @bind="newTenantPlan" placeholder="Enterprise, Pro, Standard..." />
                    </div>
                </div>
                <div class="grid g2" style="gap:10px">
                    <div class="field">
                        <label>Max Databases (blank = unlimited)</label>
                        <input type="number" min="1" @bind="newMaxDatabases" placeholder="Unlimited" />
                    </div>
                    <div class="field">
                        <label>Max Users (blank = unlimited)</label>
                        <input type="number" min="1" @bind="newMaxUsers" placeholder="Unlimited" />
                    </div>
                </div>
                <div class="field" style="border-top:1px solid var(--line);padding-top:12px">
                    <label>Initial Administrator Email (optional)</label>
                    <input type="email" @bind="newAdminEmail" placeholder="admin@acme.com" />
                    <span class="small muted">Existing accounts receive immediate Admin access. You can also assign members afterwards.</span>
                </div>
            </div>
            <div class="modal-foot">
                <button class="btn" type="button" @onclick="() => showCreateModal = false">Cancel</button>
                <button class="btn btn-primary" type="button" @onclick="CreateTenantAsync" disabled="@saving">
                    @(saving ? "Creating..." : "Create Workspace")
                </button>
            </div>
        </div>
    </div>
}

@if (showEditModal && editingTenant is not null)
{
    <div class="modal-back">
        <div class="modal" style="max-width:500px">
            <div class="modal-head">
                <h2>Edit Workspace</h2>
                <button class="icon-btn" type="button" @onclick="() => showEditModal = false"><Icon Name="x" /></button>
            </div>
            <div class="modal-body stack" style="gap:12px">
                <div class="field">
                    <label>Workspace Name *</label>
                    <input type="text" @bind="editingTenant.Name" />
                </div>
                <div class="field">
                    <label>Slug</label>
                    <input type="text" value="@editingTenant.Slug" disabled />
                    <span class="small muted">Slugs cannot be changed once created.</span>
                </div>
                <div class="grid g2" style="gap:10px">
                    <div class="field">
                        <label>Contact Email</label>
                        <input type="email" @bind="editingTenant.ContactEmail" />
                    </div>
                    <div class="field">
                        <label>Plan</label>
                        <input type="text" @bind="editingTenant.Plan" />
                    </div>
                </div>
                <div class="grid g2" style="gap:10px">
                    <div class="field">
                        <label>Max Databases (blank = unlimited)</label>
                        <input type="number" min="1" @bind="editingTenant.MaxDatabases" placeholder="Unlimited" />
                    </div>
                    <div class="field">
                        <label>Max Users (blank = unlimited)</label>
                        <input type="number" min="1" @bind="editingTenant.MaxUsers" placeholder="Unlimited" />
                    </div>
                </div>
            </div>
            <div class="modal-foot">
                <button class="btn" type="button" @onclick="() => showEditModal = false">Cancel</button>
                <button class="btn btn-primary" type="button" @onclick="SaveEditAsync" disabled="@saving">
                    @(saving ? "Saving..." : "Save Changes")
                </button>
            </div>
        </div>
    </div>
}

@if (showDomainsModal && selectedTenantForDomains is not null)
{
    <div class="modal-back">
        <div class="modal" style="max-width:540px">
            <div class="modal-head">
                <h2>Custom Domains: @selectedTenantForDomains.Name</h2>
                <button class="icon-btn" type="button" @onclick="() => showDomainsModal = false"><Icon Name="x" /></button>
            </div>
            <div class="modal-body stack" style="gap:14px">
                <p class="small muted" style="margin:0">
                    Connect custom hostnames directly to this workspace. Point your DNS CNAME or A record to this server.
                </p>

                <div style="display:flex;gap:8px">
                    <input type="text" style="flex:1" placeholder="e.g. sql.acme.com" @bind="newDomainInput" />
                    <button class="btn btn-primary" type="button" @onclick="AddDomainAsync" disabled="@string.IsNullOrWhiteSpace(newDomainInput)">
                        Add Domain
                    </button>
                </div>

                <div>
                    <div class="small" style="font-weight:600;margin-bottom:8px">Configured Domains</div>
                    @if (currentTenantDomains.Count == 0)
                    {
                        <div class="small muted" style="padding:12px;background:var(--bg);border-radius:6px">
                            No custom domains configured. Workspace is accessible via <code>/t/@selectedTenantForDomains.Slug</code>.
                        </div>
                    }
                    else
                    {
                        <div class="stack" style="gap:8px">
                            @foreach (var d in currentTenantDomains)
                            {
                                <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 12px;background:var(--bg);border-radius:6px">
                                    <div>
                                        <div style="font-weight:600;font-size:13px">@d.Domain</div>
                                        <div class="small muted">Added @Local(d.CreatedAt)</div>
                                    </div>
                                    <button class="btn btn-sm btn-danger" type="button" @onclick="() => RemoveDomainAsync(d.Id)">Remove</button>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="modal-foot">
                <button class="btn" type="button" @onclick="() => showDomainsModal = false">Close</button>
            </div>
        </div>
    </div>
}

@if (showMembersModal && selectedTenantForMembers is not null)
{
    <div class="modal-back">
        <div class="modal" style="max-width:660px">
            <div class="modal-head">
                <h2>Members: @selectedTenantForMembers.Name</h2>
                <button class="icon-btn" type="button" @onclick="() => showMembersModal = false"><Icon Name="x" /></button>
            </div>
            <div class="modal-body stack" style="gap:14px">
                <div style="display:flex;gap:8px;flex-wrap:wrap">
                    <input type="email" style="flex:1;min-width:200px" placeholder="user@company.com" @bind="newMemberEmail" />
                    <select @bind="newMemberRole" style="min-width:130px">
                        @foreach (var r in workspaceRoles)
                        {
                            <option value="@r">@r</option>
                        }
                    </select>
                    <button class="btn btn-primary" type="button" disabled="@(saving || string.IsNullOrWhiteSpace(newMemberEmail))" @onclick="AssignMemberAsync">
                        Assign / Invite
                    </button>
                </div>

                <div class="table-wrap" style="max-height:320px;overflow-y:auto">
                    <table>
                        <thead>
                            <tr><th>User</th><th>Workspace Role</th><th>Status</th><th class="right"></th></tr>
                        </thead>
                        <tbody>
                            @if (currentMembers.Count == 0)
                            {
                                <tr><td colspan="4" class="small muted">No explicit members assigned yet. SuperAdmins have implicit Admin access.</td></tr>
                            }
                            else
                            {
                                @foreach (var m in currentMembers)
                                {
                                    <tr>
                                        <td>
                                            <b>@(m.DisplayName ?? m.Email)</b>
                                            @if (m.IsSuperAdmin)
                                            {
                                                <span class="badge brand" style="margin-left:6px;font-size:10px">SuperAdmin</span>
                                            }
                                            <div class="small muted">@m.Email</div>
                                        </td>
                                        <td><span class="badge">@m.WorkspaceRole</span></td>
                                        <td><span class="badge @(m.IsActive ? "ok" : "bad")">@(m.IsActive ? "Active" : "Inactive")</span></td>
                                        <td class="right">
                                            <button class="btn btn-sm btn-danger" type="button" @onclick="() => RemoveMemberAsync(m.UserId)">Remove</button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-foot">
                <button class="btn" type="button" @onclick="() => showMembersModal = false">Close</button>
            </div>
        </div>
    </div>
}

@if (deletingTenant is not null)
{
    <div class="modal-back">
        <div class="modal" style="max-width:480px">
            <div class="modal-head">
                <h2>Delete Workspace '@deletingTenant.Name'?</h2>
                <button class="icon-btn" type="button" @onclick="() => deletingTenant = null"><Icon Name="x" /></button>
            </div>
            <div class="modal-body stack" style="gap:12px">
                <div class="alert bad">
                    This permanently deletes the workspace, its databases, permissions, saved queries, query history, and settings. Audit logs are retained for compliance.
                </div>
                <div class="field">
                    <label>Type <code>@deletingTenant.Slug</code> to confirm deletion</label>
                    <input type="text" @bind="deleteConfirmSlug" placeholder="@deletingTenant.Slug" />
                </div>
            </div>
            <div class="modal-foot">
                <button class="btn" type="button" @onclick="() => deletingTenant = null">Cancel</button>
                <button class="btn btn-danger"
                        type="button"
                        disabled="@(saving || !string.Equals(deleteConfirmSlug.Trim(), deletingTenant.Slug, StringComparison.OrdinalIgnoreCase))"
                        @onclick="ConfirmDeleteAsync">
                    Delete Workspace
                </button>
            </div>
        </div>
    </div>
}

@code {
    private sealed class TenantSummary
    {
        public Tenant Tenant { get; set; } = default!;
        public List<TenantDomain> Domains { get; set; } = [];
        public int DatabaseCount { get; set; }
        public int UserCount { get; set; }
    }

    private List<TenantSummary> allTenants = [];
    private List<string> workspaceRoles = [];
    private bool loading = true;
    private bool saving;
    private string searchQuery = "";
    private string statusFilter = "All";

    private bool showCreateModal;
    private string newTenantName = "", newTenantSlug = "", newTenantEmail = "", newTenantPlan = "Standard", newAdminEmail = "";
    private int? newMaxDatabases, newMaxUsers;

    private bool showEditModal;
    private Tenant? editingTenant;

    private bool showDomainsModal;
    private Tenant? selectedTenantForDomains;
    private List<TenantDomain> currentTenantDomains = [];
    private string newDomainInput = "";

    private bool showMembersModal;
    private Tenant? selectedTenantForMembers;
    private List<WorkspaceMemberInfo> currentMembers = [];
    private string newMemberEmail = "", newMemberRole = Roles.Admin;
    private string? memberTempPassword, memberTempPasswordFor;

    private Tenant? deletingTenant;
    private string deleteConfirmSlug = "";

    protected override async Task OnLoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        workspaceRoles = await db.Roles.AsNoTracking()
            .Where(r => r.Name != null && r.Name != Roles.SuperAdmin)
            .Select(r => r.Name!)
            .OrderBy(r => r)
            .ToListAsync();
        if (!workspaceRoles.Contains(newMemberRole))
            newMemberRole = workspaceRoles.FirstOrDefault() ?? Roles.Admin;

        await LoadTenantsAsync();
    }

    private async Task LoadTenantsAsync()
    {
        loading = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var tenants = await db.Tenants.IgnoreQueryFilters().OrderByDescending(t => t.CreatedAt).ToListAsync();
            var domains = await db.TenantDomains.IgnoreQueryFilters().ToListAsync();
            var dbCounts = await db.ManagedDatabases.IgnoreQueryFilters()
                .GroupBy(d => d.TenantId)
                .Select(g => new { TenantId = g.Key, Count = g.Count() })
                .ToDictionaryAsync(x => x.TenantId, x => x.Count);
            var userCounts = await db.UserTenantMemberships.IgnoreQueryFilters()
                .GroupBy(m => m.TenantId)
                .Select(g => new { TenantId = g.Key, Count = g.Count() })
                .ToDictionaryAsync(x => x.TenantId, x => x.Count);

            allTenants = tenants.Select(t => new TenantSummary
            {
                Tenant = t,
                Domains = domains.Where(d => d.TenantId == t.Id).ToList(),
                DatabaseCount = dbCounts.GetValueOrDefault(t.Id, 0),
                UserCount = userCounts.GetValueOrDefault(t.Id, 0)
            }).ToList();
        }
        finally
        {
            loading = false;
        }
    }

    private List<TenantSummary> filteredTenants => allTenants
        .Where(item =>
        {
            if (statusFilter == "Active" && !item.Tenant.IsActive) return false;
            if (statusFilter == "Inactive" && item.Tenant.IsActive) return false;
            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var q = searchQuery.Trim();
                return item.Tenant.Name.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || item.Tenant.Slug.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || (item.Tenant.ContactEmail?.Contains(q, StringComparison.OrdinalIgnoreCase) == true);
            }
            return true;
        })
        .ToList();

    private void OpenCreateModal()
    {
        newTenantName = newTenantSlug = newTenantEmail = newAdminEmail = "";
        newTenantPlan = "Standard";
        newMaxDatabases = newMaxUsers = null;
        showCreateModal = true;
    }

    private void OnNewNameChanged()
    {
        if (string.IsNullOrWhiteSpace(newTenantSlug) && !string.IsNullOrWhiteSpace(newTenantName))
        {
            newTenantSlug = System.Text.RegularExpressions.Regex.Replace(newTenantName.ToLowerInvariant(), @"[^a-z0-9]+", "-").Trim('-');
        }
    }

    private async Task CreateTenantAsync()
    {
        saving = true;
        try
        {
            var res = await PlatformAdmin.CreateWorkspaceAsync(
                Me, newTenantName, newTenantSlug, newTenantEmail, newTenantPlan, newMaxDatabases, newMaxUsers, newAdminEmail);
            var successMsg = string.IsNullOrEmpty(res.Value) ? "Workspace created." : $"Workspace created. {res.Value}";
            Say(res, successMsg);
            if (res.Ok)
            {
                showCreateModal = false;
                await LoadTenantsAsync();
            }
        }
        finally
        {
            saving = false;
        }
    }

    private void OpenEditModal(Tenant tenant)
    {
        editingTenant = new Tenant
        {
            Id = tenant.Id,
            Name = tenant.Name,
            Slug = tenant.Slug,
            ContactEmail = tenant.ContactEmail,
            Plan = tenant.Plan,
            MaxDatabases = tenant.MaxDatabases,
            MaxUsers = tenant.MaxUsers,
            IsActive = tenant.IsActive,
            CreatedAt = tenant.CreatedAt
        };
        showEditModal = true;
    }

    private async Task SaveEditAsync()
    {
        if (editingTenant is null) return;
        saving = true;
        try
        {
            var res = await PlatformAdmin.UpdateWorkspaceAsync(
                Me,
                editingTenant.Id,
                editingTenant.Name,
                editingTenant.ContactEmail,
                editingTenant.Plan,
                editingTenant.MaxDatabases,
                editingTenant.MaxUsers);
            Say(res, "Workspace updated.");
            if (res.Ok)
            {
                showEditModal = false;
                await LoadTenantsAsync();
            }
        }
        finally
        {
            saving = false;
        }
    }

    private async Task ToggleActiveAsync(Tenant tenant)
    {
        var res = await PlatformAdmin.ToggleWorkspaceActiveAsync(Me, tenant.Id);
        Say(res, $"Workspace {res.Value ?? "updated"}.");
        if (res.Ok) await LoadTenantsAsync();
    }

    private async Task OpenDomainsModal(Tenant tenant)
    {
        selectedTenantForDomains = tenant;
        newDomainInput = "";
        await using var db = await DbFactory.CreateDbContextAsync();
        currentTenantDomains = await db.TenantDomains.IgnoreQueryFilters().Where(d => d.TenantId == tenant.Id).ToListAsync();
        showDomainsModal = true;
    }

    private async Task AddDomainAsync()
    {
        if (selectedTenantForDomains is null) return;
        var res = await PlatformAdmin.AddDomainAsync(Me, selectedTenantForDomains.Id, newDomainInput);
        Say(res, "Custom domain connected.");
        if (res.Ok)
        {
            newDomainInput = "";
            await using var db = await DbFactory.CreateDbContextAsync();
            currentTenantDomains = await db.TenantDomains.IgnoreQueryFilters().Where(d => d.TenantId == selectedTenantForDomains.Id).ToListAsync();
            await LoadTenantsAsync();
        }
    }

    private async Task RemoveDomainAsync(Guid domainId)
    {
        if (selectedTenantForDomains is null) return;
        var res = await PlatformAdmin.RemoveDomainAsync(Me, selectedTenantForDomains.Id, domainId);
        Say(res, "Domain removed.");
        if (res.Ok)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            currentTenantDomains = await db.TenantDomains.IgnoreQueryFilters().Where(d => d.TenantId == selectedTenantForDomains.Id).ToListAsync();
            await LoadTenantsAsync();
        }
    }

    private async Task OpenMembersModal(Tenant tenant)
    {
        selectedTenantForMembers = tenant;
        newMemberEmail = "";
        currentMembers = await PlatformAdmin.ListWorkspaceMembersAsync(tenant.Id);
        showMembersModal = true;
    }

    private async Task AssignMemberAsync()
    {
        if (selectedTenantForMembers is null) return;
        saving = true;
        try
        {
            var res = await PlatformAdmin.AssignWorkspaceMemberAsync(Me, selectedTenantForMembers.Id, newMemberEmail, newMemberRole);
            Say(res, $"Member assigned as {newMemberRole}.");
            if (res.Ok)
            {
                if (!string.IsNullOrEmpty(res.Value))
                {
                    memberTempPassword = res.Value;
                    memberTempPasswordFor = newMemberEmail.Trim();
                }
                newMemberEmail = "";
                currentMembers = await PlatformAdmin.ListWorkspaceMembersAsync(selectedTenantForMembers.Id);
                await LoadTenantsAsync();
            }
        }
        finally
        {
            saving = false;
        }
    }

    private async Task RemoveMemberAsync(string userId)
    {
        if (selectedTenantForMembers is null) return;
        var res = await PlatformAdmin.RemoveWorkspaceMemberAsync(Me, selectedTenantForMembers.Id, userId);
        Say(res, "Member removed from workspace.");
        if (res.Ok)
        {
            currentMembers = await PlatformAdmin.ListWorkspaceMembersAsync(selectedTenantForMembers.Id);
            await LoadTenantsAsync();
        }
    }

    private void OpenDeleteModal(Tenant tenant)
    {
        deletingTenant = tenant;
        deleteConfirmSlug = "";
    }

    private async Task ConfirmDeleteAsync()
    {
        if (deletingTenant is null) return;
        saving = true;
        try
        {
            var res = await PlatformAdmin.DeleteWorkspaceAsync(Me, deletingTenant.Id, deleteConfirmSlug);
            Say(res, $"Workspace '{deletingTenant.Name}' deleted.");
            if (res.Ok)
            {
                deletingTenant = null;
                await LoadTenantsAsync();
            }
        }
        finally
        {
            saving = false;
        }
    }
}
