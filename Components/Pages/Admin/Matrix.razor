@page "/admin/matrix"
@attribute [Authorize(Policy = "AuditAccess")]
@inherits PageBase
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject PermissionService Permissions
@inject AuditService Audit
@inject IJSRuntime Js

<PageTitle>Access matrix · Query Gate</PageTitle>

<div class="page-head">
    <div><h1>Access matrix</h1><p>Effective permissions per user and database.</p></div>
    <div class="actions">
        <div class="export-dropdown">
            <button class="btn btn-sm" type="button" disabled="@(rows.Count == 0)">
                <Icon Name="download" />Export <span style="font-size:9px;margin-left:2px">▾</span>
            </button>
            <div class="export-dropdown-menu">
                <button class="export-dropdown-item" type="button" @onclick="ExportCsv"><Icon Name="file" />CSV (.csv)</button>
                <button class="export-dropdown-item" type="button" @onclick="ExportXlsx"><Icon Name="table" />Excel (.xlsx)</button>
                <button class="export-dropdown-item" type="button" @onclick="ExportXlsb"><Icon Name="table" />Excel Binary (.xlsb)</button>
            </div>
        </div>
    </div>
</div>

<div class="toolbar">
    <select @bind="dbId" @bind:after="Load" style="min-width:240px">
        <option value="@Guid.Empty">Select database…</option>
        @foreach (var d in dbs) { <option value="@d.Id">@d.Name (@d.Environment)</option> }
    </select>
</div>

@if (rows.Count > 0)
{
    <div class="card"><div class="table-wrap"><table>
        <thead><tr><th>User</th><th>Status</th>@foreach (var c in Perm.Catalog) { <th class="small">@Perm.Label(c)</th> }</tr></thead>
        <tbody>
        @foreach (var r in rows)
        {
            <tr>
                <td><b>@r.User.Email</b></td>
                <td>@if (r.User.IsActive) { <span class="badge ok">Active</span> } else { <span class="badge bad">Inactive</span> }</td>
                @foreach (var c in Perm.Catalog)
                {
                    var allowed = r.Allowed.Contains(c);
                    <td>@if (allowed) { <span class="badge @(Perm.IsDangerous(c) ? "warn" : "ok")">✓</span> } else { <span class="faint">-</span> }</td>
                }
            </tr>
        }
        </tbody>
    </table></div></div>
}

@code {
    private sealed record Row(ApplicationUser User, HashSet<string> Allowed);
    private List<ManagedDatabase> dbs = [];
    private List<Row> rows = [];
    private Guid dbId;

    protected override async Task OnLoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        dbs = await db.ManagedDatabases.AsNoTracking().OrderBy(d => d.Name).ToListAsync();
    }

    private async Task Load()
    {
        rows = [];
        if (dbId == Guid.Empty) return;
        List<ApplicationUser> users;
        await using (var db = await DbFactory.CreateDbContextAsync()) users = await db.Users.AsNoTracking().OrderBy(u => u.Email).ToListAsync();
        foreach (var u in users)
        {
            var eff = await Permissions.GetEffectiveAsync(u.Id, dbId);
            rows.Add(new Row(u, eff.Where(e => e.IsAllowed).Select(e => e.PermissionCode).ToHashSet(StringComparer.OrdinalIgnoreCase)));
        }
    }

    private (List<string> Columns, List<object?[]> Rows) GetMatrixExportData()
    {
        var cols = new List<string> { "User", "Active" };
        cols.AddRange(Perm.Catalog);

        var dataRows = rows.Select(r =>
        {
            var rowVals = new List<object?> { r.User.Email, r.User.IsActive ? "Active" : "Inactive" };
            rowVals.AddRange(Perm.Catalog.Select(c => r.Allowed.Contains(c) ? "Y" : "N"));
            return rowVals.ToArray();
        }).ToList();

        return (cols, dataRows);
    }

    private async Task ExportCsv()
    {
        var (cols, dataRows) = GetMatrixExportData();
        var csv = ExportFormatters.ToCsv(cols, dataRows);
        await Audit.TryWriteAsync(Me, "Export", "AccessMatrixExport", "Success", $"{rows.Count} users (CSV)", dbId, dbs.FirstOrDefault(d => d.Id == dbId)?.Name);
        await DownloadFileAsync($"access-matrix-{DateTime.UtcNow:yyyyMMdd}.csv", csv, ExportFormatters.CsvMimeType);
        Say($"Exported {rows.Count:N0} matrix row(s).");
    }

    private async Task ExportXlsx()
    {
        var (cols, dataRows) = GetMatrixExportData();
        var bytes = ExportFormatters.ToXlsx(cols, dataRows, "Access Matrix");
        await Audit.TryWriteAsync(Me, "Export", "AccessMatrixExport", "Success", $"{rows.Count} users (XLSX)", dbId, dbs.FirstOrDefault(d => d.Id == dbId)?.Name);
        await DownloadBinaryAsync($"access-matrix-{DateTime.UtcNow:yyyyMMdd}.xlsx", bytes, ExportFormatters.XlsxMimeType);
        Say($"Exported {rows.Count:N0} matrix row(s).");
    }

    private async Task ExportXlsb()
    {
        var (cols, dataRows) = GetMatrixExportData();
        var bytes = ExportFormatters.ToXlsb(cols, dataRows, "Access Matrix");
        await Audit.TryWriteAsync(Me, "Export", "AccessMatrixExport", "Success", $"{rows.Count} users (XLSB)", dbId, dbs.FirstOrDefault(d => d.Id == dbId)?.Name);
        await DownloadBinaryAsync($"access-matrix-{DateTime.UtcNow:yyyyMMdd}.xlsb", bytes, ExportFormatters.XlsbMimeType);
        Say($"Exported {rows.Count:N0} matrix row(s).");
    }
}
