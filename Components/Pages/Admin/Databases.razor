@page "/admin/databases"
@attribute [Authorize]
@inherits PageBase
@implements IDisposable
@inject DatabaseAdminService DbAdmin
@inject HealthMonitorService HealthMonitor
@inject SettingsService Cfg
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Databases · Query Gate</PageTitle>

@if (!isAuthorized)
{
    <div class="card" style="padding:24px;text-align:center">
        <p class="text-dim">Checking authorization...</p>
    </div>
}
else
{
    <div class="page-head">
        <div>
            <h1>Databases</h1>
            <p>Register SQL Server, PostgreSQL, MySQL and MariaDB targets with live connectivity and health monitoring.</p>
        </div>
        <div class="actions" style="display:flex;align-items:center;gap:10px">
            <span class="faint small" style="display:inline-flex;align-items:center">Last checked: @Ago(lastRefreshed)</span>
            <button class="btn btn-sm" disabled="@refreshingAll" @onclick="ProbeAllAsync" title="Probe connectivity across all active databases">
                <Icon Name="refresh" /> @(refreshingAll ? "Probing..." : "Probe all")
            </button>
            <label class="check small" style="display:inline-flex;align-items:center;gap:6px;margin:0"><input type="checkbox" @bind="showDisabled" @bind:after="Load" />Show disabled</label>
            @if (canManage)
            {
                <button class="btn btn-sm btn-primary" @onclick="New"><Icon Name="plus" />Register database</button>
            }
        </div>
    </div>

    <div class="health-stat-grid">
        <div class="health-stat">
            <div class="health-stat-num">@list.Count</div>
            <div class="health-stat-label">Total Databases</div>
        </div>
        <div class="health-stat">
            <div class="health-stat-num latency-ok">@onlineCount</div>
            <div class="health-stat-label">Online Targets</div>
        </div>
        <div class="health-stat">
            <div class="health-stat-num @(offlineCount > 0 ? "latency-bad" : "")">@offlineCount</div>
            <div class="health-stat-label">Offline Targets</div>
        </div>
        <div class="health-stat">
            <div class="health-stat-num @LatencyClass(avgLatency)">@(avgLatency > 0 ? $"{avgLatency} ms" : "-")</div>
            <div class="health-stat-label">Average Latency</div>
        </div>
    </div>

    <div class="card">
        @if (!ready)
        {
            <div style="padding:24px;text-align:center;color:var(--text-dim)">Loading databases...</div>
        }
        else if (list.Count == 0)
        {
            <div class="empty"><Icon Name="db" /><div>No databases registered.</div></div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Database</th>
                            <th>Engine</th>
                            <th>Environment</th>
                            <th>Health</th>
                            <th style="white-space:nowrap">Latency</th>
                            <th style="white-space:nowrap">Last Probed</th>
                            <th style="white-space:nowrap">Limits</th>
                            <th class="right" style="white-space:nowrap">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in list)
                        {
                            var res = HealthMonitor.Get(d.Id);
                            var isChecking = checkingIds.Contains(d.Id);
                            <tr>
                                <td>
                                    <b>@d.Name</b>
                                    @if (!string.IsNullOrWhiteSpace(d.Description))
                                    {
                                        <div class="faint small">@d.Description</div>
                                    }
                                    @if (d.IsActive && res?.Telemetry is not null)
                                    {
                                        var t = res.Telemetry;
                                        <div style="display:flex;gap:4px;margin-top:4px;flex-wrap:wrap">
                                            @if (t.ActiveConnections.HasValue)
                                            {
                                                <span class="badge" style="font-size:10px;padding:1px 5px" title="Active connections / Maximum capacity">
                                                    @(t.ActiveConnections)@(t.MaxConnections.HasValue ? $"/{t.MaxConnections}" : "") conn
                                                </span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(t.DatabaseSize))
                                            {
                                                <span class="badge" style="font-size:10px;padding:1px 5px" title="Database storage size">
                                                    @t.DatabaseSize
                                                </span>
                                            }
                                            @if (t.BlockedQueriesCount.HasValue && t.BlockedQueriesCount.Value > 0)
                                            {
                                                <span class="badge bad" style="font-size:10px;padding:1px 5px" title="Queries currently blocked by locks">
                                                    @t.BlockedQueriesCount.Value blocked
                                                </span>
                                            }
                                            @if (t.InFlightQueries.HasValue && t.InFlightQueries.Value > 0)
                                            {
                                                <span class="badge warn" style="font-size:10px;padding:1px 5px" title="Queries currently executing via Query Gate">
                                                    @t.InFlightQueries.Value in-flight
                                                </span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td><span class="badge @DatabaseEngineInfo.GetBadgeClass(d.Engine)">@DatabaseEngineInfo.GetDisplayName(d.Engine)</span></td>
                                <td><span class="badge @EnvClass(d.Environment)">@d.Environment</span></td>
                                <td>
                                    @if (!d.IsActive)
                                    {
                                        <span class="badge">Disabled</span>
                                    }
                                    else if (isChecking)
                                    {
                                        <span class="badge warn">Checking...</span>
                                    }
                                    else if (res is null)
                                    {
                                        <span class="badge warn">Pending</span>
                                    }
                                    else if (res.IsOnline)
                                    {
                                        <span class="badge ok">Online</span>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="badge bad"
                                                style="cursor:pointer;border:none;display:inline-flex;align-items:center;gap:4px"
                                                @onclick="() => OpenDiagnostics(d, res)"
                                                title="Connection failed. Click to view failure diagnostics.">
                                            Offline <Icon Name="alert-triangle" />
                                        </button>
                                    }
                                </td>
                                <td style="white-space:nowrap">
                                    @if (d.IsActive && res is not null && res.IsOnline)
                                    {
                                        <span class="@LatencyClass(res.LatencyMs)">@res.LatencyMs ms</span>
                                    }
                                    else
                                    {
                                        <span class="muted">-</span>
                                    }
                                </td>
                                <td style="white-space:nowrap">
                                    @if (d.IsActive && res is not null)
                                    {
                                        <span title="@res.CheckedAt.ToLocalTime().ToString("u")">@Ago(res.CheckedAt)</span>
                                    }
                                    else
                                    {
                                        <span class="muted">-</span>
                                    }
                                </td>
                                <td style="white-space:nowrap">
                                    <span class="small faint">@d.DefaultTimeoutSeconds s · @d.MaxRows rows</span>
                                </td>
                                <td class="right" style="white-space:nowrap">
                                    <div style="display:inline-flex;align-items:center;justify-content:flex-end;gap:6px">
                                        <button class="btn btn-sm btn-ghost" @onclick="() => OpenDiagnostics(d, res)" title="View live database telemetry, connections, storage and performance metrics">
                                            <Icon Name="activity" /> Health
                                        </button>
                                        @if (canManage)
                                        {
                                            <button class="btn btn-sm btn-ghost" @onclick="() => OpenObjectRules(d)" title="Configure database and role level object rules">
                                                <Icon Name="shield" /> Rules
                                            </button>
                                        }
                                        <button class="btn btn-sm btn-ghost" disabled="@isChecking" @onclick="() => ProbeOneAsync(d.Id)" title="Probe connection and measure latency">
                                            <Icon Name="refresh" /> @(isChecking ? "Checking..." : "Check")
                                        </button>
                                        @if (canManage)
                                        {
                                            <button class="btn btn-sm btn-ghost" @onclick="() => Edit(d)" title="Edit database target">
                                                <Icon Name="edit" /> Edit
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@if (open && canManage)
{
    <div class="modal-back"><div class="modal" style="max-width:680px">
        <div class="modal-head"><h2>@(editId is null ? "Register database" : "Edit " + name)</h2></div>
        <div class="modal-body">
            <div class="grid-2">
                <div class="field"><label>Engine</label>
                    <select @bind="engine" @bind:after="OnEngineChanged">
                        @foreach (var eng in DatabaseEngineInfo.AllEngines)
                        {
                            <option value="@eng">@DatabaseEngineInfo.GetDisplayName(eng)</option>
                        }
                    </select>
                </div>
                <div class="field"><label>Environment</label>
                    <select @bind="env">@foreach (var e in environments) { <option value="@e.Name">@e.Name</option> }</select>
                </div>
            </div>
            @if (environments.Count == 0) { <div class="alert warn">Add an environment under Permissions before registering a database.</div> }
            <div class="field"><label>Name</label><input type="text" @bind="name" placeholder="e.g. OrdersDb" /></div>
            <div class="field"><label>Description</label><input type="text" @bind="description" placeholder="Optional description" /></div>
            <div class="field"><label>Connection string @(editId is null ? "" : "(leave blank to keep current)")</label>
                <textarea style="min-height:70px" autocomplete="off" placeholder="@DatabaseEngineInfo.GetSampleConnectionString(engine)" @bind="connection"></textarea>
                <div class="faint small" style="margin-top:4px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:4px">
                    <span>Default port: <b>@DatabaseEngineInfo.GetDefaultPort(engine)</b></span>
                    @if (string.IsNullOrWhiteSpace(connection))
                    {
                        <button type="button" class="btn-ghost btn btn-sm" style="padding:2px 8px;font-size:0.75rem" @onclick="FillSampleConnection">Use template</button>
                    }
                </div>
            </div>
            <div class="grid-2">
                <div class="field"><label>Default timeout (s)</label><input type="number" min="1" @bind="timeout" /></div>
                <div class="field"><label>Max rows</label><input type="number" min="1" @bind="maxRows" /></div>
            </div>

            @if (editId is not null) { <label class="check" style="margin-top:12px"><input type="checkbox" @bind="active" />Enabled</label> }
            @if (testMsg is not null) { <div class="alert @(testOk ? "success" : "error")" style="margin-top:10px">@testMsg</div> }
        </div>
        <div class="modal-foot">
            <button type="button" class="btn" @onclick="() => open = false">Cancel</button>
            <button type="button" class="btn" disabled="@string.IsNullOrWhiteSpace(connection)" @onclick="Test">Test connection</button>
            <button type="button" class="btn btn-primary" disabled="@(environments.Count == 0)" @onclick="Save">Save</button>
        </div>
    </div></div>
}

@if (managingRulesDb is not null && canManage)
{
    var hasDbConflict = ObjectScope.HasConflict(dbIncludedObjects, dbExcludedObjects, out var dbConflict);
    var hasDbExclusions = !string.IsNullOrWhiteSpace(dbExcludedObjects);

    <div class="modal-back">
        <div class="modal wide" style="max-width:960px;width:min(960px, 96vw);min-height:680px;display:flex;flex-direction:column">
            <div class="modal-head" style="display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px 24px">
                <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
                    <Icon Name="shield" Style="color:var(--brand);width:20px;height:20px" />
                    <h2 style="margin:0;font-size:1.15rem">Object Rules: <b>@managingRulesDb.Name</b></h2>
                    <span class="badge @EnvClass(managingRulesDb.Environment)">@managingRulesDb.Environment</span>
                    <span class="badge @DatabaseEngineInfo.GetBadgeClass(managingRulesDb.Engine)">@DatabaseEngineInfo.GetDisplayName(managingRulesDb.Engine)</span>
                </div>
                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => managingRulesDb = null" title="Close">✕</button>
            </div>

            <div style="display:flex;gap:10px;border-bottom:1px solid var(--line);padding:10px 24px;background:var(--bg-sunken)">
                <button type="button"
                        class="btn btn-sm @(rulesTab == "database" ? "btn-primary" : "btn-ghost")"
                        @onclick='() => rulesTab = "database"'>
                    <Icon Name="db" /> Database-Level Rules
                </button>
                <button type="button"
                        class="btn btn-sm @(rulesTab == "roles" ? "btn-primary" : "btn-ghost")"
                        @onclick='() => rulesTab = "roles"'>
                    <Icon Name="users" /> Role-Level Rules (@roles.Count roles)
                </button>
            </div>

            <div class="modal-body stack" style="flex:1;overflow-y:auto;padding:22px 24px 180px 24px;gap:18px">
                @if (rulesTab == "database")
                {
                    <div class="stack" style="gap:16px">
                        <div class="alert info small" style="display:flex;align-items:flex-start;gap:8px">
                            <Icon Name="info" Style="width:16px;height:16px;flex-shrink:0;margin-top:2px" />
                            <div>
                                <b>Database-level boundaries</b> apply database-wide to all queries on <b>@managingRulesDb.Name</b>.
                                Any excluded objects cannot be queried by anyone, even administrators. By default, all objects (<code>*</code>) are included.
                            </div>
                        </div>

                        @if (hasDbConflict)
                        {
                            <div class="alert bad small" style="display:flex;align-items:center;gap:8px">
                                <Icon Name="alert-triangle" Style="width:16px;height:16px;flex-shrink:0" />
                                <div>
                                    <b>Conflict Detected:</b> <code>@dbConflict</code> cannot be simultaneously included and excluded. Please resolve this before saving.
                                </div>
                            </div>
                        }

                        <div class="card" style="padding:16px;background:var(--bg-elev);border:1px solid var(--line);border-radius:12px">
                            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">
                                <div>
                                    <div style="font-weight:650;font-size:0.95rem;display:flex;align-items:center;gap:6px">
                                        <span style="color:var(--ok)">●</span> Database Included Objects (Whitelist)
                                    </div>
                                    <div class="muted small">Objects and schemas allowed for queries on this database (<code>*</code> for entire database)</div>
                                </div>
                                <div style="display:flex;gap:6px">
                                    <button type="button" class="btn btn-sm btn-ghost" @onclick='() => dbIncludedObjects = "*"' title="Include all">* (All Objects)</button>
                                    <button type="button" class="btn btn-sm btn-ghost" @onclick='() => dbIncludedObjects = ""' title="Clear whitelist">Clear</button>
                                </div>
                            </div>
                            <ObjectScopeSelector DatabaseId="@managingRulesDb.Id" @bind-Value="dbIncludedObjects" Placeholder="* (All objects included)" />
                        </div>

                        <div class="card" style="padding:16px;background:var(--bg-elev);border:1px solid var(--line);border-radius:12px">
                            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">
                                <div>
                                    <div style="font-weight:650;font-size:0.95rem;display:flex;align-items:center;gap:6px">
                                        <span style="color:var(--bad)">●</span> Database Excluded Objects (Blacklist)
                                    </div>
                                    <div class="muted small">Objects completely blocked from all queries across all roles (e.g. <code>*.passwords</code>, <code>dbo.AuditLogs</code>)</div>
                                </div>
                                <div>
                                    <button type="button"
                                            class="btn btn-sm btn-ghost"
                                            style="color:var(--bad);border-color:rgba(224,62,82,0.3)"
                                            disabled="@(!hasDbExclusions)"
                                            @onclick="RemoveAllDbExclusions"
                                            title="Remove all database exclusions">
                                        Remove all exclusions
                                    </button>
                                </div>
                            </div>
                            <ObjectScopeSelector DatabaseId="@managingRulesDb.Id" @bind-Value="dbExcludedObjects" IsExclusion="true" AllowEmpty="true" Placeholder="None (No objects excluded)" />
                        </div>

                        <div style="display:flex;align-items:center;gap:12px;margin-top:6px">
                            <button type="button" class="btn btn-primary" disabled="@hasDbConflict" @onclick="SaveDbRules">
                                <Icon Name="check" /> Save Database Rules
                            </button>
                            @if (hasDbExclusions)
                            {
                                <button type="button" class="btn btn-ghost" style="color:var(--bad)" @onclick="RemoveAllDbExclusions">
                                    Remove all exclusions
                                </button>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="stack" style="gap:16px">
                        <div class="alert info small" style="display:flex;align-items:flex-start;gap:8px">
                            <Icon Name="info" Style="width:16px;height:16px;flex-shrink:0;margin-top:2px" />
                            <div>
                                <b>Role-level object rules</b> define inclusion and exclusion boundaries for specific roles on <b>@managingRulesDb.Name</b>.
                                Select a role below to configure its boundaries.
                            </div>
                        </div>

                        <!-- Role Selector Pills Bar -->
                        <div style="display:flex;gap:8px;overflow-x:auto;padding-bottom:4px">
                            @foreach (var r in roles)
                            {
                                var isSel = r.Id == selectedRuleRoleId;
                                var rule = roleScopeRules.FirstOrDefault(x => x.RoleId == r.Id);
                                var hasInc = !string.IsNullOrWhiteSpace(rule?.IncludedObjects) && rule.IncludedObjects != "*";
                                var hasExc = !string.IsNullOrWhiteSpace(rule?.ExcludedObjects);

                                <button type="button"
                                        class="btn btn-sm @(isSel ? "btn-primary" : "btn-ghost")"
                                        style="display:inline-flex;align-items:center;gap:8px;padding:6px 14px;border-radius:100px"
                                        @onclick="() => SelectRoleForRuleManagement(r.Id)">
                                    <b>@r.Name</b>
                                    @if (hasExc)
                                    {
                                        <span class="badge bad" style="font-size:10px;padding:1px 6px">Excluded</span>
                                    }
                                    else if (hasInc)
                                    {
                                        <span class="badge ok" style="font-size:10px;padding:1px 6px">Custom</span>
                                    }
                                    else
                                    {
                                        <span class="muted small" style="font-size:10px;opacity:0.7">Default</span>
                                    }
                                </button>
                            }
                        </div>

                        <!-- Selected Role Editor -->
                        @if (activeRole is not null)
                        {
                            var hasRoleConflict = ObjectScope.HasConflict(roleIncludedObjects, roleExcludedObjects, out var roleConflict);
                            var hasRoleExclusions = !string.IsNullOrWhiteSpace(roleExcludedObjects);

                            <div class="card" style="padding:18px;background:var(--bg-elev);border:1px solid var(--line);border-radius:12px">
                                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;flex-wrap:wrap;gap:8px">
                                    <div>
                                        <h3 style="margin:0;font-size:1.05rem;display:flex;align-items:center;gap:8px">
                                            <Icon Name="users" Style="color:var(--brand)" /> Configure Rules for Role: <b>@activeRole.Name</b>
                                        </h3>
                                        <div class="muted small">Define boundaries for members of <b>@activeRole.Name</b> on @managingRulesDb.Name.</div>
                                    </div>
                                    <div>
                                        <button type="button" class="btn btn-sm btn-ghost" @onclick="ResetActiveRoleRuleToDefault" title="Reset this role to default (all objects, no exclusions)">
                                            Reset to Default
                                        </button>
                                    </div>
                                </div>

                                @if (hasRoleConflict)
                                {
                                    <div class="alert bad small" style="display:flex;align-items:center;gap:8px;margin-bottom:12px">
                                        <Icon Name="alert-triangle" Style="width:16px;height:16px;flex-shrink:0" />
                                        <div>
                                            <b>Conflict Detected:</b> <code>@roleConflict</code> cannot be both included and excluded for <b>@activeRole.Name</b>.
                                        </div>
                                    </div>
                                }

                                <div class="grid-2" style="gap:16px">
                                    <div class="card" style="padding:14px;background:var(--bg-card);border:1px solid var(--line);border-radius:8px">
                                        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">
                                            <div style="font-weight:650;font-size:0.9rem">
                                                <span style="color:var(--ok)">●</span> Included Objects
                                            </div>
                                            <div style="display:flex;gap:4px">
                                                <button type="button" class="btn btn-sm btn-ghost" style="padding:1px 6px;font-size:11px" @onclick='() => roleIncludedObjects = "*"' title="Include all">* (All)</button>
                                                <button type="button" class="btn btn-sm btn-ghost" style="padding:1px 6px;font-size:11px" @onclick='() => roleIncludedObjects = ""'>Clear</button>
                                            </div>
                                        </div>
                                        <ObjectScopeSelector DatabaseId="@managingRulesDb.Id" @bind-Value="roleIncludedObjects" Placeholder="* (All objects included)" />
                                    </div>

                                    <div class="card" style="padding:14px;background:var(--bg-card);border:1px solid var(--line);border-radius:8px">
                                        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">
                                            <div style="font-weight:650;font-size:0.9rem">
                                                <span style="color:var(--bad)">●</span> Excluded Objects
                                            </div>
                                            <div>
                                                <button type="button"
                                                        class="btn btn-sm btn-ghost"
                                                        style="color:var(--bad);padding:1px 6px;font-size:11px"
                                                        disabled="@(!hasRoleExclusions)"
                                                        @onclick="RemoveAllRoleExclusions"
                                                        title="Remove all exclusions for this role">
                                                    Remove all exclusions
                                                </button>
                                            </div>
                                        </div>
                                        <ObjectScopeSelector DatabaseId="@managingRulesDb.Id" @bind-Value="roleExcludedObjects" IsExclusion="true" AllowEmpty="true" Placeholder="None (No objects excluded)" />
                                    </div>
                                </div>

                                <div style="display:flex;align-items:center;gap:10px;margin-top:16px">
                                    <button type="button" class="btn btn-primary" disabled="@hasRoleConflict" @onclick="SaveCurrentRoleRule">
                                        <Icon Name="check" /> Save @activeRole.Name Rules
                                    </button>
                                    @if (hasRoleExclusions)
                                    {
                                        <button type="button" class="btn btn-ghost" style="color:var(--bad)" @onclick="RemoveAllRoleExclusions">
                                            Remove all exclusions
                                        </button>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Roles Overview Table -->
                        <div class="card" style="padding:14px;background:var(--bg-card);border:1px solid var(--line);border-radius:10px">
                            <div style="font-weight:650;margin-bottom:8px;font-size:0.88rem">Team Roles Overview on @managingRulesDb.Name</div>
                            <div class="table-wrap"><table>
                                <thead>
                                    <tr><th>Role</th><th>Included Objects</th><th>Excluded Objects</th><th></th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in roles)
                                    {
                                        var rule = roleScopeRules.FirstOrDefault(x => x.RoleId == r.Id);
                                        var hasInc = !string.IsNullOrWhiteSpace(rule?.IncludedObjects) && rule.IncludedObjects != "*";
                                        var hasExc = !string.IsNullOrWhiteSpace(rule?.ExcludedObjects);
                                        var isCur = r.Id == selectedRuleRoleId;

                                        <tr style="@(isCur ? "background:var(--brand-soft);" : "")">
                                            <td><b>@r.Name</b></td>
                                            <td>
                                                @if (hasInc)
                                                {
                                                    <span class="badge ok" style="font-family:monospace;font-size:11px">@rule!.IncludedObjects</span>
                                                }
                                                else
                                                {
                                                    <span class="muted small">All objects (*)</span>
                                                }
                                            </td>
                                            <td>
                                                @if (hasExc)
                                                {
                                                    <span class="badge bad" style="font-family:monospace;font-size:11px">@rule!.ExcludedObjects</span>
                                                }
                                                else
                                                {
                                                    <span class="muted small">None</span>
                                                }
                                            </td>
                                            <td class="right">
                                                @if (!isCur)
                                                {
                                                    <button type="button" class="btn btn-sm btn-ghost" @onclick="() => SelectRoleForRuleManagement(r.Id)">Configure</button>
                                                }
                                                else
                                                {
                                                    <span class="badge" style="font-size:11px">Editing</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table></div>
                        </div>
                    </div>
                }
            </div>

            <div class="modal-foot" style="padding:14px 24px">
                <button type="button" class="btn btn-primary" @onclick="() => managingRulesDb = null">Close</button>
            </div>
        </div>
    </div>
}

@if (diagnosticDb is not null)
{
    var res = diagnosticResult ?? HealthMonitor.Get(diagnosticDb.Id);
    var telem = res?.Telemetry;
    <div class="modal-back">
        <div class="modal" style="max-width:720px">
            <div class="modal-head" style="display:flex;align-items:center;justify-content:space-between">
                <div style="display:flex;align-items:center;gap:10px">
                    <Icon Name="@(res?.IsOnline == false ? "alert-triangle" : "activity")" Style="@(res?.IsOnline == false ? "color:var(--bad);width:20px;height:20px" : "color:var(--brand);width:20px;height:20px")" />
                    <h2 style="margin:0;font-size:1.15rem">Health & Telemetry: <b>@diagnosticDb.Name</b></h2>
                </div>
                <button type="button" class="btn btn-ghost btn-sm" @onclick="CloseDiagnostics">✕</button>
            </div>
            <div class="modal-body stack" style="gap:14px;padding:20px">
                <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
                    <span class="badge @DatabaseEngineInfo.GetBadgeClass(diagnosticDb.Engine)">@DatabaseEngineInfo.GetDisplayName(diagnosticDb.Engine)</span>
                    <span class="badge @EnvClass(diagnosticDb.Environment)">@diagnosticDb.Environment</span>
                    @if (res is null)
                    {
                        <span class="badge warn">Pending Probe</span>
                    }
                    else if (res.IsOnline)
                    {
                        <span class="badge ok">Online</span>
                        <span class="badge @LatencyClass(res.LatencyMs)">@res.LatencyMs ms</span>
                    }
                    else
                    {
                        <span class="badge bad">Connection Failed</span>
                    }
                </div>

                @if (telem is not null)
                {
                    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(180px, 1fr));gap:10px;margin-top:6px">
                        <div class="card" style="padding:12px;background:var(--bg-elev);border:1px solid var(--line);border-radius:8px">
                            <div class="small faint">Active Connections</div>
                            <div style="font-size:1.25rem;font-weight:700;margin-top:2px">
                                @(telem.ActiveConnections.HasValue ? (telem.MaxConnections.HasValue ? $"{telem.ActiveConnections} / {telem.MaxConnections}" : $"{telem.ActiveConnections}") : "-")
                            </div>
                            <div class="faint small" style="font-size:11px">
                                @(telem.ActiveConnections.HasValue && telem.MaxConnections.HasValue && telem.MaxConnections.Value > 0
                                    ? $"{Math.Round((double)telem.ActiveConnections.Value / telem.MaxConnections.Value * 100, 1)}% capacity"
                                    : "Active sessions")
                            </div>
                        </div>

                        <div class="card" style="padding:12px;background:var(--bg-elev);border:1px solid var(--line);border-radius:8px">
                            <div class="small faint">Database Size</div>
                            <div style="font-size:1.25rem;font-weight:700;margin-top:2px">
                                @(telem.DatabaseSize ?? "-")
                            </div>
                            <div class="faint small" style="font-size:11px">Total storage footprint</div>
                        </div>

                        <div class="card" style="padding:12px;background:var(--bg-elev);border:1px solid var(--line);border-radius:8px">
                            <div class="small faint">Cache Hit Ratio</div>
                            <div style="font-size:1.25rem;font-weight:700;margin-top:2px" class="@(telem.CacheHitRatio >= 95 ? "latency-ok" : (telem.CacheHitRatio >= 85 ? "latency-warn" : "latency-bad"))">
                                @(telem.CacheHitRatio.HasValue ? $"{telem.CacheHitRatio:F1}%" : "-")
                            </div>
                            <div class="faint small" style="font-size:11px">RAM vs disk I/O</div>
                        </div>

                        <div class="card" style="padding:12px;background:var(--bg-elev);border:1px solid var(--line);border-radius:8px">
                            <div class="small faint">Blocked Queries / Locks</div>
                            <div style="font-size:1.25rem;font-weight:700;margin-top:2px" class="@(telem.BlockedQueriesCount > 0 ? "latency-bad" : "latency-ok")">
                                @(telem.BlockedQueriesCount.HasValue ? (telem.BlockedQueriesCount.Value > 0 ? $"{telem.BlockedQueriesCount.Value} blocked" : "0") : "-")
                            </div>
                            <div class="faint small" style="font-size:11px">Contention on locks</div>
                        </div>

                        <div class="card" style="padding:12px;background:var(--bg-elev);border:1px solid var(--line);border-radius:8px">
                            <div class="small faint">Query Gate 24h Activity</div>
                            <div style="font-size:1.25rem;font-weight:700;margin-top:2px">
                                @(telem.AuditTotal24h.HasValue && telem.AuditTotal24h > 0 ? $"{telem.AuditTotal24h} queries" : "0 queries")
                            </div>
                            <div class="faint small" style="font-size:11px">
                                @(telem.AuditTotal24h.HasValue && telem.AuditTotal24h > 0 ? $"{telem.AuditErrorRate24h:F1}% error rate" : "No executions in 24h")
                            </div>
                        </div>

                        <div class="card" style="padding:12px;background:var(--bg-elev);border:1px solid var(--line);border-radius:8px">
                            <div class="small faint">Query Gate Latency (P95)</div>
                            <div style="font-size:1.25rem;font-weight:700;margin-top:2px">
                                @(telem.AuditP95Ms24h.HasValue && telem.AuditTotal24h > 0 ? $"{telem.AuditP95Ms24h} ms" : "-")
                            </div>
                            <div class="faint small" style="font-size:11px">
                                @(telem.InFlightQueries.HasValue && telem.InFlightQueries.Value > 0 ? $"{telem.InFlightQueries.Value} in-flight right now" : "0 in-flight now")
                            </div>
                        </div>
                    </div>
                }

                @if (res is not null && !res.IsOnline)
                {
                    <div class="field">
                        <label>Failure Details</label>
                        <div style="background:var(--bg-card);border:1px solid var(--line);border-radius:8px;padding:12px;font-family:monospace;font-size:0.82rem;max-height:160px;overflow-y:auto;white-space:pre-wrap;word-break:break-word;color:var(--bad)">
                            @res.Message
                        </div>
                    </div>

                    <div class="card" style="padding:14px;background:var(--bg-elev);border:1px solid var(--line);border-radius:8px">
                        <div style="font-weight:650;font-size:0.88rem;margin-bottom:6px">Troubleshooting Guidance</div>
                        <ul class="small faint" style="margin:0;padding-left:18px;line-height:1.6">
                            <li>Verify that the database server is running and listening on port <b>@DatabaseEngineInfo.GetDefaultPort(diagnosticDb.Engine)</b>.</li>
                            <li>Check network security groups, firewalls, or container port mappings between Query Gate and the host.</li>
                            <li>Ensure credentials, username, and password configured in the connection string are valid.</li>
                            <li>Verify SSL/TLS certificate requirements (e.g. <code>TrustServerCertificate=True</code> for SQL Server or <code>SslMode=Prefer</code> for PostgreSQL).</li>
                        </ul>
                    </div>
                }

                <div class="faint small" style="display:flex;justify-content:space-between;margin-top:4px">
                    <span>Last probed: <b>@(res is not null ? res.CheckedAt.ToLocalTime().ToString("g") : "Never")</b></span>
                    <span>Response: <b>@(res is not null ? $"{res.LatencyMs} ms" : "-")</b></span>
                </div>
            </div>
            <div class="modal-foot" style="display:flex;justify-content:space-between">
                <div>
                    @if (canManage)
                    {
                        <button type="button" class="btn btn-ghost" @onclick="() => { var dbToEdit = diagnosticDb; CloseDiagnostics(); Edit(dbToEdit); }">
                            <Icon Name="edit" /> Edit target
                        </button>
                    }
                </div>
                <div style="display:flex;gap:8px">
                    <button type="button" class="btn" disabled="@checkingIds.Contains(diagnosticDb.Id)" @onclick="() => RecheckFromDiagnostics(diagnosticDb.Id)">
                        <Icon Name="refresh" /> Re-check connection
                    </button>
                    <button type="button" class="btn btn-primary" @onclick="CloseDiagnostics">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ManagedDatabase> list = [];
    private List<DatabaseEnvironment> environments = [];
    private readonly HashSet<Guid> checkingIds = [];
    private bool open, active = true, testOk, showDisabled;
    private bool isAuthorized, canManage, ready, refreshingAll;
    private DateTimeOffset lastRefreshed = DateTimeOffset.UtcNow;
    private Timer? timer;

    private ManagedDatabase? diagnosticDb;
    private HealthResult? diagnosticResult;

    private Guid? editId;
    private string name = "", env = "Development", description = "", connection = "";
    private DatabaseEngine engine = DatabaseEngine.SqlServer;
    private string? testMsg;
    private int timeout = 30, maxRows = 1000;
    private string includedObjects = "*", excludedObjects = "";

    private ManagedDatabase? managingRulesDb;
    private string rulesTab = "database";
    private string dbIncludedObjects = "*", dbExcludedObjects = "";
    private List<Microsoft.AspNetCore.Identity.IdentityRole> roles = [];
    private List<DatabaseRoleScopeRule> roleScopeRules = [];
    private string selectedRuleRoleId = "";
    private Microsoft.AspNetCore.Identity.IdentityRole? activeRole => roles.FirstOrDefault(r => r.Id == selectedRuleRoleId);
    private string roleIncludedObjects = "*", roleExcludedObjects = "";

    private int onlineCount => list.Count(d => d.IsActive && HealthMonitor.Get(d.Id)?.IsOnline == true);
    private int offlineCount => list.Count(d => d.IsActive && HealthMonitor.Get(d.Id) is { IsOnline: false });
    private long avgLatency
    {
        get
        {
            var latencies = list
                .Where(d => d.IsActive)
                .Select(d => HealthMonitor.Get(d.Id))
                .Where(r => r is not null && r.IsOnline && r.LatencyMs >= 0)
                .Select(r => r!.LatencyMs)
                .ToList();
            return latencies.Count > 0 ? (long)latencies.Average() : 0;
        }
    }

    protected override async Task OnLoadAsync()
    {
        var authState = await Auth.GetAuthenticationStateAsync();
        var user = authState.User;
        canManage = user.IsInRole(Roles.Admin) || user.IsInRole(Roles.SuperAdmin);

        if (!canManage)
        {
            var extraRolesSetting = await Cfg.GetAsync("HealthVisibleRoles");
            var allowedRoles = extraRolesSetting.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            var userRoles = user.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).ToList();
            var isAllowed = userRoles.Any(r => allowedRoles.Contains(r, StringComparer.OrdinalIgnoreCase));

            if (!isAllowed)
            {
                Nav.NavigateTo("dashboard");
                return;
            }
        }

        isAuthorized = true;
        await Load();
        ready = true;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && RendererInfo.IsInteractive)
        {
            timer = new Timer(async _ =>
            {
                try
                {
                    await InvokeAsync(StateHasChanged);
                }
                catch { }
            }, null, TimeSpan.FromSeconds(15), TimeSpan.FromSeconds(15));
        }
    }

    private async Task Load()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        environments = await db.DatabaseEnvironments.AsNoTracking().OrderBy(e => e.Name).ToListAsync();
        roles = await db.Roles.AsNoTracking().OrderBy(r => r.Name).ToListAsync();
        var query = db.ManagedDatabases.AsNoTracking().AsQueryable();
        if (!showDisabled) query = query.Where(d => d.IsActive);
        list = await query.OrderBy(d => d.Environment).ThenBy(d => d.Name).ToListAsync();
        lastRefreshed = DateTimeOffset.UtcNow;
    }

    private void New()
    {
        if (!canManage) return;
        editId = null;
        name = description = connection = "";
        engine = DatabaseEngine.SqlServer;
        env = environments.FirstOrDefault(e => e.Name == "Development")?.Name ?? environments.FirstOrDefault()?.Name ?? "";
        timeout = 30;
        maxRows = 1000;
        active = true;
        testMsg = null;
        includedObjects = "*";
        excludedObjects = "";
        open = true;
    }

    private void Edit(ManagedDatabase d)
    {
        if (!canManage) return;
        editId = d.Id;
        name = d.Name;
        engine = d.Engine;
        env = d.Environment;
        description = d.Description ?? "";
        connection = "";
        timeout = d.DefaultTimeoutSeconds;
        maxRows = d.MaxRows;
        active = d.IsActive;
        includedObjects = string.IsNullOrWhiteSpace(d.IncludedObjects) ? "*" : d.IncludedObjects;
        excludedObjects = d.ExcludedObjects ?? "";
        testMsg = null;
        open = true;
    }

    private void OnEngineChanged()
    {
        testMsg = null;
    }

    private void FillSampleConnection()
    {
        connection = DatabaseEngineInfo.GetSampleConnectionString(engine);
    }

    private async Task Test()
    {
        (testOk, testMsg) = await DbAdmin.TestAsync(connection, engine);
    }

    private async Task ProbeOneAsync(Guid id)
    {
        checkingIds.Add(id);
        StateHasChanged();
        try
        {
            var res = await HealthMonitor.CheckNowAsync(id);
            lastRefreshed = DateTimeOffset.UtcNow;
            if (res is not null)
            {
                if (!res.IsOnline)
                {
                    var d = list.FirstOrDefault(x => x.Id == id);
                    if (d is not null)
                    {
                        OpenDiagnostics(d, res);
                    }
                    Say($"Connection failed for {res.DatabaseName}: {res.Message}", true);
                }
                else
                {
                    Say($"Connection to {res.DatabaseName} succeeded ({res.LatencyMs} ms).", false);
                }
            }
        }
        catch (Exception ex)
        {
            Say($"Health probe failed: {ex.Message}", true);
        }
        finally
        {
            checkingIds.Remove(id);
            StateHasChanged();
        }
    }

    private async Task ProbeAllAsync()
    {
        refreshingAll = true;
        StateHasChanged();
        try
        {
            await HealthMonitor.CheckAllAsync(TenantCtx?.TenantId);
            await Load();
            Say("Health probe completed for all active targets.", false);
        }
        catch (Exception ex)
        {
            Say($"Health probe failed: {ex.Message}", true);
        }
        finally
        {
            refreshingAll = false;
            lastRefreshed = DateTimeOffset.UtcNow;
            StateHasChanged();
        }
    }

    private void OpenDiagnostics(ManagedDatabase d, HealthResult? res = null)
    {
        diagnosticDb = d;
        diagnosticResult = res ?? HealthMonitor.Get(d.Id);
    }

    private void CloseDiagnostics()
    {
        diagnosticDb = null;
        diagnosticResult = null;
    }

    private async Task RecheckFromDiagnostics(Guid id)
    {
        await ProbeOneAsync(id);
        var updated = HealthMonitor.Get(id);
        if (updated is not null)
        {
            diagnosticResult = updated;
        }
    }

    private async Task Save()
    {
        if (!canManage) return;
        var result = editId is null
            ? await DbAdmin.RegisterAsync(Me, name.Trim(), env, description, connection, timeout, maxRows, engine, includedObjects, excludedObjects)
            : await DbAdmin.UpdateAsync(Me, editId.Value, name.Trim(), env, description, string.IsNullOrWhiteSpace(connection) ? null : connection, timeout, maxRows, active, engine, includedObjects, excludedObjects);
        Say(result, "Saved.");
        if (result.Ok)
        {
            open = false;
            await Load();
            if (editId.HasValue)
            {
                _ = Task.Run(async () => await HealthMonitor.CheckNowAsync(editId.Value));
            }
            else
            {
                var created = list.FirstOrDefault(d => d.Name == name.Trim() && d.Environment == env);
                if (created is not null)
                {
                    _ = Task.Run(async () => await HealthMonitor.CheckNowAsync(created.Id));
                }
            }
        }
        else { testOk = false; testMsg = result.Error; }
    }

    private async Task OpenObjectRules(ManagedDatabase d)
    {
        if (!canManage) return;
        managingRulesDb = d;
        rulesTab = "database";
        dbIncludedObjects = string.IsNullOrWhiteSpace(d.IncludedObjects) ? "*" : d.IncludedObjects;
        dbExcludedObjects = d.ExcludedObjects ?? "";
        await using var db = await DbFactory.CreateDbContextAsync();
        roles = await db.Roles.AsNoTracking().OrderBy(r => r.Name).ToListAsync();
        roleScopeRules = await DbAdmin.GetRoleScopeRulesAsync(d.Id);
        var firstRole = roles.FirstOrDefault();
        if (firstRole is not null)
        {
            SelectRoleForRuleManagement(firstRole.Id);
        }
    }

    private void SelectRoleForRuleManagement(string roleId)
    {
        selectedRuleRoleId = roleId;
        var r = roles.FirstOrDefault(x => x.Id == roleId);
        if (r is null) return;
        var rule = roleScopeRules.FirstOrDefault(x => x.RoleId == roleId);
        roleIncludedObjects = string.IsNullOrWhiteSpace(rule?.IncludedObjects) ? "*" : rule.IncludedObjects;
        roleExcludedObjects = rule?.ExcludedObjects ?? "";
    }

    private async Task SaveDbRules()
    {
        if (managingRulesDb is null || !canManage) return;
        var res = await DbAdmin.UpdateDatabaseObjectRulesAsync(Me, managingRulesDb.Id, dbIncludedObjects, dbExcludedObjects);
        Say(res, "Database object rules updated.");
        if (res.Ok)
        {
            managingRulesDb.IncludedObjects = dbIncludedObjects;
            managingRulesDb.ExcludedObjects = dbExcludedObjects;
            await Load();
        }
    }

    private async Task RemoveAllDbExclusions()
    {
        if (!canManage) return;
        dbExcludedObjects = "";
        await SaveDbRules();
    }

    private async Task SaveCurrentRoleRule()
    {
        if (managingRulesDb is null || activeRole is null || !canManage) return;
        var res = await DbAdmin.SaveRoleScopeRuleAsync(Me, managingRulesDb.Id, activeRole.Id, roleIncludedObjects, roleExcludedObjects);
        Say(res, $"Role scope rules saved for {activeRole.Name}.");
        if (res.Ok)
        {
            roleScopeRules = await DbAdmin.GetRoleScopeRulesAsync(managingRulesDb.Id);
        }
    }

    private async Task RemoveAllRoleExclusions()
    {
        if (!canManage) return;
        roleExcludedObjects = "";
        await SaveCurrentRoleRule();
    }

    private async Task ResetActiveRoleRuleToDefault()
    {
        if (managingRulesDb is null || activeRole is null || !canManage) return;
        var res = await DbAdmin.DeleteRoleScopeRuleAsync(Me, managingRulesDb.Id, activeRole.Id);
        Say(res, $"Reset rules for {activeRole.Name} to default.");
        if (res.Ok)
        {
            roleScopeRules = await DbAdmin.GetRoleScopeRulesAsync(managingRulesDb.Id);
            roleIncludedObjects = "*";
            roleExcludedObjects = "";
        }
    }

    private static string LatencyClass(long ms) => ms switch
    {
        <= 0 => "",
        < 100 => "latency-ok",
        <= 500 => "latency-warn",
        _ => "latency-bad"
    };

    public void Dispose()
    {
        timer?.Dispose();
    }
}
