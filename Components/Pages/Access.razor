@page "/access"
@attribute [Authorize]
@inherits PageBase
@inject PermissionService Permissions
@inject RequestService Requests
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@using Microsoft.EntityFrameworkCore

<PageTitle>My access · Query Gate</PageTitle>

<div class="page-head">
    <div><h1>My access</h1><p>See what you can do on each database and request more when you need it.</p></div>
</div>

<Banner Text="@Flash" IsError="@FlashIsError" />

<div class="split">
    <div class="stack">
        <div class="card">
            <div class="card-head">
                <h2>Effective permissions</h2>
                <div class="actions">
                    <select @bind="selectedDb" @bind:after="LoadEffective" style="min-width:220px">
                        @foreach (var d in allDatabases) { <option value="@d.Id">@d.Name (@d.Environment)</option> }
                    </select>
                </div>
            </div>
            <div class="card-pad">
                @if (effective.Count == 0) { <div class="muted">Select a database.</div> }
                else
                {
                    <div class="check-grid">
                        @foreach (var p in effective)
                        {
                            <div class="row-inline" style="padding:8px 10px;border:1px solid var(--line);border-radius:9px">
                                <span class="badge @(p.IsAllowed ? "ok" : "")">@(p.IsAllowed ? "Allowed" : "No access")</span>
                                <span>@Perm.Label(p.PermissionCode)</span>
                                @if (p.IsAllowed) { <span class="faint small" style="margin-left:auto">@p.Source</span> }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-head"><h2>Time-limited grants</h2></div>
            @if (grants.Count == 0) { <div class="empty">No temporary grants.</div> }
            else
            {
                <div class="table-wrap"><table>
                    <thead><tr><th>Database</th><th>Permission</th><th>Expires</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var g in grants)
                        {
                            <tr>
                                <td>@DbName(g.DatabaseId)</td>
                                <td><span class="badge brand">@Perm.Label(g.PermissionCode)</span></td>
                                <td><span class="@(g.EndsAt < DateTimeOffset.UtcNow.AddHours(24) ? "badge warn" : "")">@Local(g.EndsAt)</span></td>
                                <td class="right"><button class="btn btn-sm" @onclick="() => Extend(g)">Request extension</button></td>
                            </tr>
                        }
                    </tbody>
                </table></div>
            }
        </div>

        <div class="card">
            <div class="card-head"><h2>My requests</h2></div>
            @if (requests.Count == 0) { <div class="empty">No requests yet.</div> }
            else
            {
                <div class="table-wrap"><table>
                    <thead><tr><th>When</th><th>Database</th><th>Permissions</th><th>Status</th><th>Reviewer note</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var r in requests)
                        {
                            <tr>
                                <td class="nowrap">@Ago(r.CreatedAt)</td>
                                <td>@DbName(r.DatabaseId)</td>
                                <td class="wrap">@r.Permissions @(r.IsExtension ? "(extension)" : "")</td>
                                <td><span class="badge @OutcomeClass(r.Status)">@r.Status</span></td>
                                <td class="wrap muted">@r.Comments</td>
                                <td class="right">@if (r.Status == RequestStatus.Pending) { <button class="btn btn-sm btn-ghost" @onclick="() => Cancel(r.Id)">Cancel</button> }</td>
                            </tr>
                        }
                    </tbody>
                </table></div>
            }
        </div>
    </div>

    <div class="card card-pad" style="align-self:start">
        <h2>Request access</h2>
        <div class="field"><label>Database</label>
            <select @bind="reqDb">
                @foreach (var d in allDatabases) { <option value="@d.Id">@d.Name (@d.Environment)</option> }
            </select>
        </div>
        <div class="field"><label>Permissions</label>
            <div class="check-grid" style="grid-template-columns:1fr 1fr">
                @foreach (var code in Perm.Catalog)
                {
                    <label class="check"><input type="checkbox" checked="@reqPerms.Contains(code)" @onchange="e => Toggle(code, (bool)e.Value!)" />@Perm.Label(code)</label>
                }
            </div>
        </div>
        <div class="field"><label>Duration (hours)</label><input type="number" min="1" max="2160" @bind="hours" /></div>
        <div class="field"><label>Ticket / reference (optional)</label><input type="text" @bind="ticket" maxlength="100" /></div>
        <div class="field"><label>Justification</label><textarea @bind="justification" maxlength="1000" placeholder="Why do you need this access?"></textarea></div>
        <button class="btn btn-primary" @onclick="Submit"><Icon Name="plus" />Submit request</button>
    </div>
</div>

@code {
    private List<ManagedDatabase> allDatabases = [];
    private List<EffectivePermission> effective = [];
    private List<PermissionGrant> grants = [];
    private List<AccessRequest> requests = [];
    private Guid selectedDb, reqDb;
    private readonly HashSet<string> reqPerms = [];
    private int hours = 24;
    private string? ticket, justification;

    protected override async Task OnLoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        allDatabases = await db.ManagedDatabases.AsNoTracking().Where(d => d.IsActive).OrderBy(d => d.Name).ToListAsync();
        if (allDatabases.Count > 0) selectedDb = reqDb = allDatabases[0].Id;
        await Refresh();
    }

    private async Task Refresh()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var now = DateTimeOffset.UtcNow;
        grants = await db.PermissionGrants.AsNoTracking().Where(g => g.UserId == UserId && g.EndsAt > now && g.Effect == PermissionEffect.Allow).OrderBy(g => g.EndsAt).ToListAsync();
        requests = await db.AccessRequests.AsNoTracking().Where(r => r.RequesterId == UserId).OrderByDescending(r => r.CreatedAt).Take(30).ToListAsync();
        await LoadEffective();
    }

    private async Task LoadEffective() => effective = selectedDb == Guid.Empty ? [] : await Permissions.GetEffectiveAsync(UserId, selectedDb);

    private string DbName(Guid id) => allDatabases.FirstOrDefault(d => d.Id == id)?.Name ?? "-";

    private void Toggle(string code, bool on) { if (on) reqPerms.Add(code); else reqPerms.Remove(code); }

    private async Task Submit()
    {
        Say(await Requests.SubmitAccessAsync(Me, reqDb, reqPerms.ToArray(), justification ?? "", ticket, hours, false), "Request submitted. An administrator will review it.");
        if (!FlashIsError) { reqPerms.Clear(); justification = null; ticket = null; await Refresh(); }
    }

    private async Task Extend(PermissionGrant g)
    {
        Say(await Requests.SubmitAccessAsync(Me, g.DatabaseId, [g.PermissionCode], "Extension of existing temporary access.", null, 24, true), "Extension requested.");
        await Refresh();
    }

    private async Task Cancel(Guid id)
    {
        Say(await Requests.CancelAsync(Me, "Access", id), "Request cancelled.");
        await Refresh();
    }
}
