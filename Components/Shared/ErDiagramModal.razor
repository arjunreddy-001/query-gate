@using DbAccessManager.Services
@inject MetadataService Metadata
@inject IJSRuntime JS
@implements IDisposable

<div class="modal-back" @onclick="Close" style="z-index:1100;@(isMaximized ? "padding:0;margin:0" : "")">
    <div class="modal card er-modal @(isMaximized ? "er-maximized" : "")" @onclick:stopPropagation>
        <div class="er-modal-head">
            <div class="er-modal-title">
                <Icon Name="grid" />
                <h3 style="margin:0;font-size:15px;font-weight:700">Entity-Relationship (ER) Diagram</h3>
                <span class="badge" style="font-size:11px">@DatabaseName</span>
                @if (diagramData is not null)
                {
                    <span class="muted small">(@diagramData.Nodes.Count tables, @diagramData.Edges.Count relations)</span>
                }
            </div>

            <div class="er-modal-controls">
                <div class="row-inline" style="gap:4px">
                    <span class="muted small" style="margin-right:4px">Focus:</span>
                    <select class="form-control er-focus-select" value="@focusTable" @onchange="OnFocusChanged">
                        @foreach (var t in availableTables)
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                </div>

                <div class="row-inline" style="gap:2px">
                    <button class="btn btn-sm @(!fullSchema && hops == 1 ? "btn-primary" : "")" type="button" @onclick="() => SetHops(1)">1 Hop</button>
                    <button class="btn btn-sm @(!fullSchema && hops == 2 ? "btn-primary" : "")" type="button" @onclick="() => SetHops(2)">2 Hops</button>
                    <button class="btn btn-sm @(fullSchema ? "btn-primary" : "")" type="button" @onclick="ToggleFullSchema">Full Schema</button>
                </div>

                <div class="row-inline" style="gap:2px;border-left:1px solid var(--line);padding-left:8px">
                    <button class="btn btn-sm icon-btn" title="Zoom in" type="button" @onclick="ZoomIn"><Icon Name="plus" /></button>
                    <button class="btn btn-sm icon-btn" title="Zoom out" type="button" @onclick="ZoomOut"><Icon Name="minus" /></button>
                    <button class="btn btn-sm icon-btn" title="Fit diagram in view" type="button" @onclick="ZoomFit"><Icon Name="refresh" /></button>
                    <button class="btn btn-sm icon-btn" title="@(isMaximized ? "Restore window size" : "Maximize dialog to full screen")" type="button" @onclick="ToggleMaximize">
                        <Icon Name="@(isMaximized ? "minimize" : "maximize")" />
                    </button>
                </div>

                <button class="btn btn-sm icon-btn" title="Close" type="button" @onclick="Close"><Icon Name="x" /></button>
            </div>
        </div>

        <div class="er-canvas-wrap">
            @if (loading)
            {
                <div style="display:flex;align-items:center;justify-content:center;height:100%;gap:10px;color:var(--text-dim)">
                    <span class="spinner"></span> Loading schema relationships...
                </div>
            }
            else if (diagramData is null || diagramData.Nodes.Count == 0)
            {
                <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;gap:8px;color:var(--text-dim)">
                    <b>No tables or relationships found.</b>
                    <span class="small">Ensure metadata is loaded for this database.</span>
                </div>
            }
            <div id="@containerId" class="er-canvas"></div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Guid DatabaseId { get; set; }
    [Parameter] public string DatabaseName { get; set; } = "";
    [Parameter] public string? InitialFocusTable { get; set; }
    [Parameter] public EventCallback<string> OnQueryTable { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private readonly string containerId = "er-container-" + Guid.NewGuid().ToString("N")[..8];
    private DotNetObjectReference<ErDiagramModal>? dotNetRef;
    private ErDiagramData? diagramData;
    private List<string> availableTables = [];
    private string? focusTable;
    private int hops = 1;
    private bool fullSchema;
    private bool loading = true;
    private bool isMaximized;

    protected override async Task OnInitializedAsync()
    {
        focusTable = InitialFocusTable;
        dotNetRef = DotNetObjectReference.Create(this);
        await LoadTablesList();
        await ReloadDiagram();
    }

    private async Task LoadTablesList()
    {
        try
        {
            var objects = await Metadata.GetAsync(DatabaseId);
            availableTables = objects
                .Where(o => string.Equals(o.Type, "TABLE", StringComparison.OrdinalIgnoreCase)
                         || string.Equals(o.Type, "BASE TABLE", StringComparison.OrdinalIgnoreCase)
                         || string.IsNullOrEmpty(o.Type))
                .Select(o => string.IsNullOrWhiteSpace(o.Schema) ? o.Name : $"{o.Schema}.{o.Name}")
                .OrderBy(n => n)
                .ToList();

            if (string.IsNullOrWhiteSpace(focusTable) && availableTables.Count > 0)
            {
                focusTable = availableTables[0];
            }
        }
        catch
        {
            availableTables = [];
        }
    }

    private async Task ReloadDiagram()
    {
        loading = true;
        StateHasChanged();
        try
        {
            diagramData = await Metadata.GetErDiagramDataAsync(DatabaseId, focusTable, hops, fullSchema);
            if (string.IsNullOrWhiteSpace(focusTable) && diagramData.FocusTable is not null)
            {
                focusTable = diagramData.FocusTable;
            }
        }
        finally
        {
            loading = false;
        }

        await InvokeAsync(StateHasChanged);
        await Task.Delay(50); // allow container element DOM mount
        if (diagramData is not null && diagramData.Nodes.Count > 0)
        {
            await JS.InvokeVoidAsync("dbamEr.render", containerId, diagramData, dotNetRef);
        }
    }

    private async Task SetHops(int h)
    {
        hops = h;
        fullSchema = false;
        await ReloadDiagram();
    }

    private async Task ToggleFullSchema()
    {
        fullSchema = true;
        await ReloadDiagram();
    }

    private async Task OnFocusChanged(ChangeEventArgs e)
    {
        focusTable = e.Value?.ToString();
        fullSchema = false;
        await ReloadDiagram();
    }

    private async Task ZoomIn() => await JS.InvokeVoidAsync("dbamEr.zoomIn", containerId);
    private async Task ZoomOut() => await JS.InvokeVoidAsync("dbamEr.zoomOut", containerId);
    private async Task ZoomFit() => await JS.InvokeVoidAsync("dbamEr.zoomFit", containerId);

    private async Task ToggleMaximize()
    {
        isMaximized = !isMaximized;
        StateHasChanged();
        await Task.Delay(50);
        await ZoomFit();
    }

    [JSInvokable]
    public async Task OnSelectTableQuery(string tableName)
    {
        if (OnQueryTable.HasDelegate)
        {
            await OnQueryTable.InvokeAsync(tableName);
        }
    }

    private async Task Close()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    public void Dispose()
    {
        try
        {
            _ = JS.InvokeVoidAsync("dbamEr.destroy", containerId);
        }
        catch { }
        dotNetRef?.Dispose();
    }
}
