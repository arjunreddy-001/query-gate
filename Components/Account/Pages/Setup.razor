@page "/Account/Setup"
@page "/setup"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity

@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject SignInManager<ApplicationUser> SignInManager
@inject AuditService Audit
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Initial Setup · Query Gate</PageTitle>

<h1>Welcome to Query Gate</h1>
<p class="sub">Create the root administrator account to get started.</p>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert bad" role="alert">@errorMessage</div>
}

@if (editContext is not null)
{
<EditForm EditContext="editContext" method="post" OnSubmit="CreateAdmin" FormName="setup">
    <DataAnnotationsValidator />
    <div class="field">
        <label for="displayName">Display name</label>
        <InputText @bind-Value="Input.DisplayName" id="displayName" aria-required="true" placeholder="Administrator" autofocus />
        <ValidationMessage For="() => Input.DisplayName" />
    </div>
    <div class="field">
        <label for="email">Admin email</label>
        <InputText type="email" @bind-Value="Input.Email" id="email" autocomplete="email username" aria-required="true" placeholder="admin@company.com" />
        <ValidationMessage For="() => Input.Email" />
    </div>
    <div class="field">
        <label for="password">Password</label>
        <div class="password-wrapper">
            <InputText type="password" @bind-Value="Input.Password" id="password" autocomplete="new-password" aria-required="true" placeholder="••••••••••••" />
            <button type="button" class="btn-toggle-password"
                    data-password-input="password"
                    aria-label="Show password"
                    title="Show or hide password"
                    tabindex="0">
                <svg class="eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                </svg>
                <svg class="eye-closed" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                    <line x1="1" y1="1" x2="23" y2="23"></line>
                </svg>
            </button>
        </div>
        <ValidationMessage For="() => Input.Password" />
        <p class="small faint field-hint">Min 12 characters, uppercase, lowercase, digit, and special character.</p>
    </div>
    <div class="field">
        <label for="confirmPassword">Confirm password</label>
        <div class="password-wrapper">
            <InputText type="password" @bind-Value="Input.ConfirmPassword" id="confirmPassword" autocomplete="new-password" aria-required="true" placeholder="••••••••••••" />
            <button type="button" class="btn-toggle-password"
                    data-password-input="confirmPassword"
                    aria-label="Show password"
                    title="Show or hide password"
                    tabindex="0">
                <svg class="eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                </svg>
                <svg class="eye-closed" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                    <line x1="1" y1="1" x2="23" y2="23"></line>
                </svg>
            </button>
        </div>
        <ValidationMessage For="() => Input.ConfirmPassword" />
    </div>
    <button type="submit" class="btn btn-primary btn-lg">Create administrator account</button>
</EditForm>
}

<p class="small faint login-hint">
    Initial setup is only available once. After creation, manage additional users from the administration panel.
</p>

@code {
    private string? errorMessage;
    private EditContext editContext = default!;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "setup")] private InputModel Input { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new();
        editContext = new EditContext(Input);
    }

    protected override async Task OnInitializedAsync()
    {
        var hasUsers = await UserManager.Users.AnyAsync();
        if (hasUsers)
        {
            RedirectManager.RedirectTo("/Account/Login");
            return;
        }

        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        }
    }

    private Actor ActorFor(string email, string? id = null) =>
        new(id ?? "", email, HttpContext.Connection.RemoteIpAddress?.ToString(), HttpContext.Request.Headers.UserAgent.ToString());

    public async Task CreateAdmin()
    {
        if (!editContext.Validate()) return;

        var hasUsers = await UserManager.Users.AnyAsync();
        if (hasUsers)
        {
            RedirectManager.RedirectTo("/Account/Login");
            return;
        }

        if (!await RoleManager.RoleExistsAsync(Roles.Admin))
        {
            await RoleManager.CreateAsync(new IdentityRole(Roles.Admin));
        }

        var user = new ApplicationUser
        {
            UserName = Input.Email,
            Email = Input.Email,
            EmailConfirmed = true,
            DisplayName = string.IsNullOrWhiteSpace(Input.DisplayName) ? "Administrator" : Input.DisplayName.Trim(),
            IsActive = true
        };

        var result = await UserManager.CreateAsync(user, Input.Password);
        if (!result.Succeeded)
        {
            errorMessage = string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        var roleResult = await UserManager.AddToRoleAsync(user, Roles.Admin);
        if (!roleResult.Succeeded)
        {
            errorMessage = "Failed to assign administrator role.";
            return;
        }

        await Audit.TryWriteAsync(ActorFor(user.Email, user.Id), "Auth", "Setup", "Success", "Initial root administrator account created.");

        await SignInManager.SignInAsync(user, isPersistent: true);
        RedirectManager.RedirectTo("dashboard");
    }

    private sealed class InputModel
    {
        [Required, MaxLength(100)]
        public string DisplayName { get; set; } = "Administrator";

        [Required, EmailAddress]
        public string Email { get; set; } = "";

        [Required, DataType(DataType.Password), MinLength(12, ErrorMessage = "The password must be at least 12 characters.")]
        public string Password { get; set; } = "";

        [Required, DataType(DataType.Password), Compare(nameof(Password), ErrorMessage = "The password and confirmation password do not match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
