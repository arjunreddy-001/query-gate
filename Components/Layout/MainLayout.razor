@inherits LayoutComponentBase
@implements IDisposable
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using DbAccessManager.Data
@using DbAccessManager.Security
@using DbAccessManager.Services
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NotificationService Notifications
@inject IJSRuntime JS

<div class="shell" @onkeydown="HandleNavKey">
    @if (mobileNavOpen)
    {
        <button class="mobile-nav-backdrop" type="button" aria-label="Close navigation" @onclick="CloseMobileNav"></button>
    }
    <aside id="app-navigation" class="sidebar @(mobileNavOpen ? "mobile-open" : "")">
        <div class="sidebar-brand">
        <a class="brand" href="/" @onclick="CloseMobileNav" style="text-decoration:none">
            <span class="brand-mark"><Icon Name="db" /></span>
            <span class="lbl">Query Gate</span>
        </a>
        <button class="mobile-nav-close icon-btn" type="button" aria-label="Close navigation" @onclick="CloseMobileNav"><Icon Name="x" /></button>
        </div>

        <nav aria-label="Application navigation" @onclick="CloseMobileNav">
            <div class="nav-section">Workspace</div>
            <NavLink class="nav-item" href="dashboard" Match="NavLinkMatch.All"><Icon Name="home" /><span class="lbl">Dashboard</span></NavLink>
            <NavLink class="nav-item" href="query"><Icon Name="terminal" /><span class="lbl">Query workspace</span></NavLink>
            <NavLink class="nav-item" href="access"><Icon Name="key" /><span class="lbl">My access</span></NavLink>
            <NavLink class="nav-item" href="scripts"><Icon Name="file" /><span class="lbl">Script requests</span></NavLink>
            <NavLink class="nav-item" href="notifications"><Icon Name="bell" /><span class="lbl">Notifications</span> @if (unread > 0) { <span class="count">@unread</span> }</NavLink>

            @if (isAdmin || isAuditor)
            {
                <div class="nav-section">Governance</div>
                @if (isAdmin)
                {
                    <NavLink class="nav-item" href="admin/approvals"><Icon Name="check" /><span class="lbl">Approvals</span></NavLink>
                    <NavLink class="nav-item" href="admin/users"><Icon Name="users" /><span class="lbl">Users</span></NavLink>
                    <NavLink class="nav-item" href="admin/databases"><Icon Name="db" /><span class="lbl">Databases</span></NavLink>
                    <NavLink class="nav-item" href="admin/permissions"><Icon Name="shield" /><span class="lbl">Permissions</span></NavLink>
                }
                <NavLink class="nav-item" href="admin/matrix"><Icon Name="grid" /><span class="lbl">Access matrix</span></NavLink>
                <NavLink class="nav-item" href="admin/audit"><Icon Name="list" /><span class="lbl">Audit logs</span></NavLink>
                @if (isAdmin)
                {
                    <NavLink class="nav-item" href="admin/logs"><Icon Name="activity" /><span class="lbl">Application logs</span></NavLink>
                    <NavLink class="nav-item" href="admin/settings"><Icon Name="cog" /><span class="lbl">Settings</span></NavLink>
                }
            }
        </nav>
        <button class="nav-item pin-btn" type="button" data-nav-toggle title="Pin or unpin sidebar"><Icon Name="panel" /><span class="lbl">Pin sidebar</span></button>
    </aside>

    <div class="main">
        <header class="topbar">
            <button class="mobile-nav-toggle icon-btn" type="button" aria-label="Open navigation" aria-controls="app-navigation" aria-expanded="@(mobileNavOpen ? "true" : "false")" @onclick="() => mobileNavOpen = !mobileNavOpen"><Icon Name="panel" /></button>
            <div class="spacer"></div>
            <button class="icon-btn" type="button" title="Toggle theme" data-theme-toggle>
                <span class="theme-sun"><Icon Name="sun" /></span><span class="theme-moon"><Icon Name="moon" /></span>
            </button>
            <a class="icon-btn" href="notifications" title="Notifications"><Icon Name="bell" />@if (unread > 0) { <span class="dot">@unread</span> }</a>
            <details class="rel">
                <summary class="user-chip" style="list-style:none">
                    <span class="avatar">@initials</span>
                    <span class="who"><b>@displayName</b><span>@roleText</span></span>
                </summary>
                <div class="menu">
                    <a href="Account/Manage"><Icon Name="user" />Account settings</a>
                    <a href="Account/Manage/ChangePassword"><Icon Name="lock" />Change password</a>
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="" />
                        <button type="submit"><Icon Name="logout" />Sign out</button>
                    </form>
                </div>
            </details>
        </header>

        @if (idleMinutesLeft is not null)
        {
            <div class="alert warn" style="margin:16px 28px 0">You will be signed out in about @idleMinutesLeft minute(s) due to inactivity. Move the mouse or press a key to stay signed in.</div>
        }

        <main class="content">
            @Body
        </main>
    </div>
</div>

<form id="idle-logout" action="Account/Logout" method="post" hidden>
    <AntiforgeryToken />
    <input type="hidden" name="ReturnUrl" value="" />
</form>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private int unread;
    private bool isAdmin, isAuditor, mobileNavOpen;
    private string displayName = "", initials = "?", roleText = "";
    private int? idleMinutesLeft;
    private Timer? timer;
    private string? userId;
    private DotNetObjectReference<MainLayout>? self;

    private void CloseMobileNav() => mobileNavOpen = false;
    private void HandleNavKey(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") CloseMobileNav();
    }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var user = state.User;
        if (user.Identity?.IsAuthenticated != true) return;

        userId = user.FindFirstValue(ClaimTypes.NameIdentifier);
        isAdmin = user.IsInRole(Roles.Admin);
        isAuditor = user.IsInRole(Roles.Auditor);
        roleText = string.Join(", ", user.FindAll(ClaimTypes.Role).Select(c => c.Value).DefaultIfEmpty("Member"));
        var email = user.Identity?.Name ?? "";

        await using var db = await DbFactory.CreateDbContextAsync();
        var record = await db.Users.AsNoTracking().Where(u => u.Id == userId).Select(u => new { u.DisplayName, u.MustChangePassword }).FirstOrDefaultAsync();
        displayName = ResolveDisplayName(record?.DisplayName, email);
        initials = string.Concat(displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
        if (initials.Length == 0) initials = "?";

        var path = Nav.ToBaseRelativePath(Nav.Uri);
        if (record?.MustChangePassword == true && !path.StartsWith("Account/Manage/ChangePassword", StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo("Account/Manage/ChangePassword", forceLoad: true);
            return;
        }

        unread = await Notifications.UnreadCountAsync(userId!);
        Notifications.UnreadChanged += OnUnreadChanged;
        if (RendererInfo.IsInteractive)
        {
            timer = new Timer(async _ =>
            {
                try
                {
                    var count = await Notifications.UnreadCountAsync(userId!);
                    if (count != unread) { unread = count; await InvokeAsync(StateHasChanged); }
                }
                catch { }
            }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
        }
    }

    private void OnUnreadChanged(string changedUserId, int count)
    {
        if (userId is null || changedUserId != userId) return;
        unread = count;
        _ = InvokeAsync(StateHasChanged);
    }

    private static string ResolveDisplayName(string? preferred, string email)
    {
        if (!string.IsNullOrWhiteSpace(preferred)) return preferred;
        if (string.IsNullOrWhiteSpace(email)) return "User";
        var at = email.IndexOf('@');
        return at > 0 ? email[..at] : email;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && userId is not null)
        {
            self = DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("dbam.startIdle", self, 25 * 60_000, 30 * 60_000); } catch (JSDisconnectedException) { }
        }
    }

    [JSInvokable] public Task OnIdleWarning(int minutes) { idleMinutesLeft = Math.Max(minutes, 1); return InvokeAsync(StateHasChanged); }
    [JSInvokable] public Task OnIdleReset() { idleMinutesLeft = null; return InvokeAsync(StateHasChanged); }
    [JSInvokable] public async Task OnIdleExpired() => await JS.InvokeVoidAsync("dbam.submitForm", "idle-logout");

    public void Dispose()
    {
        timer?.Dispose();
        Notifications.UnreadChanged -= OnUnreadChanged;
        self?.Dispose();
    }
}
