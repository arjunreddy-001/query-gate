@inherits LayoutComponentBase
@implements IDisposable
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using DbAccessManager.Data
@using DbAccessManager.Security
@using DbAccessManager.Services
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NotificationService Notifications
@inject AccessConfigurationService AccessConfig
@inject ITenantContext TenantContext
@inject IJSRuntime JS
@inject SettingsService SettingsSvc

<div class="shell" @onkeydown="HandleNavKey">
    <button class="mobile-nav-backdrop @(mobileNavOpen ? "mobile-open" : "")" type="button" aria-label="Close navigation" data-mobile-nav-close @onclick="CloseMobileNav"></button>
    <aside id="app-navigation" class="sidebar @(mobileNavOpen ? "mobile-open" : "")">
        <div class="sidebar-brand">
        <a class="brand" href="/" rel="external" @onclick="CloseMobileNav" style="text-decoration:none">
            <span class="brand-mark"><Icon Name="db" /></span>
            <span class="lbl">Query Gate</span>
        </a>
        <button class="mobile-nav-close icon-btn" type="button" aria-label="Close navigation" data-mobile-nav-close @onclick="CloseMobileNav"><Icon Name="x" /></button>
        </div>

        <nav aria-label="Application navigation" data-mobile-nav-close @onclick="CloseMobileNav">
            <div class="nav-section">Workspace</div>
            <NavLink class="nav-item" href="dashboard" Match="NavLinkMatch.All"><Icon Name="home" /><span class="lbl">Dashboard</span></NavLink>
            <NavLink class="nav-item" href="query"><Icon Name="terminal" /><span class="lbl">Query workspace</span></NavLink>
            <NavLink class="nav-item" href="access"><Icon Name="key" /><span class="lbl">My access</span></NavLink>
            <NavLink class="nav-item" href="scripts"><Icon Name="file" /><span class="lbl">Script requests</span></NavLink>
            <NavLink class="nav-item" href="notifications"><Icon Name="bell" /><span class="lbl">Notifications</span> @if (unread > 0) { <span class="count">@unread</span> }</NavLink>

            @if (isAdmin || isAuditor || canViewHealth)
            {
                <div class="nav-section">Governance</div>
                @if (isAdmin)
                {
                    <NavLink class="nav-item" href="admin/approvals"><Icon Name="check" /><span class="lbl">Approvals</span></NavLink>
                    <NavLink class="nav-item" href="admin/users"><Icon Name="users" /><span class="lbl">Users</span></NavLink>
                }
                @if (isAdmin || canViewHealth)
                {
                    <NavLink class="nav-item" href="admin/databases"><Icon Name="db" /><span class="lbl">Databases</span></NavLink>
                }
                @if (isAdmin)
                {
                    <NavLink class="nav-item" href="admin/permissions"><Icon Name="shield" /><span class="lbl">Permissions</span></NavLink>
                }
                @if (isAdmin || isAuditor)
                {
                    <NavLink class="nav-item" href="admin/matrix"><Icon Name="grid" /><span class="lbl">Access matrix</span></NavLink>
                    <NavLink class="nav-item" href="admin/audit"><Icon Name="list" /><span class="lbl">Audit logs</span></NavLink>
                }
                @if (isAdmin)
                {
                    <NavLink class="nav-item" href="admin/logs"><Icon Name="activity" /><span class="lbl">Application logs</span></NavLink>
                    <NavLink class="nav-item" href="admin/settings"><Icon Name="cog" /><span class="lbl">Settings</span></NavLink>
                }
            }

            @if (isSuperAdmin)
            {
                <div class="nav-section">Platform</div>
                <NavLink class="nav-item" href="platform/tenants" rel="external"><Icon Name="grid" /><span class="lbl">Workspaces</span></NavLink>
                <NavLink class="nav-item" href="select-tenant" rel="external"><Icon Name="users" /><span class="lbl">Switch workspace</span></NavLink>
            }
        </nav>
        <button class="nav-item pin-btn" type="button" data-nav-toggle title="Pin or unpin sidebar"><Icon Name="panel" /><span class="lbl">Pin sidebar</span></button>
    </aside>

    <div class="main">
        <header class="topbar">
            <button class="mobile-nav-toggle icon-btn" type="button" aria-label="Open navigation" aria-controls="app-navigation" aria-expanded="@(mobileNavOpen ? "true" : "false")" data-mobile-nav-toggle @onclick="() => mobileNavOpen = !mobileNavOpen"><Icon Name="panel" /></button>

            @if (!string.IsNullOrEmpty(currentTenantName))
            {
                <details class="rel topbar-workspace">
                    <summary class="workspace-chip" title="Current workspace (click to switch)">
                        <span class="workspace-icon"><Icon Name="@(currentTenantSlug == "platform" ? "grid" : "db")" /></span>
                        <span class="workspace-name">@currentTenantName</span>
                        @if (userTenants.Count > 1 || isSuperAdmin)
                        {
                            <span class="workspace-caret">&#9662;</span>
                        }
                    </summary>
                    @if (userTenants.Count > 1 || isSuperAdmin)
                    {
                        <div class="menu topbar-menu workspace-menu" style="min-width:240px;left:0">
                            <div style="padding:6px 12px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:var(--text-muted)">Switch Workspace</div>
                            @foreach (var t in userTenants)
                            {
                                <a href="@GetSwitchWorkspaceUrl(t.Slug)" rel="external" style="display:flex;align-items:center;justify-content:space-between;padding:8px 12px;text-decoration:none;color:inherit;background:@(t.Slug == currentTenantSlug ? "var(--brand-soft)" : "transparent")">
                                    <span>@t.Name</span>
                                    @if (t.Slug == currentTenantSlug)
                                    {
                                        <span style="color:var(--ok-ink);font-size:12px">&#10003;</span>
                                    }
                                </a>
                            }
                            @if (isSuperAdmin)
                            {
                                <div style="border-top:1px solid var(--border-color);margin:4px 0"></div>
                                <a href="/platform/tenants" rel="external" style="display:flex;align-items:center;justify-content:space-between;padding:8px 12px;text-decoration:none;color:var(--brand-ink);background:@(currentTenantSlug == "platform" ? "var(--brand-soft)" : "transparent")">
                                    <span style="display:inline-flex;align-items:center;gap:8px"><Icon Name="grid" />Platform Admin</span>
                                    @if (currentTenantSlug == "platform")
                                    {
                                        <span style="color:var(--ok-ink);font-size:12px">&#10003;</span>
                                    }
                                </a>
                            }
                            <div style="border-top:1px solid var(--border-color);margin:4px 0"></div>
                            <a href="/select-tenant" rel="external" style="display:flex;align-items:center;gap:8px;padding:8px 12px;text-decoration:none;color:var(--text-muted);font-size:12px">
                                <Icon Name="users" />Workspace Hub
                            </a>
                        </div>
                    }
                </details>
            }

            <button class="topbar-cmd-btn" type="button" @onclick="async () => { if (paletteRef != null) await paletteRef.OpenPalette(); }" title="Command Palette (Cmd+K / Ctrl+K)">
                <Icon Name="search" />
                <span class="cmd-label">Jump to…</span>
                <kbd class="cmd-kbd" title="Shortcut">
                    <span class="kbd-mac">⌘K</span>
                    <span class="kbd-other">Ctrl+K</span>
                </kbd>
            </button>

            <div class="spacer"></div>
            <button class="icon-btn" type="button" title="Toggle theme" data-theme-toggle>
                <span class="theme-sun"><Icon Name="sun" /></span><span class="theme-moon"><Icon Name="moon" /></span>
            </button>
            <a class="icon-btn" href="notifications" title="Notifications"><Icon Name="bell" />@if (unread > 0) { <span class="dot">@unread</span> }</a>
            <details class="rel topbar-user">
                <summary class="user-chip" style="list-style:none">
                    <span class="avatar">@initials</span>
                    <span class="who"><b>@displayName</b><span>@roleText</span></span>
                </summary>
                <div class="menu topbar-menu">
                    @if (isSuperAdmin)
                    {
                        <a href="/platform/tenants" rel="external"><Icon Name="grid" />Platform admin</a>
                    }
                    @if (userTenants.Count > 1 || isSuperAdmin)
                    {
                        <a href="/select-tenant" rel="external"><Icon Name="users" />Switch workspace</a>
                    }
                    <a href="Account/Manage"><Icon Name="user" />Account settings</a>
                    <a href="Account/Manage/ChangePassword"><Icon Name="lock" />Change password</a>
                    <form action="/Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="/Account/Login" />
                        <button type="submit"><Icon Name="logout" />Sign out</button>
                    </form>
                </div>
            </details>
        </header>

        @if (idleMinutesLeft is not null)
        {
            <div class="alert warn idle-alert">You will be signed out in about @idleMinutesLeft minute(s) due to inactivity. Move the mouse or press a key to stay signed in.</div>
        }

        <main class="content">
            @Body
        </main>
    </div>
</div>

<ToastHost />
<CommandPalette @ref="paletteRef" />

<form id="idle-logout" action="/Account/Logout" method="post" hidden>
    <AntiforgeryToken />
    <input type="hidden" name="ReturnUrl" value="/Account/Login" />
</form>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">&#128473;</span>
</div>

@code {
    private CommandPalette? paletteRef;
    private int unread;
    private bool isAdmin, isAuditor, isSuperAdmin, canViewHealth, mobileNavOpen;
    private string displayName = "", initials = "?", roleText = "";
    private string? currentTenantName;
    private string? currentTenantSlug;
    private List<Tenant> userTenants = [];
    private int? idleMinutesLeft;
    private Timer? timer;
    private string? userId;
    private DotNetObjectReference<MainLayout>? self;

    private void CloseMobileNav() => mobileNavOpen = false;
    private void HandleNavKey(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") CloseMobileNav();
    }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var user = state.User;
        if (user.Identity?.IsAuthenticated != true) return;

        userId = user.FindFirstValue(ClaimTypes.NameIdentifier);
        isSuperAdmin = user.IsInRole(Roles.SuperAdmin);
        isAdmin = user.IsInRole(Roles.Admin);
        isAuditor = userId is not null && await AccessConfig.CanAuditAsync(userId);
        canViewHealth = isAdmin || isSuperAdmin;
        if (!canViewHealth && userId is not null)
        {
            var extra = await SettingsSvc.GetAsync("HealthVisibleRoles");
            if (!string.IsNullOrWhiteSpace(extra))
            {
                var allowed = extra.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                canViewHealth = user.Claims.Where(c => c.Type == ClaimTypes.Role).Any(c => allowed.Contains(c.Value, StringComparer.OrdinalIgnoreCase));
            }
        }
        roleText = string.Join(", ", user.FindAll(ClaimTypes.Role).Select(c => c.Value).DefaultIfEmpty("Member"));
        var email = user.Identity?.Name ?? "";

        await using var db = await DbFactory.CreateDbContextAsync();
        var record = await db.Users.AsNoTracking().Where(u => u.Id == userId).Select(u => new { u.DisplayName, u.MustChangePassword }).FirstOrDefaultAsync();
        displayName = ResolveDisplayName(record?.DisplayName, email);
        initials = string.Concat(displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
        if (initials.Length == 0) initials = "?";

        currentTenantName = TenantContext.IsResolved ? TenantContext.Name : (TenantContext.IsPlatformAdmin ? "Platform Administration" : null);
        currentTenantSlug = TenantContext.IsResolved ? TenantContext.Slug : (TenantContext.IsPlatformAdmin ? "platform" : null);

        if (string.IsNullOrEmpty(currentTenantName) && TenantContextAccessor.FallbackDefaultTenant is not null)
        {
            currentTenantName = TenantContextAccessor.FallbackDefaultTenant.Name;
            currentTenantSlug = TenantContextAccessor.FallbackDefaultTenant.Slug;
        }

        if (userId is not null)
        {
            if (isSuperAdmin)
            {
                userTenants = await db.Tenants.IgnoreQueryFilters().Where(t => t.IsActive).OrderBy(t => t.Name).ToListAsync();
            }
            else
            {
                var memberships = await db.UserTenantMemberships.IgnoreQueryFilters().Where(m => m.UserId == userId).ToListAsync();
                var tenantIds = memberships.Select(m => m.TenantId).ToList();
                if (tenantIds.Count > 0)
                {
                    userTenants = await db.Tenants.IgnoreQueryFilters().Where(t => tenantIds.Contains(t.Id) && t.IsActive).OrderBy(t => t.Name).ToListAsync();
                }
            }
        }

        var path = Nav.ToBaseRelativePath(Nav.Uri);
        if (record?.MustChangePassword == true && !path.StartsWith("Account/Manage/ChangePassword", StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo("Account/Manage/ChangePassword", forceLoad: true);
            return;
        }

        unread = await Notifications.UnreadCountAsync(userId!);
        Notifications.UnreadChanged += OnUnreadChanged;
        if (RendererInfo.IsInteractive)
        {
            timer = new Timer(async _ =>
            {
                try
                {
                    var count = await Notifications.UnreadCountAsync(userId!);
                    if (count != unread) { unread = count; await InvokeAsync(StateHasChanged); }
                }
                catch { }
            }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
        }
    }

    private void OnUnreadChanged(string changedUserId, int count)
    {
        if (userId is null || changedUserId != userId) return;
        unread = count;
        _ = InvokeAsync(StateHasChanged);
    }

    private static string ResolveDisplayName(string? preferred, string email)
    {
        if (!string.IsNullOrWhiteSpace(preferred)) return preferred;
        if (string.IsNullOrWhiteSpace(email)) return "User";
        var at = email.IndexOf('@');
        return at > 0 ? email[..at] : email;
    }

    private string GetSwitchWorkspaceUrl(string slug)
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/');
        if (string.IsNullOrEmpty(relative) || relative.Equals("dashboard", StringComparison.OrdinalIgnoreCase))
        {
            return $"/t/{slug}/dashboard";
        }
        if (relative.StartsWith("select-tenant", StringComparison.OrdinalIgnoreCase) ||
            relative.StartsWith("platform", StringComparison.OrdinalIgnoreCase) ||
            relative.StartsWith("Account", StringComparison.OrdinalIgnoreCase))
        {
            return $"/t/{slug}/dashboard";
        }
        return $"/t/{slug}/{relative}";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && userId is not null)
        {
            self = DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("dbam.startIdle", self, 25 * 60_000, 30 * 60_000); } catch (JSDisconnectedException) { }
        }
    }

    [JSInvokable] public Task OnIdleWarning(int minutes) { idleMinutesLeft = Math.Max(minutes, 1); return InvokeAsync(StateHasChanged); }
    [JSInvokable] public Task OnIdleReset() { idleMinutesLeft = null; return InvokeAsync(StateHasChanged); }
    [JSInvokable] public async Task OnIdleExpired() => await JS.InvokeVoidAsync("dbam.submitForm", "idle-logout");

    public void Dispose()
    {
        timer?.Dispose();
        Notifications.UnreadChanged -= OnUnreadChanged;
        self?.Dispose();
    }
}
