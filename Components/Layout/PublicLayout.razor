@inherits LayoutComponentBase

<div class="public-site">
    <header class="public-header">
        <div class="public-header-inner">
            <a class="brand public-brand" href="/">
                <span class="brand-mark"><Icon Name="db" /></span>
                <span>Query Gate</span>
            </a>
            <nav class="public-nav" aria-label="Main navigation">
                <a class="public-doc-link" href="/documentation">Documentation</a>
                <a class="public-github-link" href="https://github.com/arjunreddy-001/query-gate" aria-label="Query Gate on GitHub"><span class="public-github-text">GitHub</span><span class="public-github-icon"><Icon Name="github" /></span></a>
                <button class="icon-btn" type="button" title="Toggle theme" aria-label="Toggle theme" data-theme-toggle>
                    <span class="theme-sun"><Icon Name="sun" /></span><span class="theme-moon"><Icon Name="moon" /></span>
                </button>
                <AuthorizeView>
                    <Authorized><a class="btn btn-primary" href="/dashboard">Dashboard</a></Authorized>
                    <NotAuthorized><a class="btn btn-primary" href="/Account/Login">Sign in</a></NotAuthorized>
                </AuthorizeView>
            </nav>
        </div>
    </header>
    <main>
        @Body
    </main>
    <footer class="public-footer">
        <span>Query Gate. Governed access to SQL Server, PostgreSQL, MySQL and MariaDB.</span>
        <nav class="public-footer-nav" aria-label="Footer navigation">
            <a href="/documentation">Documentation</a>
            <a href="https://github.com/arjunreddy-001/query-gate">GitHub</a>
            <AuthorizeView>
                <Authorized><a href="/dashboard">Dashboard</a></Authorized>
                <NotAuthorized><a href="/Account/Login">Sign in</a></NotAuthorized>
            </AuthorizeView>
        </nav>
    </footer>
</div>
