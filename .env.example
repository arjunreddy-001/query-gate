# Query Gate - Environment Configuration
# All variables in this file are OPTIONAL.
# Query Gate runs out-of-the-box with zero configuration:
#   - Bundled SQL Server 2022 container with persistent storage
#   - Persistent encryption key and JWT key auto-generated in volume
#   - Automatic EF Core database migrations
#   - Appwrite-style web setup wizard on first visit to create the root admin
#
# Copy this file to .env to customize any value.
# Single quotes preserve literal characters in Docker Compose environment files.

# Port for the web interface (optional, default: 5176)
PORT=5176

# SA password for the bundled SQL Server container (optional, default: QueryGateDefault!2026)
DB_PASSWORD='QueryGateDefault!2026'

# Custom database connection string (optional)
# Set this only if connecting to an external SQL Server instead of the bundled container.
# DB_CONNECTION_STRING='Server=host.docker.internal,1433;Database=QueryGate;User Id=querygate;Password=replace-me;Encrypt=True;TrustServerCertificate=False'

# Static 32-byte base64 encryption key (optional)
# If omitted, Query Gate automatically generates a key and saves it to the data-protection-keys volume.
# ENCRYPTION_KEY='replace-with-openssl-rand-base64-32'

# Static 64-byte base64 JWT signing key (optional)
# If omitted, Query Gate automatically generates a key and saves it to the data-protection-keys volume.
# JWT_KEY='replace-with-openssl-rand-base64-64'

# Headless bootstrap administrator credentials (optional)
# Leave these commented out to use the web setup wizard at http://localhost:5175 on first launch.
# Set only if you need unattended/headless provisioning in CI or automated deployments.
# BOOTSTRAP_ADMIN_EMAIL='admin@company.com'
# BOOTSTRAP_ADMIN_PASSWORD='ReplaceWithAStrongPassword!123'

# Apply EF Core migrations automatically on startup (optional, default: true)
APPLY_MIGRATIONS=true
