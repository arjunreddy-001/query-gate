# Copy to .env and replace every placeholder. Keep the file private.
# Single quotes preserve literal dollar signs in Docker Compose environment files.
DB_CONNECTION_STRING='Server=host.docker.internal,1433;Database=QueryGate;User Id=querygate;Password=replace-me;Encrypt=True;TrustServerCertificate=False'
ENCRYPTION_KEY='replace-with-openssl-rand-base64-32'
JWT_KEY='replace-with-a-separate-openssl-rand-base64-64'
BOOTSTRAP_ADMIN_EMAIL='admin@example.com'
BOOTSTRAP_ADMIN_PASSWORD='replace-with-a-strong-password'
TLS_CERT_PATH='./certs/query-gate.pfx'
TLS_CERT_PASSWORD='replace-with-the-certificate-password'
# Enable only while applying migrations on a single instance.
APPLY_MIGRATIONS=true
